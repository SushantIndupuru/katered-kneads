---
import '../styles/global.css';
import { getCurrentDrop } from '../lib/db';
import SmsSignup from '../components/SmsSignup.astro';

export interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  hideFooterSignup?: boolean;
}

const {
  title = "Katered Kneads - Handmade Campus Cookies",
  description = "Handmade, 100% scratch cookies delivered biweekly to UC Berkeley and UC Davis. Limited orders open every two weeks.",
  activePage = "",
  hideFooterSignup = false
} = Astro.props;

// Whether a drop is currently open for ordering. When it isn't, the client
// clears any saved cart (you can't check out outside an open window anyway).
const currentDrop = await getCurrentDrop();
const now = Date.now();
const ordersOpen = !!currentDrop
  && now >= new Date(currentDrop.openTime).getTime()
  && now < new Date(currentDrop.closeTime).getTime();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body data-orders-open={ordersOpen ? '1' : '0'}>

    <!-- Mobile Nav Overlay -->
    <div class="mobile-nav" id="mobile-nav" role="dialog" aria-modal="true" aria-label="Mobile navigation">
      <button class="mobile-nav-close" id="mobile-nav-close" aria-label="Close menu">✕</button>
      <a href="/" class="mobile-link">Home</a>
      <a href="/about" class="mobile-link">About</a>
      <a href="/menu" class="mobile-link">Our Treats</a>
      <a href="/order" class="mobile-link">Order</a>
      <a href="/cart" class="mobile-link">Cart <span class="cart-count-badge" data-cart-count hidden></span></a>
    </div>

    <!-- Header -->
    <header id="site-header">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label="Katered Kneads home">
          <img src="/logo.svg" alt="" width="30" height="30" class="nav-logo-mark" />
          <span>Katered Kneads</span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/about" class={activePage === 'about' ? 'nav-active' : ''}>About</a>
          <a href="/menu" class={activePage === 'menu' ? 'nav-active' : ''}>Our Treats</a>
          <a href="/order" class={activePage === 'order' ? 'nav-active' : ''}>Order</a>
          <a href="/cart" class={`nav-cart ${activePage === 'cart' ? 'nav-active' : ''}`} aria-label="Cart">
            Cart<span class="cart-count-badge" data-cart-count hidden></span>
          </a>
        </nav>

        <div class="nav-instagram" id="nav-instagram-desktop">
          <a href="https://www.instagram.com/Katered_Kneads" target="_blank" rel="noopener noreferrer" aria-label="Instagram @Katered_Kneads">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>

        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <slot />

    <!-- Footer -->
    <footer>
      <div class="footer-inner">
        <div class="footer-newsletter">
          {!hideFooterSignup && <SmsSignup source="footer" />}
          <p class="footer-newsletter-sub footer-newsletter-social">Prefer Instagram? Follow along for drop announcements and behind-the-scenes baking.</p>
          <div class="footer-cta-row">
            <a href="https://www.instagram.com/Katered_Kneads" target="_blank" rel="noopener noreferrer" class="cta-link">Instagram @Katered_Kneads →</a>
          </div>
        </div>
        <div class="footer-bottom">
          <div class="footer-links">
            <a href="/about">About</a>
            <a href="/privacy-policy">Privacy Policy</a>
            <a href="/terms">Terms &amp; Conditions</a>
            <a href="/refund-policy">Refund Policy</a>
          </div>
          <p class="footer-copy">&copy; 2026 Katered Kneads &mdash; UC Berkeley &amp; UC Davis</p>
          <p class="footer-credit">Made with &#10084;&#65039; by <a href="https://github.com/SushantIndupuru" target="_blank" rel="noopener noreferrer">Sushant Indupuru</a></p>
        </div>
      </div>
    </footer>

    <script>
      import { cartCount, clearCart, onCartChange } from '../lib/cart';

      // No drop is open right now — drop any saved cart so stale items don't
      // linger between drops. (You can't check out outside an open window.)
      if (document.body.dataset.ordersOpen !== '1') {
        clearCart();
      }

      // Keep the header/mobile cart badges in sync with the stored cart.
      const cartBadges = Array.from(document.querySelectorAll<HTMLElement>('[data-cart-count]'));
      function updateCartBadges() {
        const n = cartCount();
        cartBadges.forEach(b => {
          b.textContent = n > 0 ? String(n) : '';
          b.hidden = n <= 0;
        });
      }
      updateCartBadges();
      onCartChange(updateCartBadges);

      // Scroll header border
      const header = document.getElementById('site-header');
      window.addEventListener('scroll', () => {
        header?.classList.toggle('scrolled', window.scrollY > 20);
      }, { passive: true });

      // Hamburger / Mobile Nav
      const hamburger = document.getElementById('hamburger');
      const mobileNav = document.getElementById('mobile-nav');
      const mobileNavClose = document.getElementById('mobile-nav-close');

      function openMobileNav() {
        mobileNav?.classList.add('open');
        hamburger?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileNav() {
        mobileNav?.classList.remove('open');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      hamburger?.addEventListener('click', openMobileNav);
      mobileNavClose?.addEventListener('click', closeMobileNav);
      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', closeMobileNav);
      });
    </script>

  </body>
</html>

<style>
  .nav-cart { position: relative; display: inline-flex; align-items: center; gap: 0.35rem; }
  .cart-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--color-accent, #c2410c);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
  }
</style>
