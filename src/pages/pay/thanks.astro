---
import '../../styles/global.css';

const canceled = Astro.url.searchParams.get('canceled') === '1';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>{canceled ? 'Payment canceled' : 'Payment received'} — Katered Kneads</title>
    <meta name="robots" content="noindex,follow">
</head>
<body class="pay-body">
    <main class="pay-panel">
        {canceled ? (
            <>
                <div class="pay-mark pay-mark-error" aria-hidden="true">✕</div>
                <h1 class="pay-heading">Payment canceled</h1>
                <p class="pay-sub">No charge was made. Please show this screen to the cashier if you'd like to try again.</p>
            </>
        ) : (
            <>
                <div class="pay-mark" aria-hidden="true">✓</div>
                <h1 class="pay-heading">Payment received!</h1>
                <p class="pay-sub">Thank you. Show this screen to the cashier and grab your treats.</p>
            </>
        )}
        <p class="pay-brand">Katered Kneads</p>
    </main>

    <style>
        .pay-body {
            min-height: 100vh;
            margin: 0;
            background: #F3EDE5;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .pay-panel {
            max-width: 420px;
            text-align: center;
            background: var(--bg);
            border: 1px solid var(--accent);
            border-radius: 16px;
            padding: 2.5rem 1.75rem;
        }
        .pay-mark {
            width: 76px;
            height: 76px;
            line-height: 76px;
            border-radius: 50%;
            background: #1f8a4c;
            color: #fff;
            font-size: 2.4rem;
            margin: 0 auto 1.25rem;
        }
        .pay-mark-error { background: #b00020; }
        .pay-heading {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            margin: 0 0 0.5rem;
        }
        .pay-sub { color: var(--text-muted); margin: 0 0 1.75rem; }
        .pay-brand {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 0;
        }
    </style>
</body>
</html>
