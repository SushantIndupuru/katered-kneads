---
import Layout from '../layouts/Layout.astro';
import { getNewItems } from '../lib/db';
export const prerender = true

// ── Drop Configuration ────────────────────────────────────────
// Set ORDERS_CURRENTLY_OPEN = true when the preorder window is live.
const ORDERS_CURRENTLY_OPEN = false;
const NEXT_DROP_OPEN_STR   = '2026-06-07T10:00:00';
const NEXT_DROP_OPEN_LABEL = 'Saturday, June 7, 2026 at 10:00 AM';
const ORDERS_CLOSE_LABEL   = 'June 8, 2026 at 11:59 PM';
const DROP_NUMBER          = 7;
const ORDER_LINK           = 'https://kateredkneads.square.site/shop/katering-now/LQ62D5N5VAEN2X4RSTCFQTVK';
const CDN_URL              = import.meta.env.PUBLIC_SUPABASE_STORAGE_URL;

const dropItems = await getNewItems();
---

<Layout
  title="Preorder — Katered Kneads"
  description="Place a preorder for handmade cookies delivered to UC Berkeley or UC Davis. Preorders open every two weeks."
  activePage="order"
>

  <!-- Drop Header -->
  <section class="order-hero">
    <div class="container">
      <p class="eyebrow">Preorders</p>
      <h1 class="order-heading">Drop #{DROP_NUMBER}</h1>
      <p class="order-sub">
        {ORDERS_CURRENTLY_OPEN
          ? `Orders are open now — closes ${ORDERS_CLOSE_LABEL}. Limited quantities per item.`
          : `Next drop opens ${NEXT_DROP_OPEN_LABEL}. Limited quantities — first come, first served.`
        }
      </p>
    </div>
  </section>

  <!-- Order Status Panel -->
  <section class="section order-status-section" id="order-status">
    <div class="container">

      {ORDERS_CURRENTLY_OPEN ? (
        <div class="status-panel status-open">
          <div class="status-badge status-badge-open">● Orders Open</div>
          <h2 class="status-heading">Preorders are live!</h2>
          <p class="status-text">Get your order in before the window closes. Limited quantities per item — once they're gone, they're gone.</p>
          <p class="status-closes">Preorders close: <strong>{ORDERS_CLOSE_LABEL}</strong></p>
          <a href={ORDER_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">Order Now on Square →</a>
        </div>
      ) : (
        <div class="status-panel status-closed">
          <div class="status-badge status-badge-closed">● Preorders Closed</div>
          <h2 class="status-heading">Next drop opens in</h2>
          <p class="status-date">{NEXT_DROP_OPEN_LABEL}</p>

          <div class="countdown" id="countdown" aria-live="polite" aria-label="Countdown to next drop">
            <div class="countdown-item">
              <span class="countdown-num" id="cd-days">--</span>
              <span class="countdown-label">Days</span>
            </div>
            <div class="countdown-sep" aria-hidden="true">:</div>
            <div class="countdown-item">
              <span class="countdown-num" id="cd-hours">--</span>
              <span class="countdown-label">Hours</span>
            </div>
            <div class="countdown-sep" aria-hidden="true">:</div>
            <div class="countdown-item">
              <span class="countdown-num" id="cd-minutes">--</span>
              <span class="countdown-label">Min</span>
            </div>
            <div class="countdown-sep" aria-hidden="true">:</div>
            <div class="countdown-item">
              <span class="countdown-num" id="cd-seconds">--</span>
              <span class="countdown-label">Sec</span>
            </div>
          </div>

          <p class="status-cta-hint">Don't want to check back? <a href="#sms-signup">Join the SMS list ↓</a></p>
        </div>
      )}

    </div>
  </section>

  <!-- Drop Items (shown when there are items in the DB) -->
  {dropItems.length > 0 && (
    <section class="section section-tinted" id="drop-items">
      <div class="container">

        <div class="section-header">
          <p class="eyebrow">{ORDERS_CURRENTLY_OPEN ? `In This Drop` : `Drop Preview`}</p>
          <h2 class="section-heading">
            {ORDERS_CURRENTLY_OPEN ? `What's in Drop #${DROP_NUMBER}` : `Sneak Peek — Drop #${DROP_NUMBER}`}
          </h2>
          <p class="section-sub">
            {ORDERS_CURRENTLY_OPEN
              ? 'Order via Square to grab your picks. Quantities are limited — order early.'
              : "A preview of what's baking for the next drop. Full details and pricing revealed when orders open."
            }
          </p>
        </div>

        <div class="product-grid">
          {dropItems.map(item => (
            <div class={`product-card${item.menuItem.mystery ? ' product-card-mystery' : ''}`}>
              <div class="product-card-image">
                {item.menuItem.mystery
                  ? <div class="mystery-placeholder">?</div>
                  : <img src={CDN_URL + item.menuItem.id} alt={item.menuItem.name} loading="lazy" />
                }
                <span class={`stock-badge ${ORDERS_CURRENTLY_OPEN ? 'stock-badge-available' : 'stock-badge-coming-soon'}`}>
                  {ORDERS_CURRENTLY_OPEN ? 'Limited' : 'Coming Soon'}
                </span>
                {item.tag && <span class="cookie-tag">{item.tag}</span>}
              </div>
              <div class="product-card-body">
                <h3>{item.menuItem.mystery ? '???' : item.menuItem.name}</h3>
                <p>{item.menuItem.mystery ? 'Revealed when orders open.' : item.menuItem.description}</p>
              </div>
            </div>
          ))}
        </div>

        {ORDERS_CURRENTLY_OPEN && (
          <div class="drop-cta">
            <a href={ORDER_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">
              Order Now on Square →
            </a>
          </div>
        )}

      </div>
    </section>
  )}

  <!-- SMS Sign-up (shown when orders are closed) -->
  {!ORDERS_CURRENTLY_OPEN && (
    <section class="section" id="sms-signup">
      <div class="container">
        <div class="sms-block">
          <div class="sms-text">
            <p class="eyebrow">Never Miss a Drop</p>
            <h2 class="section-heading">Join the SMS List</h2>
            <p>
              We text our list about 5 minutes before preorders open. Be first in before quantities sell out.
            </p>
            <ul class="sms-benefits">
              <li>Text notification ~5 min before orders open</li>
              <li>First to see new menu items each drop</li>
              <li>Easy opt-out anytime — just reply STOP</li>
            </ul>
          </div>

          <div class="sms-form-wrap">
            <form
              class="sms-form"
              id="sms-form"
              action="https://formspree.io/f/YOUR_FORM_ID"
              method="POST"
            >
              <input type="hidden" name="_subject" value="New SMS Signup — Katered Kneads" />

              <div class="form-field">
                <label for="sms-name">First Name</label>
                <input type="text" id="sms-name" name="name" placeholder="Your first name" required autocomplete="given-name" />
              </div>

              <div class="form-field">
                <label for="sms-phone">Phone Number</label>
                <input type="tel" id="sms-phone" name="phone" placeholder="+1 (555) 000-0000" required autocomplete="tel" />
              </div>

              <div class="form-field">
                <label for="sms-campus">Your Campus</label>
                <select id="sms-campus" name="campus" required>
                  <option value="">Select your campus</option>
                  <option value="UC Berkeley">UC Berkeley</option>
                  <option value="UC Davis">UC Davis</option>
                  <option value="Both">Both (I'm flexible)</option>
                </select>
              </div>

              <p class="form-disclaimer">
                By signing up you consent to receive SMS notifications from Katered Kneads.
                Message &amp; data rates may apply. Reply STOP to unsubscribe at any time.
              </p>

              <button type="submit" class="btn-primary form-submit">Join the SMS List →</button>
            </form>

            <p class="form-success" id="form-success" hidden>
              ✓ You're on the list! We'll text you before the next drop.
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Bottom Navigation -->
  <section class="section" id="back-to-menu">
    <div class="container order-page-links">
      <a href="/menu" class="order-page-link">← Browse the Menu</a>
      <a href="/about" class="order-page-link">About Us →</a>
    </div>
  </section>

  <script define:vars={{ NEXT_DROP_OPEN_STR }}>
    // ── Countdown Timer ───────────────────────────────────────────
    var target = new Date(NEXT_DROP_OPEN_STR).getTime();

    function pad(n) { return String(n).padStart(2, '0'); }

    function updateCountdown() {
      var now  = Date.now();
      var diff = target - now;
      if (diff <= 0) return;

      var days    = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours   = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((diff % (1000 * 60)) / 1000);

      var dEl = document.getElementById('cd-days');
      var hEl = document.getElementById('cd-hours');
      var mEl = document.getElementById('cd-minutes');
      var sEl = document.getElementById('cd-seconds');

      if (dEl) dEl.textContent = pad(days);
      if (hEl) hEl.textContent = pad(hours);
      if (mEl) mEl.textContent = pad(minutes);
      if (sEl) sEl.textContent = pad(seconds);
    }

    if (document.getElementById('cd-days')) {
      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    // ── SMS Form ──────────────────────────────────────────────────
    var form       = document.getElementById('sms-form');
    var successMsg = document.getElementById('form-success');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var data = new FormData(form);
        fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        })
        .then(function(res) {
          if (res.ok) {
            form.hidden = true;
            if (successMsg) successMsg.hidden = false;
          }
        })
        .catch(function(err) { console.error('Form submission error:', err); });
      });
    }
  </script>

</Layout>

