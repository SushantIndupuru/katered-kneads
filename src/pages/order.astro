---
import Layout from '../layouts/Layout.astro';
import SmsSignup from '../components/SmsSignup.astro';
import { getCurrentDrop, getDropItems, getPickupSpots } from '../lib/db';

const currentDrop = await getCurrentDrop();
const dropItems = currentDrop ? await getDropItems(currentDrop.id) : [];
const pickupSpots = currentDrop ? await getPickupSpots(currentDrop.id) : [];

// ── Drop Configuration ────────────────────────────────────────
const DATE_LABEL_OPTS = {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
  hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles',
} as const;
function formatDropDate(iso: string): string {
  return new Date(iso).toLocaleString('en-US', DATE_LABEL_OPTS);
}

const SPOT_DATE_FMT = new Intl.DateTimeFormat('en-US', {
  weekday: 'short', month: 'short', day: 'numeric',
  hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles',
});
const SPOT_TIME_FMT = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles',
});
// A spot's window, e.g. "Sat, Mar 8 · 2:00 PM – 3:00 PM".
function spotWindowLabel(startIso: string, endIso: string): string {
  return `${SPOT_DATE_FMT.format(new Date(startIso))} – ${SPOT_TIME_FMT.format(new Date(endIso))}`;
}

const now = Date.now();
const openMs  = currentDrop ? new Date(currentDrop.openTime).getTime()  : null;
const closeMs = currentDrop ? new Date(currentDrop.closeTime).getTime() : null;

// Orders are open when we're inside the current drop's [open, close) window.
const ORDERS_CURRENTLY_OPEN = openMs !== null && closeMs !== null && now >= openMs && now < closeMs;
const BEFORE_OPEN = openMs !== null && now < openMs;
// An active drop always shows its countdown before it opens.
const SHOW_COUNTDOWN = BEFORE_OPEN;

// The "no drop scheduled" panel already carries its own SMS signup box, so
// suppress the footer one to avoid two identical boxes on the same page.
const SHOW_NO_DROP_SIGNUP = !ORDERS_CURRENTLY_OPEN && !SHOW_COUNTDOWN;

// When open, show everything in the drop; before open, only the preview picks.
const displayItems = ORDERS_CURRENTLY_OPEN ? dropItems : dropItems.filter(i => i.preview);

// Admin-configured per drop: items at or below this remaining count show a
// "Low stock, N left" badge. 0 (the default) hides remaining counts entirely —
// items just read as available until they sell out.
const LOW_STOCK_THRESHOLD = currentDrop?.lowStockThreshold ?? 0;

const NEXT_DROP_OPEN_STR   = currentDrop?.openTime ?? null;
const NEXT_DROP_OPEN_LABEL = currentDrop ? formatDropDate(currentDrop.openTime) : 'TBA';
const ORDERS_CLOSE_LABEL   = currentDrop ? formatDropDate(currentDrop.closeTime) : 'TBA';
const DROP_NAME            = currentDrop?.name ?? 'Next Drop';
const CDN_URL              = import.meta.env.PUBLIC_SUPABASE_STORAGE_URL;

function formatPrice(n: number): string {
  return `$${n.toFixed(2)}`;
}
---

<Layout
  title="Order — Katered Kneads"
  description="Order handmade cookies delivered to UC Berkeley or UC Davis. Ordering is open only during each drop window — about every two weeks."
  activePage="order"
  hideFooterSignup={SHOW_NO_DROP_SIGNUP}
>

  <!-- Page Header -->
  <section class="order-hero">
    <div class="container">
      <p class="eyebrow">UC Berkeley &amp; UC Davis</p>
      <h1 class="order-heading">Order</h1>
      <p class="order-sub">
        {ORDERS_CURRENTLY_OPEN
          ? `${DROP_NAME} is live now — orders close ${ORDERS_CLOSE_LABEL}. Limited quantities per item.`
          : SHOW_COUNTDOWN
            ? `Handmade cookies dropped every two weeks. ${DROP_NAME} opens soon — quantities are limited and first come, first served.`
            : `Handmade cookies dropped every two weeks. Ordering is currently closed — check back soon for the next drop.`
        }
      </p>
    </div>
  </section>

  <!-- Value-prop strip -->
  <section class="order-valueprops">
    <div class="container">
      <ul class="valueprop-row">
        <li class="valueprop">
          <span class="valueprop-title">Baked fresh to order</span>
          <span class="valueprop-sub">100% from scratch — never sitting on a shelf.</span>
        </li>
        <li class="valueprop">
          <span class="valueprop-title">Made with Care</span>
          <span class="valueprop-sub">Carefully crafted unique recipes.</span>
        </li>
        <li class="valueprop">
          <span class="valueprop-title">Easy campus pickup</span>
          <span class="valueprop-sub">Grab your order at UC Berkeley or UC Davis.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Order Status Panel (only when orders aren't open — when open, the
       drop section below carries a compact "live" indicator instead) -->
  {!ORDERS_CURRENTLY_OPEN && (
    <section class="section order-status-section" id="order-status">
    <div class="container">

      {SHOW_COUNTDOWN ? (
        <div class="status-panel status-closed">
          <div class="status-badge status-badge-closed">● Orders Closed</div>
          <h2 class="status-heading">{DROP_NAME} opens in</h2>

          <div class="countdown" id="countdown" aria-live="polite" aria-label="Countdown to next drop">
            <div class="countdown-item">
              <span class="countdown-num" id="cd-days">--</span>
              <span class="countdown-label">Days</span>
            </div>
            <div class="countdown-sep" aria-hidden="true">:</div>
            <div class="countdown-item">
              <span class="countdown-num" id="cd-hours">--</span>
              <span class="countdown-label">Hours</span>
            </div>
            <div class="countdown-sep" aria-hidden="true">:</div>
            <div class="countdown-item">
              <span class="countdown-num" id="cd-minutes">--</span>
              <span class="countdown-label">Min</span>
            </div>
            <div class="countdown-sep" aria-hidden="true">:</div>
            <div class="countdown-item">
              <span class="countdown-num" id="cd-seconds">--</span>
              <span class="countdown-label">Sec</span>
            </div>
          </div>

          <p class="status-date">Opens {NEXT_DROP_OPEN_LABEL}</p>
        </div>
      ) : (
        <div class="status-panel status-closed no-drop-panel">
          <div class="status-badge status-badge-closed">● No Drop Scheduled</div>
          <h2 class="status-heading">Don't miss the next drop</h2>
          <p class="status-text">There's no open ordering window right now — and our drops sell out fast. Drop your number and we'll text you the moment the next one is announced, plus when orders open and where to pick up.</p>
          <div class="no-drop-signup">
            <SmsSignup
              source="order-no-drop"
              heading=""
              sub=""
            />
          </div>
        </div>
      )}

    </div>
  </section>
  )}

  <!-- Pickup spots — when orders aren't open there's nothing to buy yet, so
       show the pickup areas/windows right under the countdown. When open, the
       products come first and this renders after them instead (see below). -->
  {pickupSpots.length > 0 && !ORDERS_CURRENTLY_OPEN && (
    <section class="section" id="pickup-spots">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Pickup</p>
          <h2 class="section-heading">Where to pick up</h2>
          <p class="section-sub">
            Choose your spot at checkout. The exact address is emailed to you and shown on your confirmation once your order is placed.
          </p>
        </div>
        <ul class="pickup-spots-grid">
          {pickupSpots.map(spot => (
            <li class="pickup-spot-card">
              <span class="pickup-spot-card-area">{spot.locationName}</span>
              <span class="pickup-spot-card-window">{spotWindowLabel(spot.pickupStart, spot.pickupEnd)}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Drop Items (shown when there are items to display) -->
  {displayItems.length > 0 && (
    <section class={`section${ORDERS_CURRENTLY_OPEN ? '' : ' section-tinted'}`} id="drop-items">
      <div class="container">

        {ORDERS_CURRENTLY_OPEN ? (
          <div class="drop-header-row">
            <div>
              <p class="eyebrow">In This Drop</p>
              <h2 class="drop-section-title">What's in {DROP_NAME}</h2>
              <p class="drop-date-label">Open until {ORDERS_CLOSE_LABEL} · quantities limited</p>
            </div>
            <span class="drop-status-chip chip-open">● Orders Open</span>
          </div>
        ) : (
          <div class="section-header">
            <p class="eyebrow">Drop Preview</p>
            <h2 class="section-heading">Sneak Peek — {DROP_NAME}</h2>
            <p class="section-sub">
              A preview of what's baking for the next drop. Full details and pricing revealed when orders open.
            </p>
          </div>
        )}

        <div class="product-grid">
          {displayItems.map(item => {
            const remaining = item.initialStock - item.consumedStock;
            const inStock = remaining > 0;
            const soldOut = ORDERS_CURRENTLY_OPEN && !inStock;
            // Only surface remaining counts once stock dips to the admin's
            // threshold (threshold 0 = never). Otherwise the item just reads
            // as available with no number.
            const lowStock = ORDERS_CURRENTLY_OPEN && inStock && LOW_STOCK_THRESHOLD > 0 && LOW_STOCK_THRESHOLD >= remaining;
            // Badge is only shown when it has something meaningful to say:
            // sold out, low stock, or a pre-open "Coming Soon" preview.
            const stockBadgeClass = soldOut
              ? 'stock-badge-soldout'
              : lowStock
                ? 'stock-badge-low'
                : 'stock-badge-coming-soon';
            const stockBadgeText = soldOut
              ? 'Sold Out'
              : lowStock
                ? `Low stock, ${remaining} left`
                : !ORDERS_CURRENTLY_OPEN
                  ? 'Coming Soon'
                  : null;
            return (
              <div class={`product-card${soldOut ? ' sold-out' : ''}`}>
                <div class="product-card-image">
                  <img src={CDN_URL + item.menuItem.id} alt={item.menuItem.name} loading="lazy" />
                  {stockBadgeText && (
                    <span class={`stock-badge ${stockBadgeClass}`}>{stockBadgeText}</span>
                  )}
                  {item.tag && <span class="cookie-tag">{item.tag}</span>}
                </div>
                <div class="product-card-body">
                  <h3>{item.menuItem.name}</h3>
                  <p>{item.menuItem.description}</p>
                  {lowStock && (
                    <p class="scarcity-note">Going fast — only {remaining} left</p>
                  )}
                  {ORDERS_CURRENTLY_OPEN && (
                    <div
                      class="product-card-actions"
                      data-item-id={item.menuItem.id}
                      data-item-name={item.menuItem.name}
                      data-item-price-cents={Math.round(item.menuItem.price * 100)}
                      data-item-remaining={remaining}
                    >
                      <div class="product-card-buy">
                        <span class="product-price">{formatPrice(item.menuItem.price)}</span>
                        <div class="qty-stepper">
                          <button type="button" class="qty-btn qty-minus" aria-label={`Decrease quantity of ${item.menuItem.name}`} disabled={soldOut}>−</button>
                          <span class="qty-value" aria-live="polite">0</span>
                          <button type="button" class="qty-btn qty-plus" aria-label={`Increase quantity of ${item.menuItem.name}`} disabled={soldOut}>+</button>
                        </div>
                      </div>
                      <button type="button" class="btn-primary add-to-cart-btn" disabled={soldOut}>Add to Cart</button>
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </section>
  )}

  <!-- Pickup spots — when orders are open, products come first, so the pickup
       areas/windows render here (after the items) to avoid pushing the drop
       down. When closed, this instead renders above (under the countdown). -->
  {pickupSpots.length > 0 && ORDERS_CURRENTLY_OPEN && (
    <section class="section" id="pickup-spots">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Pickup</p>
          <h2 class="section-heading">Where to pick up</h2>
          <p class="section-sub">
            Choose your spot at checkout. The exact address is emailed to you and shown on your confirmation once your order is placed.
          </p>
        </div>
        <ul class="pickup-spots-grid">
          {pickupSpots.map(spot => (
            <li class="pickup-spot-card">
              <span class="pickup-spot-card-area">{spot.locationName}</span>
              <span class="pickup-spot-card-window">{spotWindowLabel(spot.pickupStart, spot.pickupEnd)}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Social proof (open orders only) -->
  {ORDERS_CURRENTLY_OPEN && (
    <section class="section section-tinted" id="order-reviews">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Loved on Campus</p>
          <h2 class="section-heading">Why students keep coming back</h2>
        </div>
        <div class="reviews-grid">
          <div class="review-card">
            <p class="review-text">"Hands down the best cookie I've had at Berkeley. Still warm at pickup — I order every single drop."</p>
            <p class="review-author">Maya · UC Berkeley</p>
          </div>
          <div class="review-card">
            <p class="review-text">"You can tell these are actually made from scratch. They sell out fast for a reason."</p>
            <p class="review-author">Devon · UC Davis</p>
          </div>
          <div class="review-card">
            <p class="review-text">"Ordering took 30 seconds and pickup was right on campus. Already telling my whole dorm."</p>
            <p class="review-author">Priya · UC Berkeley</p>
          </div>
        </div>
        <div class="how-cta" style="margin-top:3rem;">
          <a href="#drop-items" class="btn-primary">Back to the Drop ↑</a>
        </div>
      </div>
    </section>
  )}

  <!-- Bottom Navigation -->
  <section class="section" id="back-to-menu">
    <div class="container order-page-links">
      <a href="/menu" class="order-page-link">← Browse the Menu</a>
      <a href="/about" class="order-page-link">About Us →</a>
    </div>
  </section>

  <!-- Floating cart button (mobile only — header cart is hidden behind the hamburger) -->
  {ORDERS_CURRENTLY_OPEN && displayItems.length > 0 && (
    <a href="/cart" class="cart-fab" id="cart-bar" hidden aria-label="View cart">
      <span class="cart-fab-summary">
        <span id="cart-bar-count">0 items</span>
        <span class="cart-bar-dot">·</span>
        <span id="cart-bar-total">$0.00</span>
      </span>
      <span class="cart-fab-cta">View Cart →</span>
    </a>
  )}

  <script is:inline define:vars={{ NEXT_DROP_OPEN_STR, ORDERS_CLOSE_STR: currentDrop?.closeTime ?? null, ORDERS_CURRENTLY_OPEN }}>
    // ── Countdown Timer ───────────────────────────────────────────
    var target = NEXT_DROP_OPEN_STR ? new Date(NEXT_DROP_OPEN_STR).getTime() : NaN;

    function pad(n) { return String(n).padStart(2, '0'); }

    function updateCountdown() {
      if (!target || isNaN(target)) return;
      var now  = Date.now();
      var diff = target - now;
      // Window just opened — reload so the server re-renders the open state.
      if (diff <= 0) {
        window.location.reload();
        return;
      }

      var days    = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours   = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((diff % (1000 * 60)) / 1000);

      var dEl = document.getElementById('cd-days');
      var hEl = document.getElementById('cd-hours');
      var mEl = document.getElementById('cd-minutes');
      var sEl = document.getElementById('cd-seconds');

      if (dEl) dEl.textContent = pad(days);
      if (hEl) hEl.textContent = pad(hours);
      if (mEl) mEl.textContent = pad(minutes);
      if (sEl) sEl.textContent = pad(seconds);
    }

    if (document.getElementById('cd-days')) {
      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    // While orders are open, reload once the close time passes so the
    // server re-renders the closed state and next countdown.
    if (ORDERS_CURRENTLY_OPEN && ORDERS_CLOSE_STR) {
      var closeMs = new Date(ORDERS_CLOSE_STR).getTime();
      setInterval(function () {
        if (Date.now() >= closeMs) window.location.reload();
      }, 1000);
    }
  </script>

</Layout>

<script>
  import { getQty, setQty, cartCount, cartSubtotalCents, onCartChange } from '../lib/cart';

  function initOrderCart() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card-actions'));
    if (cards.length === 0) return;

    const bar = document.getElementById('cart-bar');
    const barCount = document.getElementById('cart-bar-count');
    const barTotal = document.getElementById('cart-bar-total');

    function money(cents: number) { return '$' + (cents / 100).toFixed(2); }

    function syncBar() {
      const n = cartCount();
      if (bar) bar.hidden = n === 0;
      if (barCount) barCount.textContent = n + (n === 1 ? ' item' : ' items');
      if (barTotal) barTotal.textContent = money(cartSubtotalCents());
    }

    // Each card keeps a local quantity selector; nothing touches the cart
    // until the customer clicks "Add to Cart".
    const cardSyncs: Array<() => void> = [];

    cards.forEach(card => {
      const id = card.dataset.itemId!;
      const name = card.dataset.itemName!;
      const priceCents = parseInt(card.dataset.itemPriceCents ?? '0', 10);
      const remaining = parseInt(card.dataset.itemRemaining ?? '0', 10);

      const valueEl = card.querySelector('.qty-value')!;
      const minus = card.querySelector('.qty-minus') as HTMLButtonElement;
      const plus = card.querySelector('.qty-plus') as HTMLButtonElement;
      const addBtn = card.querySelector('.add-to-cart-btn') as HTMLButtonElement;

      const inCart = () => getQty(id);
      // The counter reflects the total quantity for this item in the cart.
      // It starts at whatever is already in the cart (0 when nothing is).
      let localQty = Math.min(inCart(), remaining);
      let feedbackTimer = 0;

      function sync() {
        localQty = Math.min(Math.max(0, localQty), remaining);
        valueEl.textContent = String(localQty);
        minus.disabled = localQty <= 0;
        plus.disabled = localQty >= remaining;
        // Don't clobber the transient feedback label while it's showing.
        if (!feedbackTimer) {
          const current = inCart();
          const unchanged = localQty === current;
          addBtn.disabled = remaining === 0 || unchanged;
          addBtn.textContent = remaining === 0
            ? 'Sold out'
            : unchanged
              ? current > 0 ? 'In cart' : 'Add to Cart'
              : localQty === 0
                ? 'Remove from cart'
                : current > 0 ? 'Update cart' : 'Add to Cart';
        }
      }
      cardSyncs.push(sync);

      minus.addEventListener('click', () => { if (localQty > 0) { localQty--; sync(); } });
      plus.addEventListener('click', () => { if (localQty < remaining) { localQty++; sync(); } });

      addBtn.addEventListener('click', () => {
        if (remaining === 0 || localQty === inCart()) return;
        const removing = localQty === 0;
        setQty({ id, name, priceCents }, localQty);

        addBtn.textContent = removing ? 'Removed ✓' : 'Added ✓';
        addBtn.classList.add('added');
        addBtn.disabled = true;
        window.clearTimeout(feedbackTimer);
        feedbackTimer = window.setTimeout(() => {
          feedbackTimer = 0;
          addBtn.classList.remove('added');
          sync();
        }, 1100);
      });

      sync();
    });

    function syncAll() {
      cardSyncs.forEach(fn => fn());
      syncBar();
    }

    onCartChange(syncAll);
    syncAll();
  }

  initOrderCart();
</script>

<style>
  /* ── Order-page product cards (scoped overrides) ──────────────── */
  /* Editorial style: square corners, thin accent borders, no shadows —
     matching the site's review / membership cards. */
  .product-grid {
    gap: 2rem;
  }

  .product-card {
    border: 1px solid var(--accent);
    height: 100%;
    transition: border-color 0.25s ease;
  }
  .product-card:hover {
    border-color: var(--text-muted);
  }
  .product-card.sold-out:hover {
    border-color: var(--accent);
  }

  .product-card-body {
    padding: 1.25rem 1.4rem 1.5rem;
    border-bottom: none;
    border-top: 1px solid var(--accent);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .product-card-body h3 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .product-card-body > p:not(.scarcity-note) {
    min-height: 2.6em;
  }

  .product-card-actions {
    margin-top: auto;
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .product-card-buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .product-price {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--text-primary);
  }
  .add-to-cart-btn { width: 100%; }
  .add-to-cart-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .add-to-cart-btn.added { background: #2D6A45; }
  .qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--accent);
  }
  .qty-btn {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.25rem;
    line-height: 1;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    transition: background 0.15s ease;
  }
  .qty-btn:hover:not(:disabled) { background: rgba(0, 0, 0, 0.04); }
  .qty-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .qty-value {
    min-width: 1.75rem;
    text-align: center;
    font-weight: 600;
    border-left: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
  }

  .stock-badge-soldout { background: #b00020; color: #fff; }

  /* Pickup spots — public areas + windows shown before checkout. */
  .pickup-spots-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .pickup-spot-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: 1px solid var(--accent);
    padding: 1.1rem 1.25rem;
  }
  .pickup-spot-card-area {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--text-primary);
  }
  .pickup-spot-card-window {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* No-drop state: the SMS signup is the main call to action. */
  .no-drop-signup {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--accent);
  }
  .no-drop-signup :global(.sms-signup-form) {
    margin: 0 auto;
  }

  /* Floating cart button — compact, mobile only.
     Hidden on desktop/tablet where the header cart link is visible. */
  .cart-fab {
    display: none;
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 30;
    align-items: center;
    gap: 0.75rem;
    background: var(--text-primary);
    color: var(--bg);
    text-decoration: none;
    padding: 0.7rem 1rem;
    box-shadow: 0 6px 18px rgba(26, 26, 26, 0.22);
  }
  .cart-fab-summary {
    font-size: 0.78rem;
    font-weight: 600;
  }
  .cart-bar-dot { margin: 0 0.35rem; opacity: 0.55; }
  .cart-fab-cta {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-left: 1px solid rgba(250, 247, 242, 0.3);
    padding-left: 0.75rem;
    white-space: nowrap;
  }

