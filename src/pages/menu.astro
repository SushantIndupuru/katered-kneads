---
import Layout from '../layouts/Layout.astro';
import type {MenuItem} from '../types/MenuItem';
import {getBestSellers, getMenuItems, getNewItems} from "../lib/db";
export const prerender = true
const CDN_URL = import.meta.env.PUBLIC_SUPABASE_STORAGE_URL;

const CDN = 'https://dc0508f78214d446f6be.cdn6.editmysite.com/uploads/b/dc0508f78214d446f6be87ef75ef20bf04c7b33944d12f06092b0856af4a12be';


const bestsellers = await getBestSellers();


const nextDrop = await getNewItems();

const gallery = await getMenuItems();
---

<Layout
        title="Menu — Katered Kneads"
        description="Browse the Katered Kneads menu. Small-batch handmade cookies — the lineup rotates every biweekly drop."
        activePage="menu"
>

    <!-- Page Hero -->
    <section class="order-hero">
        <div class="container">
            <p class="eyebrow">From the Kitchen</p>
            <h1 class="order-heading">Our Menu</h1>
            <p class="order-sub">The exact lineup rotates each drop. Follow us or join the SMS list to see what's coming
                next.</p>
        </div>
    </section>

    <!-- Bestsellers -->
    <section class="section" id="bestsellers">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">Always a Hit</p>
                <h2 class="section-heading">Our Bestsellers</h2>
                <p class="section-sub">These are the bakes our customers keep coming back for. Some are drop regulars,
                    some rotate — but they're always worth grabbing when they appear.</p>
            </div>
            <div class="cookie-grid">
                {bestsellers.map(item => (
                        <div class="cookie-card">
                            <div class="cookie-card-image">
                                <img src={CDN_URL+item.menuItem.id} alt={item.menuItem.name} loading="lazy"/>
                                <span class="cookie-tag">{item.tag}</span>
                            </div>
                            <div class="cookie-card-body">
                                <h3>{item.menuItem.name}</h3>
                                <p>{item.menuItem.description}</p>
                            </div>
                        </div>
                ))}
            </div>
        </div>
    </section>

    <!-- This Drop's Preview -->
    <section class="section section-tinted" id="this-drop">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">Coming Up</p>
                <h2 class="section-heading">Next Drop Preview</h2>
                <p class="section-sub">A sneak peek at what's baking for the next drop. Full menu and pricing revealed
                    when orders open.</p>
            </div>

            <div class="cookie-grid">
                {nextDrop.map(item => (
                        <div class={`cookie-card${item.menuItem.mystery ? ' cookie-card-tease' : ''}`}>
                            <div class={`cookie-card-image${item.menuItem.mystery ? ' cookie-card-image-mystery' : ''}`}>
                                {item.menuItem.mystery
                                    ?
                                        <div class="mystery-placeholder">?</div>
                                    : <img src={CDN_URL+item.menuItem.id} alt={item.menuItem.name} loading="lazy"/>
                                }
                                {item.tag && <span class="cookie-tag">{item.tag}</span>}
                            </div>
                            <div class="cookie-card-body">
                                <h3>{item.menuItem.name}</h3>
                                <p>{item.menuItem.description}</p>
                            </div>
                        </div>
                ))}
            </div>

            <div class="cookie-cta">
                <a href="/order" class="btn-primary">Place a Preorder →</a>
            </div>
        </div>
    </section>

    <!-- Photo Gallery -->
    <section class="section" id="gallery">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">Made by Hand</p>
                <h2 class="section-heading">A look inside the kitchen</h2>
                <p class="section-sub">Every batch made fresh. No shortcuts, no mixes — just real ingredients and
                    genuine care.</p>
            </div>
            <div class="gallery-grid">
                {gallery.map(item => {
                        if (item.mystery) return;
                       return (<figure class="gallery-item">
                            <img src={CDN_URL+item.id} alt={item.name} loading="lazy"/>
                            <figcaption>{item.name}</figcaption>
                        </figure>)
                })}
            </div>
        </div>
    </section>

</Layout>

