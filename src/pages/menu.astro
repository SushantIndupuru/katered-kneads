---
import Layout from '../layouts/Layout.astro';
import type { MenuItem } from '../types/db-types.ts';
import { getMenuItems, getCurrentDrop, getDropItems } from '../lib/db';

const CDN_URL = import.meta.env.PUBLIC_SUPABASE_STORAGE_URL;

const allItems = await getMenuItems();
const currentDrop = await getCurrentDrop();
const dropItems = currentDrop ? await getDropItems(currentDrop.id) : [];

// Is the current drop actually live (inside its [open, close) window)?
const now = Date.now();
const openMs = currentDrop ? new Date(currentDrop.openTime).getTime() : null;
const closeMs = currentDrop ? new Date(currentDrop.closeTime).getTime() : null;
const DROP_OPEN = openMs !== null && closeMs !== null && now >= openMs && now < closeMs;

// When the drop is live, badge everything in it. Before it opens, only the
// preview picks are public — so only those get a "coming soon" badge; the rest
// of the lineup stays hidden until orders open.
const dropItemIds = new Set(dropItems.map(d => d.menuItem.id));
const previewItemIds = new Set(dropItems.filter(d => d.preview).map(d => d.menuItem.id));

function getItemBadge(item: MenuItem): { text: string; cls: string } | null {
  if (DROP_OPEN) {
    if (!dropItemIds.has(item.id)) return null;
    return { text: 'This Drop', cls: 'stock-badge-available' };
  }
  if (previewItemIds.has(item.id)) {
    return { text: 'Coming Soon', cls: 'stock-badge-coming-soon' };
  }
  return null;
}
---

<Layout
  title="Our Treats — Katered Kneads"
  description="Browse the full Katered Kneads lineup of small-batch handmade treats. The selection rotates every biweekly drop."
  activePage="menu"
>

  <!-- Page Header -->
  <section class="order-hero">
    <div class="container">
      <p class="eyebrow">Our Catalog</p>
      <h1 class="order-heading">Our Treats</h1>
      <p class="order-sub">
        Every item we've featured in past drops. Not everything comes back at every drop.
        Check the <a href="/order" style="color:var(--text-primary);text-decoration:underline;text-underline-offset:2px;">order page</a> for what's live right now.
      </p>
    </div>
  </section>

  <!-- Catalog -->
  <section class="section" id="catalog">
    <div class="container">

      <!-- Rotating-menu notice -->
      <div class="menu-note">
        <strong>Heads up:</strong> This is a living catalog — items rotate in and out each drop. Follow us on
        <a href="https://www.instagram.com/Katered_Kneads" target="_blank" rel="noopener noreferrer">Instagram</a>
        to know exactly what's in the next drop.
      </div>

      <!-- Current drop CTA -->
      <div class="menu-current-cta">
        <span>Want to see what's available right now?</span>
        <a href="/order" class="btn-primary">See the Current Drop →</a>
      </div>

      <!-- Item Grid -->
      {allItems.length > 0 ? (
        <div class="product-grid" id="catalog-grid">

          {allItems.map(item => {
            const badge = getItemBadge(item);
            return (
              <div class="product-card">
                <div class="product-card-image">
                  <img src={CDN_URL + item.id} alt={item.name} loading="lazy" />
                  {badge && (
                    <span class={`stock-badge ${badge.cls}`}>{badge.text}</span>
                  )}
                </div>
                <div class="product-card-body">
                  <h3>{item.name}</h3>
                  <p>{item.description}</p>
                </div>
              </div>
            );
          })}

        </div>
      ) : (
        <!-- Empty state when DB has no items yet -->
        <div class="drop-placeholder">
          <p class="eyebrow">Drops Coming Soon</p>
          <p>Our catalog is being updated. Follow us on Instagram to see what's dropping next.</p>
          <div style="margin-top:1.5rem;">
            <a href="/order" class="btn-primary">See the Current Drop →</a>
          </div>
        </div>
      )}

      <div style="margin-top:3rem;display:flex;gap:1.5rem;flex-wrap:wrap;align-items:center;border-top:1px solid var(--accent);padding-top:2rem;">
        <a href="/order" class="btn-primary">Place an Order →</a>
        <a href="/catering" class="btn-secondary">Request Catering →</a>
        <a href="https://www.instagram.com/Katered_Kneads" target="_blank" rel="noopener noreferrer" class="btn-secondary">Follow on Instagram →</a>
      </div>

    </div>
  </section>

</Layout>
