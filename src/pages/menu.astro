---
import Layout from '../layouts/Layout.astro';
import type { MenuItem } from '../types/db-types.ts';
import { getMenuItems, getNewItems } from '../lib/db';
export const prerender = true

const CDN_URL = import.meta.env.PUBLIC_SUPABASE_STORAGE_URL;

const allItems = await getMenuItems();
const newItems = await getNewItems();

const newItemIds = new Set(newItems.map(n => n.menuItem.id));

function getItemDataTags(item: MenuItem): string {
  return newItemIds.has(item.id) ? 'all this-drop' : 'all';
}

function getItemBadge(item: MenuItem): { text: string; cls: string } | null {
  if (item.mystery || !newItemIds.has(item.id)) return null;
  return { text: 'This Drop', cls: 'stock-badge-available' };
}
---

<Layout
  title="Menu — Katered Kneads"
  description="Browse the full Katered Kneads catalog. Small-batch handmade cookies — the lineup rotates every biweekly drop."
  activePage="menu"
>

  <!-- Page Header -->
  <section class="order-hero">
    <div class="container">
      <p class="eyebrow">Our Catalog</p>
      <h1 class="order-heading">The Menu</h1>
      <p class="order-sub">
        Every item we've ever offered — updated each drop. Not everything is available at every drop.
        Check the <a href="/order" style="color:var(--text-primary);text-decoration:underline;text-underline-offset:2px;">order page</a> for what's live right now.
      </p>
    </div>
  </section>

  <!-- Catalog -->
  <section class="section" id="catalog">
    <div class="container">

      <!-- Rotating-menu notice -->
      <div class="menu-note">
        <strong>Heads up:</strong> This is a living catalog — items rotate in and out each drop. Follow us on
        <a href="https://www.instagram.com/Katered_Kneads" target="_blank" rel="noopener noreferrer">Instagram</a>
        or <a href="/order#sms-signup">join the SMS list</a> to know exactly what's in the next drop.
      </div>

      <!-- Filter Tabs -->
      <div class="filter-tabs" role="tablist" aria-label="Filter menu items">
        <button class="filter-btn active" data-filter="all"        role="tab" aria-selected="true">All Items</button>
        <button class="filter-btn"        data-filter="this-drop"  role="tab" aria-selected="false">This Drop</button>
      </div>

      <!-- Item Grid -->
      {allItems.length > 0 ? (
        <div class="product-grid" id="catalog-grid">

          {allItems.map(item => {
            const badge    = getItemBadge(item);
            const dataTags = getItemDataTags(item);
            return (
              <div
                class={`product-card${item.mystery ? ' product-card-mystery' : ''}`}
                data-tags={dataTags}
              >
                <div class="product-card-image">
                  {item.mystery
                    ? <div class="mystery-placeholder">?</div>
                    : <img src={CDN_URL + item.id} alt={item.name} loading="lazy" />
                  }
                  {badge && (
                    <span class={`stock-badge ${badge.cls}`}>{badge.text}</span>
                  )}
                </div>
                <div class="product-card-body">
                  <h3>{item.mystery ? '???' : item.name}</h3>
                  <p>{item.mystery ? 'Revealed when orders open.' : item.description}</p>
                </div>
              </div>
            );
          })}

          <!-- Shown via JS when a filter returns zero results -->
          <div class="catalog-empty" id="no-results" style="display:none;">
            No items match this filter right now — check back after the next drop.
          </div>

        </div>
      ) : (
        <!-- Empty state when DB has no items yet -->
        <div class="drop-placeholder">
          <p class="eyebrow">Menu Coming Soon</p>
          <p>Our catalog is being updated. Follow us on Instagram or join the SMS list to see what's dropping next.</p>
          <div style="margin-top:1.5rem;">
            <a href="/order#sms-signup" class="btn-primary">Join SMS List →</a>
          </div>
        </div>
      )}

      <div style="margin-top:3rem;display:flex;gap:1.5rem;flex-wrap:wrap;align-items:center;border-top:1px solid var(--accent);padding-top:2rem;">
        <a href="/order" class="btn-primary">Place a Preorder →</a>
        <a href="/order#sms-signup" class="btn-secondary">Join SMS List →</a>
      </div>

    </div>
  </section>

</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards      = document.querySelectorAll<HTMLElement>('.product-card');
  const noResults  = document.getElementById('no-results');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      // Update active tab state
      filterBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      // Show / hide cards
      let visible = 0;
      cards.forEach(card => {
        const tags = card.dataset.tags ?? '';
        const show = filter === 'all' || tags.split(' ').includes(filter);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      // Empty state
      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }
    });
  });
</script>
