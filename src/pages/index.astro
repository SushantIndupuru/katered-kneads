    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Katered Kneads is Pleasanton's loving home bakery. Katering handmade, 100% scratch goods to all your favorite events." />
    <title>Home Baked Goodness Delivered | Katered Kneads</title>
  </head>
  <body>

