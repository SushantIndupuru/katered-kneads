---
import Image from 'astro/components/Image.astro';
import Layout from '../layouts/Layout.astro';
import banner from '../images/banner.webp'
import { getCurrentDrop, getDropItems } from '../lib/db'

// ── Drop Configuration (driven by the current drop in the DB) ──
const currentDrop = await getCurrentDrop();
const dropItems = currentDrop ? await getDropItems(currentDrop.id) : [];

const DATE_LABEL_OPTS = {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
  timeZone: 'America/Los_Angeles',
} as const;
function formatDropDate(iso: string): string {
  return new Date(iso).toLocaleString('en-US', DATE_LABEL_OPTS);
}

const now = Date.now();
const openMs  = currentDrop ? new Date(currentDrop.openTime).getTime()  : null;
const closeMs = currentDrop ? new Date(currentDrop.closeTime).getTime() : null;

const ORDERS_CURRENTLY_OPEN = openMs !== null && closeMs !== null && now >= openMs && now < closeMs;
const BEFORE_OPEN = openMs !== null && now < openMs;
const SHOW_COUNTDOWN = BEFORE_OPEN && (currentDrop?.showCountdown ?? false);

// Show the drop bar / upcoming section only when there's something to announce:
// either orders are live, or the admin enabled the countdown teaser.
const SHOW_DROP = ORDERS_CURRENTLY_OPEN || SHOW_COUNTDOWN;
const displayItems = ORDERS_CURRENTLY_OPEN ? dropItems : dropItems.filter(i => i.preview);

const NEXT_DROP_OPEN_LABEL = currentDrop ? formatDropDate(currentDrop.openTime) : 'soon';
const ORDERS_CLOSE_LABEL   = currentDrop ? formatDropDate(currentDrop.closeTime) : '';
const DROP_NAME            = currentDrop?.name ?? 'Next Drop';
const CDN_URL              = import.meta.env.PUBLIC_SUPABASE_STORAGE_URL;
---

<Layout title="Katered Kneads — Handmade Campus Cookies">

  <!-- Drop Announcement Bar -->
  {SHOW_DROP && (
    <div class={`drop-bar${ORDERS_CURRENTLY_OPEN ? ' drop-bar-open' : ''}`}>
      {ORDERS_CURRENTLY_OPEN
        ? <span>● Orders are <strong>OPEN NOW</strong> — closes {ORDERS_CLOSE_LABEL} <a href="/order">Order Now →</a></span>
        : <span>{DROP_NAME} opens <strong>{NEXT_DROP_OPEN_LABEL}</strong> <a href="/order">Get Notified →</a></span>
      }
    </div>
  )}

  <!-- Hero -->
  <section class="hero hero--no-top" id="home">
    <div class="hero-banner">
      <Image class="hero-image" src={banner} alt="Freshly baked goods from Katered Kneads" />
      <div class="hero-overlay">
        <p class="eyebrow">UC Berkeley &amp; UC Davis</p>
        <h1 class="hero-headline">Katered<br />Kneads</h1>
      </div>
    </div>

    <div class="hero-tagline-block">
      <p class="hero-tagline">
        Small-batch, handmade cookies baked fresh from scratch — dropped every two weeks on campus.
      </p>
      <div class="hero-pills">
        <span class="pill">100% From Scratch</span>
        <span class="pill">Biweekly Drops</span>
        <span class="pill">Limited Per Drop</span>
        <span class="pill">Campus Pickup</span>
      </div>
      <div style="margin-top: 2.25rem; display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;">
        <a href="/order" class="btn-primary">
          {ORDERS_CURRENTLY_OPEN ? 'Order Now →' : 'View Current Drop →'}
        </a>
        <a href="/menu" class="btn-secondary">Our Treats →</a>
      </div>
    </div>
  </section>

  <!-- Current / Upcoming Drop Section -->
  <section class="section" id="current-drop">
    <div class="container">

      <div class="drop-header-row">
        <div>
          <p class="eyebrow">{ORDERS_CURRENTLY_OPEN ? 'Live Now' : 'Coming Up'}</p>
          <h2 class="drop-section-title"><span class="drop-num">{DROP_NAME}</span></h2>
          <p class="drop-date-label">
            {ORDERS_CURRENTLY_OPEN
              ? `Open until ${ORDERS_CLOSE_LABEL}`
              : SHOW_COUNTDOWN
                ? `Opens ${NEXT_DROP_OPEN_LABEL}`
                : 'Coming soon'
            }
          </p>
        </div>
        <span class={`drop-status-chip ${ORDERS_CURRENTLY_OPEN ? 'chip-open' : 'chip-closed'}`}>
          {ORDERS_CURRENTLY_OPEN ? '● Live Now' : '● Coming Soon'}
        </span>
      </div>

      {displayItems.length > 0 ? (
        <div class="product-grid">
          {displayItems.map(item => (
            <div class="product-card">
              <div class="product-card-image">
                <img src={CDN_URL + item.menuItem.id} alt={item.menuItem.name} loading="lazy" />
                <span class={`stock-badge ${ORDERS_CURRENTLY_OPEN ? 'stock-badge-available' : 'stock-badge-coming-soon'}`}>
                  {ORDERS_CURRENTLY_OPEN ? 'Limited' : 'Coming Soon'}
                </span>
                {item.tag && <span class="cookie-tag">{item.tag}</span>}
              </div>
              <div class="product-card-body">
                <h3>{item.menuItem.name}</h3>
                <p>{item.menuItem.description}</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="drop-placeholder">
          <p class="eyebrow">Menu Dropping Soon</p>
          <p>Items for {DROP_NAME} will be revealed when orders open. Join the SMS list to be the first to know.</p>
          <div style="margin-top: 1.5rem;">
            <a href="/order#sms-signup" class="btn-primary">Join SMS List →</a>
          </div>
        </div>
      )}

      <div class="drop-cta">
        <a href="/order" class="btn-primary">
          {ORDERS_CURRENTLY_OPEN ? 'Place Your Order →' : 'See Full Drop Details →'}
        </a>
        <a href="/menu" class="btn-secondary">Our Treats →</a>
      </div>

    </div>
  </section>

  <!-- How It Works -->
  <section class="section section-tinted" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Getting Your Kneads</p>
        <h2 class="section-heading">How It Works</h2>
        <p class="section-sub">Orders open every two weeks. Here's how to never miss a drop.</p>
      </div>

      <div class="how-steps">
        <div class="how-step">
          <div class="how-step-number">01</div>
          <div class="how-step-content">
            <h3>Watch for the Drop</h3>
            <p>Orders open once every two weeks. <a href="/order#sms-signup">Join our SMS list</a> to get a text ~5 minutes before orders go live.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-step-number">02</div>
          <div class="how-step-content">
            <h3>Place Your Order</h3>
            <p>Browse that drop's menu and select your items. Orders are first-come, first-served — quantities are limited and sell fast.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-step-number">03</div>
          <div class="how-step-content">
            <h3>Choose Your Campus</h3>
            <p>Select pickup at UC Davis or UC Berkeley. Exact location and time confirmed with each drop.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-step-number">04</div>
          <div class="how-step-content">
            <h3>Pick Up Fresh</h3>
            <p>Grab your freshly baked order on campus. Baked to order — never sitting on a shelf.</p>
          </div>
        </div>
      </div>

      <div class="how-cta">
        <a href="/order" class="btn-primary">Go to Order Page →</a>
      </div>
    </div>
  </section>

  <!-- Brand Manifesto -->
  <section class="section section-dark">
    <div class="container">
      <div class="mission-inner">
        <blockquote class="mission-quote">
          "We started Katered Kneads because we believe everyone deserves a truly great cookie — made by hand, with real ingredients, and absolutely no shortcuts."
        </blockquote>
        <p class="mission-byline">— Ellyse &amp; Jake, co-founders</p>

        <div class="trust-badges">
          <div class="trust-badge">
            <span class="trust-badge-title">100% Scratch</span>
            <span class="trust-badge-sub">No mixes, no pre-made dough. Every knead starts from raw ingredients.</span>
          </div>
          <div class="trust-badge">
            <span class="trust-badge-title">Made to Order</span>
            <span class="trust-badge-sub">We only bake what's been ordered — no waste, maximum freshness.</span>
          </div>
          <div class="trust-badge">
            <span class="trust-badge-title">Deliberately Limited</span>
            <span class="trust-badge-sub">Small batches so every single bake gets the care it deserves.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>