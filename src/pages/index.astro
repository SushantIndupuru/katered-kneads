              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>

        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- Hero -->
    <section class="hero" id="about">
      <div class="hero-banner">
        <img
          src={`${CDN}/2024-03-16_21-07-46_1710648486.jpg`}
          alt="Freshly baked goods from Katered Kneads"
          class="hero-image"
        />
        <div class="hero-overlay">
          <p class="eyebrow">Goodness: Whenever, Wherever</p>
          <h1 class="hero-headline">Katered<br />Kneads</h1>
        </div>
      </div>

      <div class="hero-content">
        <div class="hero-body">
          <p>
            Delicious, Nostalgic Home Bakes Delivered. Katered Kneads is Pleasanton's loving home bakery — katering handmade, 100% scratch goods to all your favorite events.
          </p>
          <p>
            Every knead is made with unmatched love and precision. We take a very limited amount of orders so every bake gets the attention it truly deserves.
          </p>
        </div>

        <div class="features">
          <div class="feature-item">
            <h4>The KatBox</h4>
            <p>A basket of items delivered in a sharable, portable way — curated fresh each drop.</p>
          </div>
          <div class="feature-item">
            <h4>Handmade to Order</h4>
            <p>100% from scratch, every time. Limited orders so every bake stays at its freshest.</p>
          </div>
          <div class="feature-item">
            <h4>Kater Your Event</h4>
            <p>Bring our world-class baking to your event — from a weekly meetup to a family party.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Upcoming KatBox Drops -->
    <section class="section" id="drops">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Coming Up</p>
          <h2 class="section-heading">Upcoming Katbox Drops</h2>
          <p style="margin-top: 1rem; font-size: 0.95rem; color: var(--text-muted); max-width: 520px;">
            Enjoy and Celebrate with Friends and Family!
          </p>
        </div>
        <div class="menu-status">
          <p class="status-label">Order Status</p>
          <h3>Pre-orders closed</h3>
          <p>Pre-orders are currently closed. The next drop will be announced on Instagram.</p>
        </div>
        <p style="margin-top: 1.5rem;">
          <a href="https://kateredkneads.square.site/shop/katering-now/LQ62D5N5VAEN2X4RSTCFQTVK" target="_blank" rel="noopener noreferrer" class="cta-link">Order Online →</a>
        </p>
      </div>
    </section>

    <!-- The KatBox -->
    <section class="section" id="the-katbox">
      <div class="container">
        <div class="katbox-split">
          <div class="katbox-split-image">
            <img
              src={`${CDN}/IMG_7202_1710646151.jpg`}
              alt="A KatBox filled with handmade baked goods"
            />
          </div>
          <div class="katbox-split-text">
            <p class="eyebrow">Our Signature</p>
            <h2 class="section-heading">The KatBox</h2>
            <p>
              The star of Katered Kneads: a basket of items delivered in a sharable, portable way. Each KatBox's goodies and price are chosen by the katerer.
            </p>
            <div class="katbox-details" style="margin-top: 2rem;">
              <div class="katbox-detail-item">
                <span class="katbox-detail-label">Contents</span>
                <span>Chosen by the katerer each drop</span>
              </div>
              <div class="katbox-detail-item">
                <span class="katbox-detail-label">Pricing</span>
                <span>Set per box — announced with each drop</span>
              </div>
              <div class="katbox-detail-item">
                <span class="katbox-detail-label">Availability</span>
                <span>Limited quantities per pre-order window</span>
              </div>
              <div class="katbox-detail-item">
                <span class="katbox-detail-label">Pickup</span>
                <span>Foothill High or Katered Kneads HQ</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Handmade to Order -->
    <section class="section section-tinted" id="handmade">
      <div class="container">
        <div class="handmade-layout">
          <div>
            <p class="eyebrow">Our Promise</p>
            <h2 class="section-heading">Handmade to Order</h2>
          </div>
          <div>
            <p style="font-size: 1rem; color: var(--text-muted); line-height: 1.8;">
              Everyone of our goodies is hand-baked with unmatched love and precision. They're also made 100% from scratch, creating baked goods at their freshest, purest deliciousness. That's why we take a very limited amount of orders.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Kater Your Event -->
    <section class="section" id="events">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">For Every Occasion</p>
          <h2 class="section-heading">Kater Your Event</h2>
        </div>
        <p style="font-size: 0.95rem; color: var(--text-muted); max-width: 520px; margin-bottom: 2.5rem;">
          Bring our worldclass baking to your event. Perfect for a weekly meet with friends or a family party.
        </p>
        <div class="steps-grid">
          <div class="step">
            <div class="step-number">01</div>
            <h3>Reach Out</h3>
            <p>DM us on Instagram or email <a href="mailto:kateredkneads@gmail.com" style="color: var(--text-primary);">kateredkneads@gmail.com</a> with your event details — date, size, and what you're after.</p>
          </div>
          <div class="step">
            <div class="step-number">02</div>
            <h3>We Plan Together</h3>
            <p>We'll work out a custom spread of handmade bakes that fits your occasion and budget. No two events are the same.</p>
          </div>
          <div class="step">
            <div class="step-number">03</div>
            <h3>Enjoy the Bakes</h3>
            <p>Pick up your freshly made order and let the kneads do the talking. Your guests will thank you.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- This Month's Katering Specials -->
    <section class="section" id="menu">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">This Month</p>
          <h2 class="section-heading">Katering Specials</h2>
        </div>
        <div class="menu-status">
          <p class="status-label">Order Status</p>
          <h3>Pre-orders closed</h3>
          <p>Pre-orders are currently closed. The next drop will be announced on Instagram.</p>
        </div>
      </div>
    </section>

    <!-- Our Philosophy -->
    <section class="section" id="philosophy">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Who We Are</p>
          <h2 class="section-heading">Our Philosophy</h2>
        </div>

        <div class="philosophy-grid">
          <div class="philosophy-block">
            <h3>Why the Kat-Box</h3>
            <ul class="philosophy-list">
              <li>It creates variety that keeps baking from feeling like work.</li>
              <li>It allows people to be able to easily share with friends and family.</li>
              <li>It reduces waste. By having equal proportions, we can bake more efficiently, saving packaging, ingredients, and time from waste.</li>
            </ul>
          </div>
          <div class="philosophy-block">
            <h3>The Sauting Sister</h3>
            <p>Every since she was little, Ellyse has loved the kitchen. It's not uncommon for her to spend hours experimenting with new baking techniques or getting lost in the rabbit hole that is the online cooking community. Every knead is sculpted by her caring hands.</p>
          </div>
          <div class="philosophy-block">
            <h3>The Business Brother</h3>
            <p>The one to help bring Ellyse's dreams to life, Jake helps organize all the logistics of Katered Kneads: permits, website, social media, finance. Jake is proudly committed to helping others and serving the community. However, after a year of the kitchen, he's experienced enough to run the show when Ellyse is busy or sick.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- School Sales / Monday Sales -->
    <section class="section" id="school-sales">
      <div class="container">
        <div class="monday-layout">
          <div class="monday-text">
            <p class="eyebrow">Every Week</p>
            <h2 class="section-heading">School Sales</h2>
            <p>
              Get one or two kneads (not katering needed!) during our weekly sales. Pickup at Foothill High or Katered Kneads Headquarters.
            </p>
            <div class="monday-locations" style="margin-top: 2rem; border-left: 1px solid var(--accent); padding-left: 2rem;">
              <p class="eyebrow" style="margin-bottom: 1rem;">Pickup Locations</p>
              <div class="location-item">
                <span class="location-name">Foothill High School</span>
                <span class="location-detail">During school hours, Mondays</span>
              </div>
              <div class="location-item">
                <span class="location-name">Katered Kneads Headquarters</span>
                <span class="location-detail">Pleasanton, CA — address confirmed with each sale</span>
              </div>
            </div>
          </div>
          <div class="monday-image">
            <img
              src={`${CDN}/2025-11-03_18-52-15_1762224745.jpg`}
              alt="Freshly baked kneads available at Monday school sales"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Memberships -->
    <section class="section" id="memberships">
      <div class="container">
        <div class="memberships-intro">
          <div>
            <p class="eyebrow">For the Regulars</p>
            <h2 class="section-heading">Memberships</h2>
            <p style="margin-top: 1rem; font-size: 0.95rem; color: var(--text-muted); max-width: 420px; line-height: 1.75;">
              Access exclusive discounts, our loyalty card, and vote on which cookies you want to see!
            </p>
            <p style="margin-top: 1.5rem;">
              <a href="https://kateredkneads.square.site/shop/memberships/62V6WN7NMGTXBEXGQGDPNKJH" target="_blank" rel="noopener noreferrer" class="cta-link">View Membership Options →</a>
            </p>
          </div>
          <div class="memberships-image">
            <img
              src={`${CDN}/2025-11-03_18-49-12_1762224570.jpg`}
              alt="Katered Kneads membership mockup"
            />
          </div>
        </div>

        <div class="memberships-grid">
          <div class="membership-card">
            <h3>Exclusive Discounts</h3>
            <p>Members get early access and discounted rates on KatBoxes and all drops.</p>
          </div>
          <div class="membership-card">
            <h3>Loyalty Card</h3>
            <p>Collect stamps with every order. The more you kater, the more you save.</p>
          </div>
          <div class="membership-card">
            <h3>Vote on the Menu</h3>
            <p>Members vote on which cookies and bakes show up in the next drop. Your cravings count.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Community Favorites Gallery -->
    <section class="section" id="gallery">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">From the Kitchen</p>
          <h2 class="section-heading">Community Favorites</h2>
        </div>
        <div class="gallery-grid">
          <figure class="gallery-item">
            <img src={`${CDN}/2024-03-16_20-23-15_1710645807.jpg`} alt="Mochi Brownies" />
            <figcaption>Mochi Brownies</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src={`${CDN}/IMG_1939_1710645204.jpg`} alt="Caramelies" />
            <figcaption>Caramelies</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src={`${CDN}/2024-03-16_20-16-40_1710645429.jpg`} alt="Black Sesame Choux" />
            <figcaption>Black Sesame Choux</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src={`${CDN}/IMG_0560_1710646155.jpg`} alt="Double Striped Cookies" />
            <figcaption>Double Striped Cookies</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src={`${CDN}/IMG_1779_1710647354.JPG`} alt="Chocolate Crinkle Cookies" />
            <figcaption>Chocolate Crinkle Cookies</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src={`${CDN}/2024-03-16_20-49-39_1710647390.jpg`} alt="Pandan Honeycomb Cake" />
            <figcaption>Pandan Honeycomb Cake</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Common Questions</p>
          <h2 class="section-heading">Frequently Asked</h2>
        </div>

        <div class="faq-list" role="list">

          <div class="faq-item" role="listitem">
            <button class="faq-question" aria-expanded="false">
              <span>What's in a KatBox?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" role="region">
              <div class="faq-answer-inner">
                Every KatBox is curated by the katerer — the exact items and price are chosen fresh each drop. You might get a mix of sweet and savoury bakes, cookies, pastries, or seasonal specials. Follow us on Instagram to see what's inside before each drop.
              </div>
            </div>
          </div>

          <div class="faq-item" role="listitem">
            <button class="faq-question" aria-expanded="false">
              <span>How do School Sales work?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" role="region">
              <div class="faq-answer-inner">
                School Sales are our casual weekly drops — no pre-order required. We bring a small selection of freshly baked kneads to Foothill High School and Katered Kneads HQ. Just show up and grab what's available while it lasts. Follow our Instagram for that week's items and timing.
              </div>
            </div>
          </div>

          <div class="faq-item" role="listitem">
            <button class="faq-question" aria-expanded="false">
              <span>How does event katering work?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" role="region">
              <div class="faq-answer-inner">
                We can bring our bakes to your event — whether it's a weekly friend catch-up, a birthday party, or a family gathering. Reach out via Instagram DM or email us at kateredkneads@gmail.com with your event details and we'll work out a custom spread that fits your occasion and budget.
              </div>
            </div>
          </div>

          <div class="faq-item" role="listitem">
            <button class="faq-question" aria-expanded="false">
              <span>Do your products contain allergens?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" role="region">
              <div class="faq-answer-inner">
                Yes. Most of our bakes contain gluten (wheat flour), dairy (butter, milk, cream), and eggs. Everything is made in a home kitchen that also handles tree nuts, sesame, and other common allergens. Please get in touch before ordering if you have a severe allergy.
              </div>
            </div>
          </div>

          <div class="faq-item" role="listitem">
            <button class="faq-question" aria-expanded="false">
              <span>Can I modify or cancel my order?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" role="region">
              <div class="faq-answer-inner">
                Because we bake in small, planned batches, modifications and cancellations can only be accepted up to 48 hours before pickup. After that window we're unable to offer changes or refunds. For urgent issues, reach out via Instagram DM or email and we'll do our best to help.
              </div>
            </div>
          </div>

          <div class="faq-item" role="listitem">
            <button class="faq-question" aria-expanded="false">
              <span>How do I store baked goods?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" role="region">
              <div class="faq-answer-inner">
                Most items are best on the day of pickup. Store in an airtight container at room temperature overnight. To refresh, pop in an oven at 160°C for a few minutes or into an air fryer. Many items freeze well for up to 4 weeks — defrost at room temperature and reheat before eating.
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section" id="contact">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Get in Touch</p>
          <h2 class="section-heading">Contact Us</h2>
        </div>
        <div class="contact-grid">
          <div>
            <p class="eyebrow" style="margin-bottom: 0.75rem;">Email</p>
            <a href="mailto:kateredkneads@gmail.com" style="font-size: 0.95rem; color: var(--text-primary); text-decoration: underline; text-underline-offset: 3px;">kateredkneads@gmail.com</a>
          </div>
          <div>
            <p class="eyebrow" style="margin-bottom: 0.75rem;">Instagram</p>
            <a href="https://www.instagram.com/Katered_Kneads" target="_blank" rel="noopener noreferrer" style="font-size: 0.95rem; color: var(--text-primary); text-decoration: underline; text-underline-offset: 3px;">@Katered_Kneads</a>
          </div>
          <div>
            <p class="eyebrow" style="margin-bottom: 0.75rem;">Location</p>
            <p style="font-size: 0.95rem; color: var(--text-muted);">Pleasanton, CA</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer>
      <div class="footer-inner">
        <div class="footer-newsletter">
          <p class="footer-newsletter-heading">Want to know about new items &amp; events?</p>
          <a href="https://www.instagram.com/Katered_Kneads" target="_blank" rel="noopener noreferrer" class="cta-link">Follow us on Instagram →</a>
        </div>
        <div class="footer-bottom">
          <div class="footer-links">
            <a href="/privacy-policy">Privacy Policy</a>
            <a href="/terms">Terms &amp; Conditions</a>
            <a href="/refund-policy">Refund Policy</a>
          </div>
          <p class="footer-copy">&copy; 2026 Katered Kneads &mdash; Pleasanton, CA</p>
        </div>
      </div>
    </footer>

    <script>
      // Scroll header border
      const header = document.getElementById('site-header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          header?.classList.add('scrolled');
        } else {
          header?.classList.remove('scrolled');
        }
      }, { passive: true });

      // Hamburger / Mobile Nav
      const hamburger = document.getElementById('hamburger');
      const mobileNav = document.getElementById('mobile-nav');
      const mobileNavClose = document.getElementById('mobile-nav-close');

      function openMobileNav() {
        mobileNav?.classList.add('open');
        hamburger?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileNav() {
        mobileNav?.classList.remove('open');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      hamburger?.addEventListener('click', openMobileNav);
      mobileNavClose?.addEventListener('click', closeMobileNav);

      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', closeMobileNav);
      });

      // FAQ Accordion
      document.querySelectorAll('.faq-question').forEach(button => {
        button.addEventListener('click', () => {
          const item = button.closest('.faq-item');
          const isOpen = item?.classList.contains('open');

          document.querySelectorAll('.faq-item').forEach(i => {
            i.classList.remove('open');
            i.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
          });

          if (!isOpen && item) {
            item.classList.add('open');
            button.setAttribute('aria-expanded', 'true');
          }
        });
      });
    </script>

  </body>
</html>
