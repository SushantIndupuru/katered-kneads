    // ── Drag-to-reorder ────────────────────────────────────────
    function wireTableDragSort(tbodyId: string, reorderUrl: string) {
        const tbody = document.getElementById(tbodyId);
        if (!tbody) return;

        let dragSrc: HTMLTableRowElement | null = null;

        tbody.addEventListener('dragstart', (e: DragEvent) => {
            const row = (e.target as HTMLElement).closest('tr') as HTMLTableRowElement | null;
            if (!row) return;
            dragSrc = row;
            row.classList.add('dragging');
            if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
        });

        tbody.addEventListener('dragend', () => {
            tbody.querySelectorAll<HTMLTableRowElement>('tr').forEach(r => {
                r.classList.remove('dragging', 'drag-over-top', 'drag-over-bottom');
            });
            dragSrc = null;
        });

        tbody.addEventListener('dragover', (e: DragEvent) => {
            e.preventDefault();
            if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
            const row = (e.target as HTMLElement).closest('tr') as HTMLTableRowElement | null;
            if (!row || row === dragSrc) return;
            tbody.querySelectorAll<HTMLTableRowElement>('tr').forEach(r => {
                r.classList.remove('drag-over-top', 'drag-over-bottom');
            });
            const rect = row.getBoundingClientRect();
            const isTop = e.clientY < rect.top + rect.height / 2;
            row.classList.add(isTop ? 'drag-over-top' : 'drag-over-bottom');
        });

        tbody.addEventListener('dragleave', (e: DragEvent) => {
            const row = (e.target as HTMLElement).closest('tr') as HTMLTableRowElement | null;
            if (row) row.classList.remove('drag-over-top', 'drag-over-bottom');
        });

        tbody.addEventListener('drop', async (e: DragEvent) => {
            e.preventDefault();
            const row = (e.target as HTMLElement).closest('tr') as HTMLTableRowElement | null;
            tbody.querySelectorAll<HTMLTableRowElement>('tr').forEach(r => {
                r.classList.remove('drag-over-top', 'drag-over-bottom');
            });
            if (!row || !dragSrc || row === dragSrc) return;

            const rect = row.getBoundingClientRect();
            const isTop = e.clientY < rect.top + rect.height / 2;
            tbody.insertBefore(dragSrc, isTop ? row : row.nextSibling);

            const ids = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-id]'))
                .map(r => r.dataset.id as string);

            try {
                const res = await fetch(reorderUrl, {
                    method: 'PUT',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ids}),
                });
                if (!res.ok) {
                    const err = await res.json();
                    console.error('Reorder failed:', err.error ?? 'Unknown error');
                }
            } catch (err) {
                console.error('Reorder request failed:', err);
            }
        });
    }

    wireTableDragSort('new-items-tbody', '/api/v1/new-items');
</script>

