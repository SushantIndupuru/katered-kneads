---
import '../styles/global.css';
import {getMenuItems, getActiveDrop, getArchivedDrops, getDropItemCounts, getDropItems, getPickupSpots} from '../lib/db';
import {createAnonClient} from '../lib/supabase';
import type {MenuItem, Drop, DropItemWithMenu, PickupSpot} from '../types/db-types.ts';

const token = Astro.cookies.get('sb-access-token')?.value;
if (!token) return Astro.redirect('/admin/login');

const _supabase = createAnonClient();
const {data: {user: authUser}, error: authError} = await _supabase.auth.getUser(token);
if (authError || !authUser) {
    Astro.cookies.delete('sb-access-token', {path: '/'});
    Astro.cookies.delete('sb-refresh-token', {path: '/'});
    return Astro.redirect('/admin/login');
}

let items: MenuItem[] = [];
let activeDrop: Drop | null = null;
let olderDrops: Drop[] = [];
let fetchError = '';

try {
    items = await getMenuItems();
} catch (e) {
    fetchError = 'Could not load menu items.';
}

let activeSpots: PickupSpot[] = [];
try {
    activeDrop = await getActiveDrop();
    if (activeDrop) activeSpots = await getPickupSpots(activeDrop.id);
} catch (e) {
    // non-fatal
}

try {
    olderDrops = await getArchivedDrops();
} catch (e) {
    // non-fatal
}

let dropItemCounts: Record<string, number> = {};
try {
    dropItemCounts = await getDropItemCounts();
} catch (e) {
    // non-fatal
}

const dropDateFmt = new Intl.DateTimeFormat('en-US', {
    month: 'short', day: 'numeric', year: 'numeric',
    hour: 'numeric', minute: '2-digit',
    timeZone: 'America/Los_Angeles',
});
const dropTimeFmt = new Intl.DateTimeFormat('en-US', {
    hour: 'numeric', minute: '2-digit',
    timeZone: 'America/Los_Angeles',
});
const now = Date.now();

type DropStatus = 'draft' | 'upcoming' | 'live' | 'closed';
function dropStatus(drop: Drop): DropStatus {
    if (!drop.announcedAt) return 'draft';
    const open = new Date(drop.openTime).getTime();
    const close = new Date(drop.closeTime).getTime();
    if (now < open) return 'upcoming';
    if (now < close) return 'live';
    return 'closed';
}
const STATUS_LABEL: Record<DropStatus, string> = {
    draft: 'Draft', upcoming: 'Announced', live: 'Live', closed: 'Closed',
};

// ── Active drop ───────────────────────────────────────────────
let activeDropItems: DropItemWithMenu[] = [];
if (activeDrop) {
    try {
        activeDropItems = await getDropItems(activeDrop.id);
    } catch (e) {
        // non-fatal
    }
}
const activeStatus: DropStatus | null = activeDrop ? dropStatus(activeDrop) : null;

const olderRows = olderDrops.map(drop => ({
    id: drop.id,
    name: drop.name,
    openLabel: dropDateFmt.format(new Date(drop.openTime)),
    closeLabel: dropDateFmt.format(new Date(drop.closeTime)),
    itemCount: dropItemCounts[drop.id] ?? 0,
    openTime: drop.openTime,
    closeTime: drop.closeTime,
}));

const user = authUser as { email?: string };
const storageUrl: string = import.meta.env.PUBLIC_SUPABASE_STORAGE_URL as string;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>Admin — Katered Kneads</title>
</head>
<body class="admin-body">

<!-- Sidebar -->
<aside class="admin-sidebar">
    <div class="admin-sidebar-top">
        <a href="/" class="admin-logo">Katered Kneads</a>
        <span class="admin-badge">Admin</span>
    </div>

    <nav class="admin-nav">
        <a href="/admin" class="admin-nav-link admin-nav-active">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
            </svg>
            Dashboard
        </a>
        <a href="/admin/stock" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            Stock
        </a>
        <a href="/admin/pos" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="2" y1="9" x2="22" y2="9"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            Point of Sale
        </a>
        <a href="/admin/orders" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 2h6a1 1 0 0 1 1 1v1h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1z"/>
                <line x1="9" y1="12" x2="15" y2="12"/>
                <line x1="9" y1="16" x2="15" y2="16"/>
            </svg>
            Orders
        </a>
        <a href="/admin/sms" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            SMS
        </a>
        <a href="/menu" target="_blank" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
            </svg>
            View Menu ↗
        </a>
    </nav>

    <div class="admin-sidebar-footer">
        <p class="admin-user-email">{user?.email ?? 'Admin'}</p>
        <form method="POST" action="/api/v1/auth/logout">
            <button type="submit" class="admin-logout-btn">Sign Out</button>
        </form>
    </div>
</aside>

<!-- Main content -->
<main class="admin-main">
    <div class="admin-topbar">
        <div>
            <h1 class="admin-page-title" id="page-title">Menu Items</h1>
            <p class="admin-page-sub" id="page-sub">{items.length} total item{items.length !== 1 ? 's' : ''}</p>
        </div>
        <button class="btn-primary" id="open-add-modal">+ Add Item</button>
    </div>

    <!-- Tab bar -->
    <div class="admin-tabs" data-items-total={items.length}>
        <button class="admin-tab admin-tab-active" data-tab="menu-items">Menu Items</button>
        <button class="admin-tab" data-tab="drops">Drops</button>
    </div>

    {fetchError && (
            <div class="admin-alert admin-alert-error">{fetchError}</div>)}

    <!-- Menu items tab -->
    <div id="tab-menu-items" class="admin-tab-panel">
        <div class="admin-table-wrap">
            {items.length === 0 ? (
                    <div class="admin-empty">No menu items yet. Add one to get started.</div>) : (
                    <table class="admin-table">
                        <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {items.map(item => (
                                <tr data-id={item.id}>
                                    <td class="admin-td-name">{item.name}</td>
                                    <td class="admin-td-desc">{item.description || '—'}</td>
                                    <td class="admin-td-price">${item.price.toFixed(2)}</td>
                                    <td class="admin-td-image">
                                        <a href={storageUrl + item.id} target="_blank" class="admin-image-thumb-link"
                                           title={storageUrl + item.id}>
                                            <img src={storageUrl + item.id} alt={item.name} class="admin-image-thumb"/>
                                        </a>
                                    </td>
                                    <td class="admin-td-actions">
                                        <div class="admin-td-actions-inner">
                                            <button
                                                    class="admin-btn-edit"
                                                    data-id={item.id}
                                                    data-name={item.name}
                                                    data-description={item.description}
                                                    data-price={item.price}
                                                    data-image={storageUrl + item.id}
                                            >Edit
                                            </button>
                                            <button class="admin-btn-delete" data-id={item.id}>Delete</button>
                                        </div>
                                    </td>
                                </tr>))}
                        </tbody>
                    </table>)}
        </div>
    </div>

    <!-- Drops tab -->
    <div id="tab-drops" class="admin-tab-panel" hidden>
        {activeDrop && activeStatus ? (
                <div class="drop-detail">
                    <div class="drop-detail-head">
                        <div class="drop-detail-meta">
                            <span class={`admin-drop-status admin-drop-${activeStatus}`}>{STATUS_LABEL[activeStatus]}</span>
                            <h2 class="drop-detail-name">{activeDrop.name}</h2>
                            <p class="drop-detail-schedule">
                                Opens {dropDateFmt.format(new Date(activeDrop.openTime))}
                                <span class="drop-detail-sep">·</span>
                                Closes {dropDateFmt.format(new Date(activeDrop.closeTime))}
                            </p>
                            {activeSpots.length > 0 && (
                                <ul class="drop-detail-spots">
                                    {activeSpots.map(spot => (
                                        <li class="drop-detail-spot">
                                            <span class="drop-detail-spot-name">{spot.locationName}</span>
                                            <span class="drop-detail-spot-window">
                                                {dropDateFmt.format(new Date(spot.pickupStart))} – {dropTimeFmt.format(new Date(spot.pickupEnd))}
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                        <div class="drop-detail-actions">
                            {activeStatus === 'draft' && (
                                    <button class="btn-primary admin-btn-announce" data-id={activeDrop.id}>Announce drop</button>)}
                            {activeStatus === 'upcoming' && (
                                    <button class="admin-btn-unannounce" data-id={activeDrop.id}>Unannounce</button>)}
                            {activeStatus !== 'closed' && (
                                    <button
                                            class="admin-btn-drop-edit"
                                            data-id={activeDrop.id}
                                            data-name={activeDrop.name}
                                            data-open={activeDrop.openTime}
                                            data-close={activeDrop.closeTime}
                                    >Edit</button>)}
                            {activeStatus === 'draft' && (
                                    <button class="admin-btn-drop-delete" data-id={activeDrop.id} data-name={activeDrop.name}>Delete</button>)}
                            {activeStatus === 'closed' && (
                                    <button class="btn-primary admin-btn-archive" data-id={activeDrop.id} data-name={activeDrop.name}>Archive &amp; finish</button>)}
                        </div>
                    </div>

                    {(activeStatus === 'upcoming' || activeStatus === 'live') && (
                            <div class="drop-detail-countdown"
                                 data-target={activeStatus === 'live' ? activeDrop.closeTime : activeDrop.openTime}>
                                <span class="drop-cd-label">{activeStatus === 'live' ? 'Closes in' : 'Opens in'}</span>
                                <span class="drop-cd-clock" id="drop-cd-clock">--:--:--</span>
                            </div>)}

                    {activeStatus === 'draft' && (
                            <div class="admin-alert admin-alert-info">
                                This drop is a private draft. Announce it to start the public countdown and reveal preview items.
                            </div>)}

                    <div class="admin-table-wrap">
                        {activeDropItems.length === 0 ? (
                                <div class="admin-empty">No items in this drop yet. Use “Edit items” to add some.</div>
                        ) : (
                                <table class="admin-table">
                                    <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Online stock</th>
                                        <th>In-person stock</th>
                                        <th>Preview</th>
                                        <th>Tag</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {activeDropItems.map(item => (
                                            <tr>
                                                <td class="admin-td-name">{item.menuItem.name}</td>
                                                <td>{item.initialStock}</td>
                                                <td>{item.inPersonStock > 0
                                                    ? item.inPersonStock
                                                    : <span class="admin-no-image">—</span>}</td>
                                                <td>{item.preview
                                                    ? <span class="drop-selected-preview">★ preview</span>
                                                    : <span class="admin-no-image">—</span>}</td>
                                                <td>{item.tag
                                                    ? <span class="admin-bs-tag">{item.tag}</span>
                                                    : <span class="admin-no-image">—</span>}</td>
                                            </tr>))}
                                    </tbody>
                                </table>)}
                    </div>
                    <div class="admin-bs-add-row">
                        <button
                                class="btn-primary admin-btn-drop-edit"
                                data-id={activeDrop.id}
                                data-name={activeDrop.name}
                                data-open={activeDrop.openTime}
                                data-close={activeDrop.closeTime}
                        >Edit items</button>
                    </div>
                </div>
        ) : (
                <div class="drop-detail-empty">
                    <div class="admin-empty">No active drop right now. Create one to start scheduling your next drop.</div>
                    <div class="admin-bs-add-row">
                        <button class="btn-primary" id="open-drop-modal">+ Create Drop</button>
                    </div>
                </div>
        )}

        <!-- Older drops -->
        <div class="drop-older-section">
            <h3 class="drop-older-title">Older drops</h3>
            <div class="admin-table-wrap">
                {olderRows.length === 0 ? (
                        <div class="admin-empty">No past drops yet.</div>
                ) : (
                        <table class="admin-table">
                            <thead>
                            <tr>
                                <th>Name</th>
                                <th>Opened</th>
                                <th>Closed</th>
                                <th>Items</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {olderRows.map(drop => (
                                    <tr data-id={drop.id}>
                                        <td class="admin-td-name">{drop.name}</td>
                                        <td class="admin-td-desc">{drop.openLabel}</td>
                                        <td class="admin-td-desc">{drop.closeLabel}</td>
                                        <td>{drop.itemCount}</td>
                                        <td class="admin-td-actions">
                                            <div class="admin-td-actions-inner">
                                                <button
                                                        class="admin-btn-drop-edit"
                                                        data-id={drop.id}
                                                        data-name={drop.name}
                                                        data-open={drop.openTime}
                                                        data-close={drop.closeTime}
                                                >View</button>
                                                <button class="admin-btn-drop-delete" data-id={drop.id} data-name={drop.name}>Delete</button>
                                            </div>
                                        </td>
                                    </tr>))}
                            </tbody>
                        </table>)}
            </div>
        </div>
    </div>

</main>

<!-- Add Modal -->
<div class="admin-modal-overlay" id="add-modal" hidden>
    <div class="admin-modal">
        <div class="admin-modal-header">
            <h2 class="admin-modal-title">Add Menu Item</h2>
            <button class="admin-modal-close" id="close-add-modal">✕</button>
        </div>
        <form class="admin-modal-form" id="add-form">
            <div class="form-field">
                <label for="add-name" id="add-name-label">Name *</label>
                <input id="add-name" name="name" type="text" placeholder="e.g. Brown Butter Chocolate Chip" required/>
            </div>
            <div class="form-field" id="add-description-field">
                <label for="add-description" id="add-description-label">Description *</label>
                <textarea id="add-description" name="description" rows="3"
                          placeholder="A brief description of the item…" required></textarea>
            </div>
            <div class="form-field">
                <label for="add-price">Price (USD) *</label>
                <input id="add-price" name="price" type="number" min="0" step="0.01" placeholder="0.00" required/>
            </div>
            <div class="form-field" id="add-image-field">
                <label for="add-image">Image</label>
                <label class="upload-label" id="add-upload-label" for="add-image">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 16 12 12 8 16"/>
                        <line x1="12" y1="12" x2="12" y2="21"/>
                        <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
                    </svg>
                    <span id="add-image-label-text">Choose file…</span>
                </label>
                <input id="add-image" name="image" type="file" accept="image/*" class="upload-input"/>
                <div id="add-image-preview" class="image-preview" hidden>
                    <img id="add-image-preview-img" src="" alt="Preview"/>
                    <button type="button" class="image-preview-remove" id="add-image-remove">✕ Remove</button>
                </div>
            </div>
            <div id="add-form-error" class="admin-alert admin-alert-error" hidden></div>
            <div class="admin-modal-actions">
                <button type="button" class="admin-btn-cancel" id="cancel-add-modal">Cancel</button>
                <button type="submit" class="btn-primary" id="add-submit-btn">Add Item</button>
                <span class="modal-spinner" id="add-spinner" hidden></span>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div class="admin-modal-overlay" id="edit-modal" hidden>
    <div class="admin-modal">
        <div class="admin-modal-header">
            <h2 class="admin-modal-title">Edit Menu Item</h2>
            <button class="admin-modal-close" id="close-edit-modal">✕</button>
        </div>
        <form class="admin-modal-form" id="edit-form">
            <input type="hidden" id="edit-id" name="id"/>
            <div class="form-field">
                <label for="edit-name" id="edit-name-label">Name *</label>
                <input id="edit-name" name="name" type="text" required/>
            </div>
            <div class="form-field" id="edit-description-field">
                <label for="edit-description" id="edit-description-label">Description *</label>
                <textarea id="edit-description" name="description" rows="3" required></textarea>
            </div>
            <div class="form-field">
                <label for="edit-price">Price (USD) *</label>
                <input id="edit-price" name="price" type="number" min="0" step="0.01" required/>
            </div>
            <div class="form-field" id="edit-image-field">
                <label for="edit-image">Image</label>
                <div id="edit-current-image-wrap" class="image-preview">
                    <img id="edit-current-image-img" src="" alt="Current image"/>
                </div>
                <label class="upload-label" for="edit-image" id="edit-upload-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 16 12 12 8 16"/>
                        <line x1="12" y1="12" x2="12" y2="21"/>
                        <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
                    </svg>
                    <span id="edit-image-label-text">Replace image…</span>
                </label>
                <input id="edit-image" name="image" type="file" accept="image/*" class="upload-input"/>
                <div id="edit-image-preview" class="image-preview" hidden>
                    <img id="edit-image-preview-img" src="" alt="Preview"/>
                    <button type="button" class="image-preview-remove" id="edit-image-remove">✕ Remove</button>
                </div>
            </div>
            <div id="edit-form-error" class="admin-alert admin-alert-error" hidden></div>
            <div class="admin-modal-actions">
                <button type="button" class="admin-btn-cancel" id="cancel-edit-modal">Cancel</button>
                <button type="submit" class="btn-primary" id="edit-submit-btn">Save Changes</button>
                <span class="modal-spinner" id="edit-spinner" hidden></span>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="admin-modal-overlay" id="delete-modal" hidden>
    <div class="admin-modal admin-modal-sm">
        <div class="admin-modal-header">
            <h2 class="admin-modal-title">Delete Item</h2>
            <button class="admin-modal-close" id="close-delete-modal">✕</button>
        </div>
        <p class="admin-delete-confirm-text" id="delete-standard-text">Are you sure you want to delete <strong id="delete-item-name"></strong>?
            This cannot be undone.</p>
        <div id="delete-checking" class="admin-field-hint" hidden>Checking for drops using this item…</div>

        <div id="delete-active-banner" class="admin-delete-active-banner" hidden>
            ⚠ One of these drops is your CURRENTLY ACTIVE drop. Deleting it will take the live drop down immediately.
        </div>

        <div id="delete-drop-warning" class="admin-delete-danger" hidden>
            <p class="admin-delete-danger-title">⚠ This will delete <span id="delete-drop-count"></span></p>
            <p class="admin-delete-danger-body">
                <strong id="delete-item-name-warn"></strong> belongs to the drop(s) below. Deleting it will
                <strong>permanently delete each of these entire drops</strong> — including every other item in them.
                This cannot be undone.
            </p>
            <ul class="admin-delete-drop-list" id="delete-drop-list"></ul>
        </div>
        <div id="delete-form-error" class="admin-alert admin-alert-error" hidden></div>
        <div class="admin-modal-actions">
            <button type="button" class="admin-btn-cancel" id="cancel-delete-modal">Cancel</button>
            <button type="button" class="admin-btn-delete-confirm" id="confirm-delete" disabled>Delete</button>
            <span class="modal-spinner" id="delete-spinner" hidden></span>
        </div>
    </div>
</div>

<!-- Create Drop Modal -->
<div class="admin-modal-overlay" id="drop-modal" hidden>
    <div class="admin-modal admin-modal-lg">
        <div class="admin-modal-loading" id="drop-modal-loading" hidden>
            <span class="modal-spinner"></span>
            <span class="admin-modal-loading-text">Loading drop…</span>
        </div>
        <div class="admin-modal-header">
            <h2 class="admin-modal-title" id="drop-modal-title">Create Drop</h2>
            <button class="admin-modal-close" id="close-drop-modal">✕</button>
        </div>
        <form class="admin-modal-form" id="drop-form">
            <input type="hidden" id="drop-id"/>
            <div class="form-field">
                <label for="drop-name">Name *</label>
                <input id="drop-name" name="name" type="text" placeholder="e.g. Drop #8" required/>
            </div>
            <div class="admin-form-row">
                <div class="form-field">
                    <label for="drop-open">Opens *</label>
                    <input id="drop-open" name="openTime" type="datetime-local" required/>
                </div>
                <div class="form-field">
                    <label for="drop-close">Closes *</label>
                    <input id="drop-close" name="closeTime" type="datetime-local" required/>
                </div>
            </div>
            <div class="form-field">
                <div class="drop-items-head">
                    <label>Pickup spots <span class="admin-field-hint">(each spot has a public area, a private exact address revealed only after payment, and a pickup time window — customers choose one at checkout)</span></label>
                    <button type="button" class="admin-btn-add-item" id="add-pickup-spot">+ Add pickup spot</button>
                </div>
                <div class="pickup-spots-list" id="pickup-spots-list"></div>
                <p class="drop-items-empty" id="pickup-spots-empty">No pickup spots yet. Add at least one so customers can choose where to pick up.</p>
            </div>
            <div class="form-field">
                <label for="drop-low-stock">Low stock alert <span class="admin-field-hint">(show "Low stock, N left" once an item's remaining online stock is at or below this — set 0 to never show remaining counts)</span></label>
                <input id="drop-low-stock" name="lowStockThreshold" type="number" min="0" step="1" value="0"/>
            </div>
            <div class="form-field">
                <div class="drop-items-head">
                    <label>Items <span class="admin-field-hint">(menu items in this drop — tick "preview" to show one as a sneak peek before opening)</span></label>
                    <button type="button" class="admin-btn-add-item" id="open-drop-item-modal" disabled={items.length === 0}>+ Add item</button>
                </div>
                {items.length === 0 && (
                    <p class="admin-field-hint">No menu items exist yet. Add menu items first.</p>
                )}
                <div class="drop-items-selected" id="drop-items-selected"></div>
                <p class="drop-items-empty" id="drop-items-empty">No items added yet.</p>
            </div>
            <div id="drop-form-error" class="admin-alert admin-alert-error" hidden></div>
            <div class="admin-modal-actions">
                <button type="button" class="admin-btn-cancel" id="cancel-drop-modal">Cancel</button>
                <button type="submit" class="btn-primary" id="drop-submit-btn">Create Drop</button>
                <span class="modal-spinner" id="drop-spinner" hidden></span>
            </div>
        </form>
    </div>
</div>

<!-- Add Drop Item Picker Modal -->
<div class="admin-modal-overlay admin-modal-overlay-top" id="drop-item-modal" hidden>
    <div class="admin-modal admin-modal-sm">
        <div class="admin-modal-header">
            <h2 class="admin-modal-title" id="drop-item-modal-title">Add Item to Drop</h2>
            <button class="admin-modal-close" id="close-drop-item-modal">✕</button>
        </div>
        <div class="admin-modal-form">
            <div class="form-field">
                <label for="drop-item-select">Menu Item *</label>
                <select id="drop-item-select">
                    <option value="">— Select an item —</option>
                    {items.map(item => (
                        <option value={item.id} data-name={item.name}>
                            {item.name}
                        </option>
                    ))}
                </select>
            </div>
            <div class="admin-form-row">
                <div class="form-field">
                    <label for="drop-item-stock-input">Online stock *</label>
                    <input id="drop-item-stock-input" type="number" min="0" step="1" value="1"/>
                </div>
                <div class="form-field">
                    <label for="drop-item-inperson-input">In-person stock</label>
                    <input id="drop-item-inperson-input" type="number" min="0" step="1" value="0"/>
                </div>
            </div>
            <p class="admin-field-hint">Online stock sells on the website; in-person stock is a separate pool you sell and track by hand.</p>
            <div class="form-field">
                <label for="drop-item-tag-input">Tag <span class="admin-field-hint">(optional label, e.g. "Fan Favorite")</span></label>
                <input id="drop-item-tag-input" type="text" placeholder="e.g. Fan Favorite"/>
            </div>
            <div class="form-field admin-checkbox-field" id="drop-item-preview-field">
                <label class="admin-checkbox-label">
                    <input id="drop-item-preview-input" type="checkbox"/>
                    <span>Show as preview before the drop opens</span>
                </label>
                <p class="admin-field-hint drop-pastopen-note" id="drop-item-preview-pastnote" hidden>Past opening time — orders are already open, so previews no longer apply.</p>
            </div>
            <div id="drop-item-error" class="admin-alert admin-alert-error" hidden></div>
            <div class="admin-modal-actions">
                <button type="button" class="admin-btn-cancel" id="cancel-drop-item-modal">Cancel</button>
                <button type="button" class="btn-primary" id="confirm-drop-item">Add</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Drop Confirm Modal -->
<div class="admin-modal-overlay" id="drop-delete-modal" hidden>
    <div class="admin-modal admin-modal-sm">
        <div class="admin-modal-header">
            <h2 class="admin-modal-title">Delete Drop</h2>
            <button class="admin-modal-close" id="close-drop-delete-modal">✕</button>
        </div>
        <p class="admin-delete-confirm-text">Are you sure you want to delete <strong id="drop-delete-name"></strong>?
            This also removes its items and cannot be undone.</p>
        <div id="drop-delete-error" class="admin-alert admin-alert-error" hidden></div>
        <div class="admin-modal-actions">
            <button type="button" class="admin-btn-cancel" id="cancel-drop-delete-modal">Cancel</button>
            <button type="button" class="admin-btn-delete-confirm" id="confirm-drop-delete">Delete</button>
            <span class="modal-spinner" id="drop-delete-spinner" hidden></span>
        </div>
    </div>
</div>

<script>
    // ── Modal helpers ──────────────────────────────────────────
    function openModal(id: string) {
        const el = document.getElementById(id);
        if (el) {
            el.hidden = false;
            document.body.style.overflow = 'hidden';
        }
    }

    function closeModal(id: string) {
        const el = document.getElementById(id);
        if (el) {
            el.hidden = true;
            document.body.style.overflow = '';
        }
    }

    function showError(id: string, msg: string) {
        const el = document.getElementById(id);
        if (el) {
            el.textContent = msg;
            el.hidden = false;
        }
    }

    function clearError(id: string) {
        const el = document.getElementById(id);
        if (el) {
            el.hidden = true;
            el.textContent = '';
        }
    }

    // Close on overlay click — but only when the press *started* on the overlay
    // itself. Otherwise a text selection that begins inside the modal and is
    // released over the overlay (a drag-out) would wrongly close the modal.
    ['add-modal', 'edit-modal', 'delete-modal', 'drop-modal', 'drop-delete-modal'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        let pressedOnOverlay = false;
        el.addEventListener('mousedown', (e) => {
            pressedOnOverlay = e.target === e.currentTarget;
        });
        el.addEventListener('click', (e) => {
            if (e.target === e.currentTarget && pressedOnOverlay) closeModal(id);
            pressedOnOverlay = false;
        });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        // Close the topmost (drop item picker) first if it's open, without closing its parent.
        const picker = document.getElementById('drop-item-modal');
        if (picker && !picker.hidden) {
            picker.hidden = true;
            return;
        }
        ['add-modal', 'edit-modal', 'delete-modal', 'drop-modal', 'drop-delete-modal'].forEach(id => {
            const el = document.getElementById(id);
            if (el && !el.hidden) closeModal(id);
        });
    });

    // ── Tabs ───────────────────────────────────────────────────
    const tabs = document.querySelectorAll<HTMLButtonElement>('.admin-tab');
    const addItemBtn = document.getElementById('open-add-modal') as HTMLButtonElement;
    const pageTitle = document.getElementById('page-title');
    const pageSub = document.getElementById('page-sub');
    const tabBar = document.querySelector<HTMLElement>('.admin-tabs');
    const totalItems = parseInt(tabBar?.dataset.itemsTotal ?? '0', 10);

    const ACTIVE_TAB_KEY = 'admin-active-tab';

    function activateTab(target: string | undefined) {
        if (!target) return;
        tabs.forEach(t => t.classList.toggle('admin-tab-active', t.dataset.tab === target));
        document.getElementById('tab-menu-items')!.hidden = target !== 'menu-items';
        document.getElementById('tab-drops')!.hidden = target !== 'drops';
        if (target === 'menu-items') {
            if (pageTitle) pageTitle.textContent = 'Menu Items';
            if (pageSub) pageSub.textContent = `${totalItems} total item${totalItems !== 1 ? 's' : ''}`;
            addItemBtn.hidden = false;
        } else {
            if (pageTitle) pageTitle.textContent = 'Drops';
            if (pageSub) pageSub.textContent = 'Biweekly order windows';
            addItemBtn.hidden = true;
        }
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const target = tab.dataset.tab;
            try { sessionStorage.setItem(ACTIVE_TAB_KEY, target ?? ''); } catch {}
            activateTab(target);
        });
    });

    // Restore the last-active tab after a reload (drop actions reload the page).
    try {
        const saved = sessionStorage.getItem(ACTIVE_TAB_KEY);
        if (saved && ['drops'].includes(saved)) activateTab(saved);
    } catch {}

    // ── File → base64 helper ───────────────────────────────────
    function readFileAsDataURL(file: File): Promise<string> {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result as string);
            reader.onerror = reject;
            reader.readAsDataURL(file);
        });
    }

    // ── Client-side image compression ──────────────────────────
    // Vercel functions reject request bodies > 4.5 MB (FUNCTION_PAYLOAD_TOO_LARGE),
    // so downscale + re-encode to WebP in the browser before uploading.
    async function compressImage(file: File, maxDimension = 1600, quality = 0.82): Promise<File> {
        if (!file.type.startsWith('image/')) return file;

        const dataUrl = await readFileAsDataURL(file);
        const img = await new Promise<HTMLImageElement>((resolve, reject) => {
            const el = new Image();
            el.onload = () => resolve(el);
            el.onerror = reject;
            el.src = dataUrl;
        });

        const scale = Math.min(1, maxDimension / Math.max(img.width, img.height));
        const width = Math.round(img.width * scale);
        const height = Math.round(img.height * scale);

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        if (!ctx) return file;
        ctx.drawImage(img, 0, 0, width, height);

        const blob = await new Promise<Blob | null>((resolve) =>
            canvas.toBlob(resolve, 'image/webp', quality)
        );
        if (!blob) return file;

        return new File([blob], file.name.replace(/\.[^.]+$/, '') + '.webp', {type: 'image/webp'});
    }

    function resetUploadField(inputId: string, labelTextId: string, previewId: string, previewImgId: string) {
        const input = document.getElementById(inputId) as HTMLInputElement;
        if (input) input.value = '';
        const labelText = document.getElementById(labelTextId);
        if (labelText) labelText.textContent = 'Choose file…';
        const preview = document.getElementById(previewId);
        if (preview) preview.hidden = true;
        const previewImg = document.getElementById(previewImgId) as HTMLImageElement;
        if (previewImg) previewImg.src = '';
    }

    function wireUploadInput(inputId: string, labelId: string, labelTextId: string, previewId: string, previewImgId: string, removeId: string) {
        const input = document.getElementById(inputId) as HTMLInputElement;
        const label = document.getElementById(labelId) as HTMLLabelElement;

        function applyFile(file: File) {
            const labelText = document.getElementById(labelTextId);
            if (labelText) labelText.textContent = file.name;
            readFileAsDataURL(file).then(dataUrl => {
                const previewImg = document.getElementById(previewImgId) as HTMLImageElement;
                if (previewImg) previewImg.src = dataUrl;
                const preview = document.getElementById(previewId);
                if (preview) preview.hidden = false;
            });
        }

        input?.addEventListener('change', () => {
            const file = input.files?.[0];
            if (file) applyFile(file);
        });

        // Drag-and-drop
        label?.addEventListener('dragover', (e) => {
            e.preventDefault();
            label.classList.add('upload-label-dragover');
        });
        label?.addEventListener('dragleave', () => {
            label.classList.remove('upload-label-dragover');
        });
        label?.addEventListener('drop', (e) => {
            e.preventDefault();
            label.classList.remove('upload-label-dragover');
            const file = e.dataTransfer?.files?.[0];
            if (!file) return;
            // Inject into the input so existing form logic picks it up
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            applyFile(file);
        });

        document.getElementById(removeId)?.addEventListener('click', () => {
            resetUploadField(inputId, labelTextId, previewId, previewImgId);
        });
    }

    wireUploadInput('add-image', 'add-upload-label', 'add-image-label-text', 'add-image-preview', 'add-image-preview-img', 'add-image-remove');
    wireUploadInput('edit-image', 'edit-upload-label', 'edit-image-label-text', 'edit-image-preview', 'edit-image-preview-img', 'edit-image-remove');

    // ── Add modal ──────────────────────────────────────────────
    document.getElementById('open-add-modal')?.addEventListener('click', () => {
        (document.getElementById('add-form') as HTMLFormElement)?.reset();
        resetUploadField('add-image', 'add-image-label-text', 'add-image-preview', 'add-image-preview-img');
        clearError('add-form-error');
        openModal('add-modal');
    });
    document.getElementById('close-add-modal')?.addEventListener('click', () => closeModal('add-modal'));
    document.getElementById('cancel-add-modal')?.addEventListener('click', () => closeModal('add-modal'));

    document.getElementById('add-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError('add-form-error');
        const form = e.target as HTMLFormElement;
        const data = Object.fromEntries(new FormData(form));
        const submitBtn = document.getElementById('add-submit-btn') as HTMLButtonElement;
        const spinner = document.getElementById('add-spinner') as HTMLElement;
        submitBtn.disabled = true;
        spinner.hidden = false;

        // Upload image first to get the UUID that will also be the DB row id
        const imageFile = (document.getElementById('add-image') as HTMLInputElement).files?.[0];
        if (!imageFile) {
            showError('add-form-error', 'An image is required.');
            submitBtn.disabled = false;
            spinner.hidden = true;
            return;
        }
        const uploadForm = new FormData();
        uploadForm.append('file', await compressImage(imageFile));
        const uploadRes = await fetch('/api/v1/upload', {method: 'POST', body: uploadForm});
        if (!uploadRes.ok) {
            const err = await uploadRes.json();
            showError('add-form-error', err.error ?? 'Image upload failed.');
            submitBtn.disabled = false;
            spinner.hidden = true;
            return;
        }
        const {id: uuid} = await uploadRes.json();

        const payload = {
            id: uuid,
            name: data.name,
            description: data.description,
            price: Number(data.price) || 0,
        };

        const res = await fetch('/api/v1/menu', {
            method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload),
        });

        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('add-form-error', err.error ?? 'Something went wrong.');
            submitBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Edit modal ─────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.admin-btn-edit').forEach(btn => {
        btn.addEventListener('click', () => {
            const {id, name, description, price, image} = btn.dataset;
            (document.getElementById('edit-id') as HTMLInputElement).value = id ?? '';
            (document.getElementById('edit-name') as HTMLInputElement).value = name ?? '';
            (document.getElementById('edit-description') as HTMLTextAreaElement).value = description ?? '';
            (document.getElementById('edit-price') as HTMLInputElement).value = price ?? '0';

            // Always show the current image (url = storageUrl + id)
            const currentImg = document.getElementById('edit-current-image-img') as HTMLImageElement;
            if (currentImg) currentImg.src = image ?? '';

            // Reset the file upload field
            resetUploadField('edit-image', 'edit-image-label-text', 'edit-image-preview', 'edit-image-preview-img');

            clearError('edit-form-error');
            openModal('edit-modal');
        });
    });

    document.getElementById('close-edit-modal')?.addEventListener('click', () => closeModal('edit-modal'));
    document.getElementById('cancel-edit-modal')?.addEventListener('click', () => closeModal('edit-modal'));

    document.getElementById('edit-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError('edit-form-error');
        const form = e.target as HTMLFormElement;
        const data = Object.fromEntries(new FormData(form));
        const id = (document.getElementById('edit-id') as HTMLInputElement).value;
        const submitBtn = document.getElementById('edit-submit-btn') as HTMLButtonElement;
        const spinner = document.getElementById('edit-spinner') as HTMLElement;
        submitBtn.disabled = true;
        spinner.hidden = false;

        // If a new image file was selected, re-upload to storage using the item's id (upsert)
        const imageFile = (document.getElementById('edit-image') as HTMLInputElement).files?.[0];
        if (imageFile) {
            const uploadForm = new FormData();
            uploadForm.append('file', await compressImage(imageFile));
            uploadForm.append('id', id);
            const uploadRes = await fetch('/api/v1/upload', {method: 'POST', body: uploadForm});
            if (!uploadRes.ok) {
                const err = await uploadRes.json();
                showError('edit-form-error', err.error ?? 'Image upload failed.');
                submitBtn.disabled = false;
                spinner.hidden = true;
                return;
            }
        }

        const payload = {
            name: data.name, description: data.description, price: Number(data.price) || 0,
        };

        const res = await fetch(`/api/v1/menu/${id}`, {
            method: 'PATCH', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload),
        });

        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('edit-form-error', err.error ?? 'Something went wrong.');
            submitBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Delete modal ───────────────────────────────────────────
    let pendingDeleteId: string | null = null;
    let pendingDeleteForce = false;

    document.querySelectorAll<HTMLButtonElement>('.admin-btn-delete').forEach(btn => {
        btn.addEventListener('click', async () => {
            pendingDeleteId = btn.dataset.id ?? null;
            pendingDeleteForce = false;
            const row = btn.closest('tr');
            const name = row?.querySelector('.admin-td-name')?.textContent ?? 'this item';

            const nameEl = document.getElementById('delete-item-name');
            if (nameEl) nameEl.textContent = name;

            const standardText = document.getElementById('delete-standard-text') as HTMLElement;
            const checking = document.getElementById('delete-checking') as HTMLElement;
            const warning = document.getElementById('delete-drop-warning') as HTMLElement;
            const activeBanner = document.getElementById('delete-active-banner') as HTMLElement;
            const confirmBtn = document.getElementById('confirm-delete') as HTMLButtonElement;

            clearError('delete-form-error');
            // Reset to a "checking" state while we look up drop usage.
            standardText.hidden = true;
            warning.hidden = true;
            activeBanner.hidden = true;
            checking.hidden = false;
            confirmBtn.disabled = true;
            confirmBtn.textContent = 'Delete';
            confirmBtn.classList.remove('admin-btn-delete-confirm-active');
            openModal('delete-modal');

            if (!pendingDeleteId) return;

            try {
                const res = await fetch(`/api/v1/menu/${pendingDeleteId}`);
                const data = await res.json();
                const drops: {id: string; name: string; isCurrent?: boolean}[] = data.drops ?? [];
                checking.hidden = true;

                if (drops.length > 0) {
                    pendingDeleteForce = true;
                    const hasActive = drops.some(d => d.isCurrent);
                    const count = `${drops.length} drop${drops.length !== 1 ? 's' : ''}`;
                    (document.getElementById('delete-item-name-warn') as HTMLElement).textContent = name;
                    (document.getElementById('delete-drop-count') as HTMLElement).textContent = count;
                    const list = document.getElementById('delete-drop-list') as HTMLElement;
                    list.innerHTML = '';
                    drops.forEach(d => {
                        const li = document.createElement('li');
                        const nameSpan = document.createElement('span');
                        nameSpan.className = 'admin-delete-drop-name';
                        nameSpan.textContent = d.name;
                        li.appendChild(nameSpan);
                        if (d.isCurrent) {
                            li.classList.add('admin-delete-drop-active');
                            const badge = document.createElement('span');
                            badge.className = 'admin-delete-active-tag';
                            badge.textContent = 'ACTIVE';
                            li.appendChild(badge);
                        }
                        list.appendChild(li);
                    });
                    warning.hidden = false;
                    activeBanner.hidden = !hasActive;
                    confirmBtn.textContent = hasActive ? 'Delete ACTIVE drop & item' : 'Delete item & drops';
                    if (hasActive) confirmBtn.classList.add('admin-btn-delete-confirm-active');
                } else {
                    standardText.hidden = false;
                }
                confirmBtn.disabled = false;
            } catch {
                checking.hidden = true;
                standardText.hidden = false;
                confirmBtn.disabled = false;
            }
        });
    });
    document.getElementById('close-delete-modal')?.addEventListener('click', () => closeModal('delete-modal'));
    document.getElementById('cancel-delete-modal')?.addEventListener('click', () => closeModal('delete-modal'));

    document.getElementById('confirm-delete')?.addEventListener('click', async () => {
        if (!pendingDeleteId) return;
        clearError('delete-form-error');
        const confirmBtn = document.getElementById('confirm-delete') as HTMLButtonElement;
        const spinner = document.getElementById('delete-spinner') as HTMLElement;
        confirmBtn.disabled = true;
        spinner.hidden = false;
        const url = `/api/v1/menu/${pendingDeleteId}${pendingDeleteForce ? '?force=true' : ''}`;
        const res = await fetch(url, {method: 'DELETE'});
        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('delete-form-error', err.error ?? 'Could not delete item.');
            confirmBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Create Drop modal ──────────────────────────────────────
    const dropItemsContainer = document.getElementById('drop-items-selected');
    const dropItemsEmpty = document.getElementById('drop-items-empty');
    const dropItemSelect = document.getElementById('drop-item-select') as HTMLSelectElement | null;
    const dropItemStockInput = document.getElementById('drop-item-stock-input') as HTMLInputElement | null;
    const dropItemInPersonInput = document.getElementById('drop-item-inperson-input') as HTMLInputElement | null;
    const dropItemTagInput = document.getElementById('drop-item-tag-input') as HTMLInputElement | null;
    const dropItemPreviewInput = document.getElementById('drop-item-preview-input') as HTMLInputElement | null;

    function selectedDropItemIds(): Set<string> {
        return new Set(
            Array.from(dropItemsContainer?.querySelectorAll<HTMLElement>('.drop-selected-row') ?? [])
                .map(row => row.dataset.id as string),
        );
    }

    function refreshDropItemsEmpty() {
        const hasRows = (dropItemsContainer?.querySelectorAll('.drop-selected-row').length ?? 0) > 0;
        if (dropItemsEmpty) dropItemsEmpty.hidden = hasRows;
    }

    function refreshDropItemSelectOptions() {
        if (!dropItemSelect) return;
        const used = selectedDropItemIds();
        Array.from(dropItemSelect.options).forEach(opt => {
            if (!opt.value) return;
            opt.disabled = used.has(opt.value);
        });
        dropItemSelect.value = '';
    }

    // The row currently being edited via the picker modal (null = adding a new one).
    let editingDropRow: HTMLElement | null = null;
    const dropItemModalTitle = document.getElementById('drop-item-modal-title');
    const confirmDropItemBtn = document.getElementById('confirm-drop-item');

    function fillDropRow(row: HTMLElement, name: string, stock: number, preview: boolean, tag: string, inPerson: number) {
        row.dataset.stock = String(stock);
        row.dataset.inperson = String(inPerson);
        row.dataset.preview = preview ? 'true' : 'false';
        row.dataset.tag = tag;
        const nameEl = row.querySelector('.drop-selected-name') as HTMLElement;
        nameEl.textContent = name;
        const stockEl = row.querySelector('.drop-selected-stock') as HTMLElement;
        stockEl.textContent = inPerson > 0 ? `${stock} online · ${inPerson} in-person` : `${stock} online`;
        const tagEl = row.querySelector('.drop-selected-tag') as HTMLElement;
        tagEl.textContent = tag;
        tagEl.hidden = !tag;
        const previewEl = row.querySelector('.drop-selected-preview') as HTMLElement;
        previewEl.hidden = !preview;
    }

    function addSelectedDropItem(id: string, name: string, stock: number, preview = false, tag = '', inPerson = 0) {
        if (!dropItemsContainer) return;
        const row = document.createElement('div');
        row.className = 'drop-selected-row';
        row.dataset.id = id;
        row.innerHTML = `
            <span class="drop-selected-name"></span>
            <div class="drop-selected-right">
                <span class="drop-selected-tag"></span>
                <span class="drop-selected-preview" title="Shown as a preview before the drop opens">★ preview</span>
                <span class="drop-selected-stock"></span>
                <button type="button" class="drop-selected-edit" title="Edit">Edit</button>
                <button type="button" class="drop-selected-remove" title="Remove">Remove</button>
            </div>`;
        fillDropRow(row, name, stock, preview, tag, inPerson);
        row.querySelector('.drop-selected-edit')?.addEventListener('click', () => openDropItemEdit(row));
        row.querySelector('.drop-selected-remove')?.addEventListener('click', () => {
            row.remove();
            refreshDropItemsEmpty();
        });
        dropItemsContainer.appendChild(row);
        refreshDropItemsEmpty();
    }

    function closeDropItemModal() {
        const el = document.getElementById('drop-item-modal');
        if (el) el.hidden = true;
        editingDropRow = null;
        if (dropItemSelect) dropItemSelect.disabled = false;
    }

    document.getElementById('open-drop-item-modal')?.addEventListener('click', () => {
        editingDropRow = null;
        clearError('drop-item-error');
        if (dropItemSelect) dropItemSelect.disabled = false;
        refreshDropItemSelectOptions();
        updatePreOpenVisibility();
        if (dropItemStockInput) dropItemStockInput.value = '1';
        if (dropItemInPersonInput) dropItemInPersonInput.value = '0';
        if (dropItemTagInput) dropItemTagInput.value = '';
        if (dropItemPreviewInput) dropItemPreviewInput.checked = false;
        if (dropItemModalTitle) dropItemModalTitle.textContent = 'Add Item to Drop';
        if (confirmDropItemBtn) confirmDropItemBtn.textContent = 'Add';
        const el = document.getElementById('drop-item-modal');
        if (el) el.hidden = false;
        dropItemSelect?.focus();
    });

    function openDropItemEdit(row: HTMLElement) {
        editingDropRow = row;
        clearError('drop-item-error');
        // The item itself is fixed while editing — lock the select to it.
        if (dropItemSelect) {
            Array.from(dropItemSelect.options).forEach(o => { o.disabled = false; });
            dropItemSelect.value = row.dataset.id ?? '';
            dropItemSelect.disabled = true;
        }
        if (dropItemStockInput) dropItemStockInput.value = row.dataset.stock ?? '1';
        if (dropItemInPersonInput) dropItemInPersonInput.value = row.dataset.inperson ?? '0';
        if (dropItemTagInput) dropItemTagInput.value = row.dataset.tag ?? '';
        if (dropItemPreviewInput) dropItemPreviewInput.checked = row.dataset.preview === 'true';
        updatePreOpenVisibility();
        if (dropItemModalTitle) dropItemModalTitle.textContent = 'Edit Item';
        if (confirmDropItemBtn) confirmDropItemBtn.textContent = 'Save';
        const el = document.getElementById('drop-item-modal');
        if (el) el.hidden = false;
    }

    document.getElementById('close-drop-item-modal')?.addEventListener('click', closeDropItemModal);
    document.getElementById('cancel-drop-item-modal')?.addEventListener('click', closeDropItemModal);
    const dropItemOverlay = document.getElementById('drop-item-modal');
    if (dropItemOverlay) {
        let pressedOnOverlay = false;
        dropItemOverlay.addEventListener('mousedown', (e) => {
            pressedOnOverlay = e.target === e.currentTarget;
        });
        dropItemOverlay.addEventListener('click', (e) => {
            if (e.target === e.currentTarget && pressedOnOverlay) closeDropItemModal();
            pressedOnOverlay = false;
        });
    }

    document.getElementById('confirm-drop-item')?.addEventListener('click', () => {
        clearError('drop-item-error');
        const opt = dropItemSelect?.selectedOptions[0];
        if (!opt || !opt.value) {
            showError('drop-item-error', 'Please select a menu item.');
            return;
        }
        const stock = Number(dropItemStockInput?.value);
        if (!Number.isInteger(stock) || stock < 0) {
            showError('drop-item-error', 'Online stock must be a non-negative whole number.');
            return;
        }
        const inPerson = Number(dropItemInPersonInput?.value);
        if (!Number.isInteger(inPerson) || inPerson < 0) {
            showError('drop-item-error', 'In-person stock must be a non-negative whole number.');
            return;
        }
        const preview = dropItemPreviewInput?.checked ?? false;
        const tag = dropItemTagInput?.value.trim() ?? '';

        if (editingDropRow) {
            fillDropRow(editingDropRow, opt.dataset.name ?? opt.textContent ?? '', stock, preview, tag, inPerson);
        } else {
            addSelectedDropItem(opt.value, opt.dataset.name ?? opt.textContent ?? '', stock, preview, tag, inPerson);
        }
        closeDropItemModal();
    });

    const dropIdField = document.getElementById('drop-id') as HTMLInputElement | null;
    const dropModalTitle = document.getElementById('drop-modal-title');
    const dropSubmitBtn = document.getElementById('drop-submit-btn');
    const dropOpenInput = document.getElementById('drop-open') as HTMLInputElement | null;
    const dropItemPreviewField = document.getElementById('drop-item-preview-field');

    // The per-item preview only applies before a drop opens.
    // Once the open time has passed the drop is live, so hide that control.
    function dropOpenIsPast(): boolean {
        const v = dropOpenInput?.value;
        if (!v) return false;
        const t = new Date(localInputToISO(v)).getTime();
        return !Number.isNaN(t) && t <= Date.now();
    }

    function updatePreOpenVisibility() {
        const past = dropOpenIsPast();
        if (dropItemPreviewInput) dropItemPreviewInput.disabled = past;
        if (dropItemPreviewField) dropItemPreviewField.classList.toggle('admin-field-disabled', past);
        const pvNote = document.getElementById('drop-item-preview-pastnote');
        if (pvNote) pvNote.hidden = !past;
    }

    dropOpenInput?.addEventListener('input', updatePreOpenVisibility);

    // The business operates in Pacific time. datetime-local inputs are bare
    // wall-clock strings with no zone, so we explicitly interpret/display them in
    // this zone — otherwise the server (UTC on Vercel) would parse them in its
    // own zone and the time would drift.
    const DROP_TZ = 'America/Los_Angeles';

    // How far the given instant's DROP_TZ wall-clock is ahead of UTC, in ms
    // (e.g. -7h during PDT). Used to convert between wall-clock and UTC.
    function tzOffsetMs(date: Date): number {
        const dtf = new Intl.DateTimeFormat('en-US', {
            timeZone: DROP_TZ, hourCycle: 'h23',
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit', second: '2-digit',
        });
        const m: Record<string, string> = {};
        for (const p of dtf.formatToParts(date)) m[p.type] = p.value;
        const asUTC = Date.UTC(
            Number(m.year), Number(m.month) - 1, Number(m.day),
            Number(m.hour), Number(m.minute), Number(m.second),
        );
        return asUTC - date.getTime();
    }

    // Wall-clock datetime-local value (interpreted as Pacific) → UTC ISO string.
    function localInputToISO(value: string): string {
        const [datePart, timePart] = value.split('T');
        const [y, mo, d] = datePart.split('-').map(Number);
        const [h, mi] = (timePart ?? '00:00').split(':').map(Number);
        const guessUTC = Date.UTC(y, mo - 1, d, h, mi);
        // Offset near the target instant (using the guess is accurate except in
        // the rare hour straddling a DST transition).
        const offset = tzOffsetMs(new Date(guessUTC));
        return new Date(guessUTC - offset).toISOString();
    }

    // UTC ISO string → wall-clock datetime-local value in Pacific.
    function isoToLocalInput(iso: string): string {
        const d = new Date(iso);
        const dtf = new Intl.DateTimeFormat('en-US', {
            timeZone: DROP_TZ, hourCycle: 'h23',
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit',
        });
        const m: Record<string, string> = {};
        for (const p of dtf.formatToParts(d)) m[p.type] = p.value;
        return `${m.year}-${m.month}-${m.day}T${m.hour}:${m.minute}`;
    }

    // ── Pickup spots (repeatable rows in the drop modal) ───────
    const pickupSpotsList = document.getElementById('pickup-spots-list');
    const pickupSpotsEmpty = document.getElementById('pickup-spots-empty');

    function refreshPickupSpotsEmpty() {
        const hasRows = (pickupSpotsList?.querySelectorAll('.pickup-spot-row').length ?? 0) > 0;
        if (pickupSpotsEmpty) pickupSpotsEmpty.hidden = hasRows;
    }

    interface PickupSpotSeed {
        locationName?: string;
        locationAddress?: string;
        pickupStart?: string;
        pickupEnd?: string;
    }

    function addPickupSpotRow(spot: PickupSpotSeed = {}) {
        if (!pickupSpotsList) return;
        const row = document.createElement('div');
        row.className = 'pickup-spot-row';
        row.innerHTML = `
            <div class="pickup-spot-row-fields">
                <div class="form-field">
                    <label>Pickup area <span class="admin-field-hint">(public, e.g. "Downtown Davis")</span></label>
                    <input type="text" class="pickup-spot-name" placeholder="e.g. Downtown Davis" />
                </div>
                <div class="form-field">
                    <label>Exact address <span class="admin-field-hint">(private — revealed only after payment)</span></label>
                    <textarea class="pickup-spot-address" rows="2" placeholder="e.g. 123 Main St, Davis, CA 95616"></textarea>
                </div>
                <div class="admin-form-row">
                    <div class="form-field">
                        <label>Window start</label>
                        <input type="datetime-local" class="pickup-spot-start" />
                    </div>
                    <div class="form-field">
                        <label>Window end</label>
                        <input type="datetime-local" class="pickup-spot-end" />
                    </div>
                </div>
            </div>
            <button type="button" class="pickup-spot-remove" title="Remove spot">Remove</button>`;
        (row.querySelector('.pickup-spot-name') as HTMLInputElement).value = spot.locationName ?? '';
        (row.querySelector('.pickup-spot-address') as HTMLTextAreaElement).value = spot.locationAddress ?? '';
        (row.querySelector('.pickup-spot-start') as HTMLInputElement).value = spot.pickupStart ? isoToLocalInput(spot.pickupStart) : '';
        (row.querySelector('.pickup-spot-end') as HTMLInputElement).value = spot.pickupEnd ? isoToLocalInput(spot.pickupEnd) : '';
        row.querySelector('.pickup-spot-remove')?.addEventListener('click', () => {
            row.remove();
            refreshPickupSpotsEmpty();
        });
        pickupSpotsList.appendChild(row);
        refreshPickupSpotsEmpty();
    }

    document.getElementById('add-pickup-spot')?.addEventListener('click', () => addPickupSpotRow());

    // Reads the current spot rows into the API payload shape, converting the
    // Pacific wall-clock inputs to UTC ISO. Returns an { error } string on the
    // first invalid row so the caller can surface it and stop the submit.
    function collectPickupSpots(): { spots: Array<{ locationName: string; locationAddress: string; pickupStart: string; pickupEnd: string }> } | { error: string } {
        const rows = Array.from(pickupSpotsList?.querySelectorAll<HTMLElement>('.pickup-spot-row') ?? []);
        const spots = [];
        for (const row of rows) {
            const name = (row.querySelector('.pickup-spot-name') as HTMLInputElement).value.trim();
            const address = (row.querySelector('.pickup-spot-address') as HTMLTextAreaElement).value.trim();
            const startVal = (row.querySelector('.pickup-spot-start') as HTMLInputElement).value;
            const endVal = (row.querySelector('.pickup-spot-end') as HTMLInputElement).value;
            if (!name) return { error: 'Each pickup spot needs a pickup area.' };
            if (!startVal || !endVal) return { error: `Pickup spot "${name}" needs a start and end time.` };
            const startISO = localInputToISO(startVal);
            const endISO = localInputToISO(endVal);
            if (new Date(endISO) < new Date(startISO)) {
                return { error: `Pickup spot "${name}" ends before it starts.` };
            }
            spots.push({ locationName: name, locationAddress: address, pickupStart: startISO, pickupEnd: endISO });
        }
        return { spots };
    }

    document.getElementById('open-drop-modal')?.addEventListener('click', () => {
        (document.getElementById('drop-form') as HTMLFormElement)?.reset();
        if (dropIdField) dropIdField.value = '';
        if (dropModalTitle) dropModalTitle.textContent = 'Create Drop';
        if (dropSubmitBtn) dropSubmitBtn.textContent = 'Create Drop';
        if (dropItemsContainer) dropItemsContainer.innerHTML = '';
        if (pickupSpotsList) pickupSpotsList.innerHTML = '';
        refreshPickupSpotsEmpty();
        refreshDropItemsEmpty();
        updatePreOpenVisibility();
        clearError('drop-form-error');
        openModal('drop-modal');
    });
    document.getElementById('close-drop-modal')?.addEventListener('click', () => closeModal('drop-modal'));
    document.getElementById('cancel-drop-modal')?.addEventListener('click', () => closeModal('drop-modal'));

    document.querySelectorAll<HTMLButtonElement>('.admin-btn-drop-edit').forEach(btn => {
        btn.addEventListener('click', async () => {
            const {id, name, open, close} = btn.dataset;
            (document.getElementById('drop-form') as HTMLFormElement)?.reset();
            if (dropIdField) dropIdField.value = id ?? '';
            if (dropModalTitle) dropModalTitle.textContent = 'Edit Drop';
            if (dropSubmitBtn) dropSubmitBtn.textContent = 'Save Changes';
            (document.getElementById('drop-name') as HTMLInputElement).value = name ?? '';
            (document.getElementById('drop-open') as HTMLInputElement).value = open ? isoToLocalInput(open) : '';
            (document.getElementById('drop-close') as HTMLInputElement).value = close ? isoToLocalInput(close) : '';
            if (dropItemsContainer) dropItemsContainer.innerHTML = '';
            if (pickupSpotsList) pickupSpotsList.innerHTML = '';
            refreshPickupSpotsEmpty();
            refreshDropItemsEmpty();
            updatePreOpenVisibility();
            clearError('drop-form-error');
            openModal('drop-modal');

            const dropLoading = document.getElementById('drop-modal-loading');
            if (dropLoading) dropLoading.hidden = false;

            try {
                const res = await fetch(`/api/v1/drops/${id}`);
                if (res.ok) {
                    const {drop, items, pickupSpots} = await res.json();
                    if (drop) {
                        (document.getElementById('drop-low-stock') as HTMLInputElement).value = String(drop.lowStockThreshold ?? 0);
                    }
                    (pickupSpots ?? []).forEach((sp: PickupSpotSeed) => addPickupSpotRow(sp));
                    refreshPickupSpotsEmpty();
                    (items ?? []).forEach((it: {menuItem: {id: string; name: string}; initialStock: number; inPersonStock?: number; preview: boolean; tag: string}) => {
                        addSelectedDropItem(it.menuItem.id, it.menuItem.name, it.initialStock, it.preview, it.tag, it.inPersonStock ?? 0);
                    });
                } else {
                    showError('drop-form-error', 'Could not load this drop\u2019s items.');
                }
            } catch {
                showError('drop-form-error', 'Could not load this drop\u2019s items.');
            } finally {
                if (dropLoading) dropLoading.hidden = true;
            }
        });
    });

    document.getElementById('drop-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError('drop-form-error');
        const form = e.target as HTMLFormElement;
        const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
        const submitBtn = document.getElementById('drop-submit-btn') as HTMLButtonElement;
        const spinner = document.getElementById('drop-spinner') as HTMLElement;
        const id = dropIdField?.value ?? '';

        // Convert the Pacific wall-clock inputs to unambiguous UTC ISO strings so
        // the server stores the intended instant regardless of its own timezone.
        const openISO = data.openTime ? localInputToISO(data.openTime) : '';
        const closeISO = data.closeTime ? localInputToISO(data.closeTime) : '';

        if (openISO && closeISO && new Date(closeISO) <= new Date(openISO)) {
            showError('drop-form-error', 'Close time must be after open time.');
            return;
        }

        const collectedSpots = collectPickupSpots();
        if ('error' in collectedSpots) {
            showError('drop-form-error', collectedSpots.error);
            return;
        }

        const dropItems = Array.from(dropItemsContainer?.querySelectorAll<HTMLElement>('.drop-selected-row') ?? [])
            .map(row => ({
                menuItemId: row.dataset.id as string,
                initialStock: Number(row.dataset.stock),
                inPersonStock: Number(row.dataset.inperson ?? '0'),
                preview: row.dataset.preview === 'true',
                tag: row.dataset.tag ?? '',
            }));

        submitBtn.disabled = true;
        spinner.hidden = false;

        const res = await fetch(id ? `/api/v1/drops/${id}` : '/api/v1/drops', {
            method: id ? 'PATCH' : 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                name: data.name,
                openTime: openISO,
                closeTime: closeISO,
                lowStockThreshold: data.lowStockThreshold ?? '0',
                items: dropItems,
                pickupSpots: collectedSpots.spots,
            }),
        });

        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('drop-form-error', err.error ?? 'Something went wrong.');
            submitBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Delete drop ────────────────────────────────────────────
    let pendingDropDeleteId: string | null = null;
    document.querySelectorAll<HTMLButtonElement>('.admin-btn-drop-delete').forEach(btn => {
        btn.addEventListener('click', () => {
            pendingDropDeleteId = btn.dataset.id ?? null;
            const nameEl = document.getElementById('drop-delete-name');
            if (nameEl) nameEl.textContent = btn.dataset.name ?? 'this drop';
            clearError('drop-delete-error');
            openModal('drop-delete-modal');
        });
    });
    document.getElementById('close-drop-delete-modal')?.addEventListener('click', () => closeModal('drop-delete-modal'));
    document.getElementById('cancel-drop-delete-modal')?.addEventListener('click', () => closeModal('drop-delete-modal'));

    document.getElementById('confirm-drop-delete')?.addEventListener('click', async () => {
        if (!pendingDropDeleteId) return;
        clearError('drop-delete-error');
        const confirmBtn = document.getElementById('confirm-drop-delete') as HTMLButtonElement;
        const spinner = document.getElementById('drop-delete-spinner') as HTMLElement;
        confirmBtn.disabled = true;
        spinner.hidden = false;
        const res = await fetch(`/api/v1/drops/${pendingDropDeleteId}`, {method: 'DELETE'});
        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('drop-delete-error', err.error ?? 'Could not delete drop.');
            confirmBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Lifecycle actions (announce / unannounce / archive) ────
    async function patchDrop(id: string, body: Record<string, unknown>, btn: HTMLButtonElement) {
        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = 'Saving…';
        try {
            const res = await fetch(`/api/v1/drops/${id}`, {
                method: 'PATCH',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(body),
            });
            if (res.ok) {
                location.reload();
            } else {
                const err = await res.json();
                console.error('Drop update failed:', err.error ?? 'Unknown error');
                btn.disabled = false;
                btn.textContent = original;
            }
        } catch (err) {
            console.error('Drop update request failed:', err);
            btn.disabled = false;
            btn.textContent = original;
        }
    }

    document.querySelector<HTMLButtonElement>('.admin-btn-announce')?.addEventListener('click', function () {
        if (this.dataset.id) patchDrop(this.dataset.id, {announce: true}, this);
    });
    document.querySelector<HTMLButtonElement>('.admin-btn-unannounce')?.addEventListener('click', function () {
        if (this.dataset.id) patchDrop(this.dataset.id, {announce: false}, this);
    });
    document.querySelector<HTMLButtonElement>('.admin-btn-archive')?.addEventListener('click', function () {
        if (this.dataset.id) patchDrop(this.dataset.id, {archive: true}, this);
    });

    // ── Active drop countdown ──────────────────────────────────
    const dropCdEl = document.getElementById('drop-cd-clock');
    const dropCdTarget = dropCdEl?.closest('.drop-detail-countdown')?.getAttribute('data-target');
    if (dropCdEl && dropCdTarget) {
        const targetMs = new Date(dropCdTarget).getTime();
        const pad2 = (n: number) => String(n).padStart(2, '0');
        const tick = () => {
            const diff = targetMs - Date.now();
            if (diff <= 0) {
                // The window just opened or closed — re-render the new state.
                location.reload();
                return;
            }
            const d = Math.floor(diff / 86400000);
            const h = Math.floor((diff % 86400000) / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            const s = Math.floor((diff % 60000) / 1000);
            dropCdEl.textContent = (d > 0 ? `${d}d ` : '') + `${pad2(h)}:${pad2(m)}:${pad2(s)}`;
        };
        tick();
        setInterval(tick, 1000);
    }

</script>

