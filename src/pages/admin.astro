    // ── Delete modal ───────────────────────────────────────────
    let pendingDeleteId: string | null = null;
    let pendingDeleteForce = false;

    document.querySelectorAll<HTMLButtonElement>('.admin-btn-delete').forEach(btn => {
        btn.addEventListener('click', async () => {
            pendingDeleteId = btn.dataset.id ?? null;
            pendingDeleteForce = false;
            const row = btn.closest('tr');
            const name = row?.querySelector('.admin-td-name')?.textContent ?? 'this item';

            const nameEl = document.getElementById('delete-item-name');
            if (nameEl) nameEl.textContent = name;

            const standardText = document.getElementById('delete-standard-text') as HTMLElement;
            const checking = document.getElementById('delete-checking') as HTMLElement;
            const warning = document.getElementById('delete-drop-warning') as HTMLElement;
            const activeBanner = document.getElementById('delete-active-banner') as HTMLElement;
            const confirmBtn = document.getElementById('confirm-delete') as HTMLButtonElement;

            clearError('delete-form-error');
            // Reset to a "checking" state while we look up drop usage.
            standardText.hidden = true;
            warning.hidden = true;
            activeBanner.hidden = true;
            checking.hidden = false;
            confirmBtn.disabled = true;
            confirmBtn.textContent = 'Delete';
            confirmBtn.classList.remove('admin-btn-delete-confirm-active');
            openModal('delete-modal');

            if (!pendingDeleteId) return;

            try {
                const res = await fetch(`/api/v1/menu/${pendingDeleteId}`);
                const data = await res.json();
                const drops: {id: string; name: string; isCurrent?: boolean}[] = data.drops ?? [];
                checking.hidden = true;

                if (drops.length > 0) {
                    pendingDeleteForce = true;
                    const hasActive = drops.some(d => d.isCurrent);
                    const count = `${drops.length} drop${drops.length !== 1 ? 's' : ''}`;
                    (document.getElementById('delete-item-name-warn') as HTMLElement).textContent = name;
                    (document.getElementById('delete-drop-count') as HTMLElement).textContent = count;
                    const list = document.getElementById('delete-drop-list') as HTMLElement;
                    list.innerHTML = '';
                    drops.forEach(d => {
                        const li = document.createElement('li');
                        const nameSpan = document.createElement('span');
                        nameSpan.className = 'admin-delete-drop-name';
                        nameSpan.textContent = d.name;
                        li.appendChild(nameSpan);
                        if (d.isCurrent) {
                            li.classList.add('admin-delete-drop-active');
                            const badge = document.createElement('span');
                            badge.className = 'admin-delete-active-tag';
                            badge.textContent = 'ACTIVE';
                            li.appendChild(badge);
                        }
                        list.appendChild(li);
                    });
                    warning.hidden = false;
                    activeBanner.hidden = !hasActive;
                    confirmBtn.textContent = hasActive ? 'Delete ACTIVE drop & item' : 'Delete item & drops';
                    if (hasActive) confirmBtn.classList.add('admin-btn-delete-confirm-active');
                } else {
                    standardText.hidden = false;
                }
                confirmBtn.disabled = false;
            } catch {
                checking.hidden = true;
                standardText.hidden = false;
                confirmBtn.disabled = false;
            }
        });
    });
    document.getElementById('close-delete-modal')?.addEventListener('click', () => closeModal('delete-modal'));
    document.getElementById('cancel-delete-modal')?.addEventListener('click', () => closeModal('delete-modal'));

    document.getElementById('confirm-delete')?.addEventListener('click', async () => {
        if (!pendingDeleteId) return;
        clearError('delete-form-error');
        const confirmBtn = document.getElementById('confirm-delete') as HTMLButtonElement;
        const spinner = document.getElementById('delete-spinner') as HTMLElement;
        confirmBtn.disabled = true;
        spinner.hidden = false;
        const url = `/api/v1/menu/${pendingDeleteId}${pendingDeleteForce ? '?force=true' : ''}`;
        const res = await fetch(url, {method: 'DELETE'});
        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('delete-form-error', err.error ?? 'Could not delete item.');
            confirmBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Create Drop modal ──────────────────────────────────────
    const dropItemsContainer = document.getElementById('drop-items-selected');
    const dropItemsEmpty = document.getElementById('drop-items-empty');
    const dropItemSelect = document.getElementById('drop-item-select') as HTMLSelectElement | null;
    const dropItemStockInput = document.getElementById('drop-item-stock-input') as HTMLInputElement | null;
    const dropItemTagInput = document.getElementById('drop-item-tag-input') as HTMLInputElement | null;
    const dropItemPreviewInput = document.getElementById('drop-item-preview-input') as HTMLInputElement | null;

    function selectedDropItemIds(): Set<string> {
        return new Set(
            Array.from(dropItemsContainer?.querySelectorAll<HTMLElement>('.drop-selected-row') ?? [])
                .map(row => row.dataset.id as string),
        );
    }

    function refreshDropItemsEmpty() {
        const hasRows = (dropItemsContainer?.querySelectorAll('.drop-selected-row').length ?? 0) > 0;
        if (dropItemsEmpty) dropItemsEmpty.hidden = hasRows;
    }

    function refreshDropItemSelectOptions() {
        if (!dropItemSelect) return;
        const used = selectedDropItemIds();
        Array.from(dropItemSelect.options).forEach(opt => {
            if (!opt.value) return;
            opt.disabled = used.has(opt.value);
        });
        dropItemSelect.value = '';
    }

    // The row currently being edited via the picker modal (null = adding a new one).
    let editingDropRow: HTMLElement | null = null;
    const dropItemModalTitle = document.getElementById('drop-item-modal-title');
    const confirmDropItemBtn = document.getElementById('confirm-drop-item');

    function fillDropRow(row: HTMLElement, name: string, stock: number, preview: boolean, tag: string) {
        row.dataset.stock = String(stock);
        row.dataset.preview = preview ? 'true' : 'false';
        row.dataset.tag = tag;
        const nameEl = row.querySelector('.drop-selected-name') as HTMLElement;
        nameEl.textContent = name;
        const stockEl = row.querySelector('.drop-selected-stock') as HTMLElement;
        stockEl.textContent = `${stock} in stock`;
        const tagEl = row.querySelector('.drop-selected-tag') as HTMLElement;
        tagEl.textContent = tag;
        tagEl.hidden = !tag;
        const previewEl = row.querySelector('.drop-selected-preview') as HTMLElement;
        previewEl.hidden = !preview;
    }

    function addSelectedDropItem(id: string, name: string, stock: number, preview = false, tag = '') {
        if (!dropItemsContainer) return;
        const row = document.createElement('div');
        row.className = 'drop-selected-row';
        row.dataset.id = id;
        row.innerHTML = `
            <span class="drop-selected-name"></span>
            <div class="drop-selected-right">
                <span class="drop-selected-tag"></span>
                <span class="drop-selected-preview" title="Shown as a preview before the drop opens">★ preview</span>
                <span class="drop-selected-stock"></span>
                <button type="button" class="drop-selected-edit" title="Edit">Edit</button>
                <button type="button" class="drop-selected-remove" title="Remove">Remove</button>
            </div>`;
        fillDropRow(row, name, stock, preview, tag);
        row.querySelector('.drop-selected-edit')?.addEventListener('click', () => openDropItemEdit(row));
        row.querySelector('.drop-selected-remove')?.addEventListener('click', () => {
            row.remove();
            refreshDropItemsEmpty();
        });
        dropItemsContainer.appendChild(row);
        refreshDropItemsEmpty();
    }

    function closeDropItemModal() {
        const el = document.getElementById('drop-item-modal');
        if (el) el.hidden = true;
        editingDropRow = null;
        if (dropItemSelect) dropItemSelect.disabled = false;
    }

    document.getElementById('open-drop-item-modal')?.addEventListener('click', () => {
        editingDropRow = null;
        clearError('drop-item-error');
        if (dropItemSelect) dropItemSelect.disabled = false;
        refreshDropItemSelectOptions();
        updatePreOpenVisibility();
        if (dropItemStockInput) dropItemStockInput.value = '1';
        if (dropItemTagInput) dropItemTagInput.value = '';
        if (dropItemPreviewInput) dropItemPreviewInput.checked = false;
        if (dropItemModalTitle) dropItemModalTitle.textContent = 'Add Item to Drop';
        if (confirmDropItemBtn) confirmDropItemBtn.textContent = 'Add';
        const el = document.getElementById('drop-item-modal');
        if (el) el.hidden = false;
        dropItemSelect?.focus();
    });

    function openDropItemEdit(row: HTMLElement) {
        editingDropRow = row;
        clearError('drop-item-error');
        // The item itself is fixed while editing — lock the select to it.
        if (dropItemSelect) {
            Array.from(dropItemSelect.options).forEach(o => { o.disabled = false; });
            dropItemSelect.value = row.dataset.id ?? '';
            dropItemSelect.disabled = true;
        }
        if (dropItemStockInput) dropItemStockInput.value = row.dataset.stock ?? '1';
        if (dropItemTagInput) dropItemTagInput.value = row.dataset.tag ?? '';
        if (dropItemPreviewInput) dropItemPreviewInput.checked = row.dataset.preview === 'true';
        updatePreOpenVisibility();
        if (dropItemModalTitle) dropItemModalTitle.textContent = 'Edit Item';
        if (confirmDropItemBtn) confirmDropItemBtn.textContent = 'Save';
        const el = document.getElementById('drop-item-modal');
        if (el) el.hidden = false;
    }

    document.getElementById('close-drop-item-modal')?.addEventListener('click', closeDropItemModal);
    document.getElementById('cancel-drop-item-modal')?.addEventListener('click', closeDropItemModal);
    document.getElementById('drop-item-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeDropItemModal();
    });

    document.getElementById('confirm-drop-item')?.addEventListener('click', () => {
        clearError('drop-item-error');
        const opt = dropItemSelect?.selectedOptions[0];
        if (!opt || !opt.value) {
            showError('drop-item-error', 'Please select a menu item.');
            return;
        }
        const stock = Number(dropItemStockInput?.value);
        if (!Number.isInteger(stock) || stock < 0) {
            showError('drop-item-error', 'Stock must be a non-negative whole number.');
            return;
        }
        const preview = dropItemPreviewInput?.checked ?? false;
        const tag = dropItemTagInput?.value.trim() ?? '';

        if (editingDropRow) {
            fillDropRow(editingDropRow, opt.dataset.name ?? opt.textContent ?? '', stock, preview, tag);
        } else {
            addSelectedDropItem(opt.value, opt.dataset.name ?? opt.textContent ?? '', stock, preview, tag);
        }
        closeDropItemModal();
    });

    const dropIdField = document.getElementById('drop-id') as HTMLInputElement | null;
    const dropModalTitle = document.getElementById('drop-modal-title');
    const dropSubmitBtn = document.getElementById('drop-submit-btn');
    const dropOpenInput = document.getElementById('drop-open') as HTMLInputElement | null;
    const dropCountdownField = document.getElementById('drop-countdown-field');
    const dropItemPreviewField = document.getElementById('drop-item-preview-field');

    // The countdown teaser and per-item preview only apply before a drop opens.
    // Once the open time has passed the drop is live, so hide those controls.
    function dropOpenIsPast(): boolean {
        const v = dropOpenInput?.value;
        if (!v) return false;
        const t = new Date(v).getTime();
        return !Number.isNaN(t) && t <= Date.now();
    }

    function updatePreOpenVisibility() {
        const past = dropOpenIsPast();
        const cd = document.getElementById('drop-show-countdown') as HTMLInputElement | null;
        if (cd) {
            cd.disabled = past;
            if (past) cd.checked = false;
        }
        if (dropItemPreviewInput) dropItemPreviewInput.disabled = past;
        if (dropCountdownField) dropCountdownField.classList.toggle('admin-field-disabled', past);
        if (dropItemPreviewField) dropItemPreviewField.classList.toggle('admin-field-disabled', past);
        const cdNote = document.getElementById('drop-countdown-pastnote');
        if (cdNote) cdNote.hidden = !past;
        const pvNote = document.getElementById('drop-item-preview-pastnote');
        if (pvNote) pvNote.hidden = !past;
    }

    dropOpenInput?.addEventListener('input', updatePreOpenVisibility);

    function isoToLocalInput(iso: string): string {
        const d = new Date(iso);
        const pad = (n: number) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    document.getElementById('open-drop-modal')?.addEventListener('click', () => {
        (document.getElementById('drop-form') as HTMLFormElement)?.reset();
        if (dropIdField) dropIdField.value = '';
        if (dropModalTitle) dropModalTitle.textContent = 'Create Drop';
        if (dropSubmitBtn) dropSubmitBtn.textContent = 'Create Drop';
        if (dropItemsContainer) dropItemsContainer.innerHTML = '';
        refreshDropItemsEmpty();
        updatePreOpenVisibility();
        clearError('drop-form-error');
        openModal('drop-modal');
    });
    document.getElementById('close-drop-modal')?.addEventListener('click', () => closeModal('drop-modal'));
    document.getElementById('cancel-drop-modal')?.addEventListener('click', () => closeModal('drop-modal'));

    document.querySelectorAll<HTMLButtonElement>('.admin-btn-drop-edit').forEach(btn => {
        btn.addEventListener('click', async () => {
            const {id, name, open, close, current, countdown} = btn.dataset;
            (document.getElementById('drop-form') as HTMLFormElement)?.reset();
            if (dropIdField) dropIdField.value = id ?? '';
            if (dropModalTitle) dropModalTitle.textContent = 'Edit Drop';
            if (dropSubmitBtn) dropSubmitBtn.textContent = 'Save Changes';
            (document.getElementById('drop-name') as HTMLInputElement).value = name ?? '';
            (document.getElementById('drop-open') as HTMLInputElement).value = open ? isoToLocalInput(open) : '';
            (document.getElementById('drop-close') as HTMLInputElement).value = close ? isoToLocalInput(close) : '';
            (document.getElementById('drop-set-current') as HTMLInputElement).checked = current === 'true';
            (document.getElementById('drop-show-countdown') as HTMLInputElement).checked = countdown === 'true';
            if (dropItemsContainer) dropItemsContainer.innerHTML = '';
            refreshDropItemsEmpty();
            updatePreOpenVisibility();
            clearError('drop-form-error');
            openModal('drop-modal');

            try {
                const res = await fetch(`/api/v1/drops/${id}`);
                if (res.ok) {
                    const {items} = await res.json();
                    (items ?? []).forEach((it: {menuItem: {id: string; name: string}; initialStock: number; preview: boolean; tag: string}) => {
                        addSelectedDropItem(it.menuItem.id, it.menuItem.name, it.initialStock, it.preview, it.tag);
                    });
                } else {
                    showError('drop-form-error', 'Could not load this drop\u2019s items.');
                }
            } catch {
                showError('drop-form-error', 'Could not load this drop\u2019s items.');
            }
        });
    });

    document.getElementById('drop-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError('drop-form-error');
        const form = e.target as HTMLFormElement;
        const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
        const submitBtn = document.getElementById('drop-submit-btn') as HTMLButtonElement;
        const spinner = document.getElementById('drop-spinner') as HTMLElement;
        const id = dropIdField?.value ?? '';

        if (data.openTime && data.closeTime && new Date(data.closeTime) <= new Date(data.openTime)) {
            showError('drop-form-error', 'Close time must be after open time.');
            return;
        }

        const dropItems = Array.from(dropItemsContainer?.querySelectorAll<HTMLElement>('.drop-selected-row') ?? [])
            .map(row => ({
                menuItemId: row.dataset.id as string,
                initialStock: Number(row.dataset.stock),
                preview: row.dataset.preview === 'true',
                tag: row.dataset.tag ?? '',
            }));

        submitBtn.disabled = true;
        spinner.hidden = false;

        const res = await fetch(id ? `/api/v1/drops/${id}` : '/api/v1/drops', {
            method: id ? 'PATCH' : 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                name: data.name,
                openTime: data.openTime,
                closeTime: data.closeTime,
                setCurrent: data.setCurrent === 'on',
                showCountdown: data.showCountdown === 'on',
                items: dropItems,
            }),
        });

        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('drop-form-error', err.error ?? 'Something went wrong.');
            submitBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Delete drop ────────────────────────────────────────────
    let pendingDropDeleteId: string | null = null;
    document.querySelectorAll<HTMLButtonElement>('.admin-btn-drop-delete').forEach(btn => {
        btn.addEventListener('click', () => {
            pendingDropDeleteId = btn.dataset.id ?? null;
            const nameEl = document.getElementById('drop-delete-name');
            if (nameEl) nameEl.textContent = btn.dataset.name ?? 'this drop';
            clearError('drop-delete-error');
            openModal('drop-delete-modal');
        });
    });
    document.getElementById('close-drop-delete-modal')?.addEventListener('click', () => closeModal('drop-delete-modal'));
    document.getElementById('cancel-drop-delete-modal')?.addEventListener('click', () => closeModal('drop-delete-modal'));

    document.getElementById('confirm-drop-delete')?.addEventListener('click', async () => {
        if (!pendingDropDeleteId) return;
        clearError('drop-delete-error');
        const confirmBtn = document.getElementById('confirm-drop-delete') as HTMLButtonElement;
        const spinner = document.getElementById('drop-delete-spinner') as HTMLElement;
        confirmBtn.disabled = true;
        spinner.hidden = false;
        const res = await fetch(`/api/v1/drops/${pendingDropDeleteId}`, {method: 'DELETE'});
        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('drop-delete-error', err.error ?? 'Could not delete drop.');
            confirmBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Set current drop ───────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.admin-btn-set-current').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.dataset.id;
            if (!id) return;
            btn.disabled = true;
            const original = btn.textContent;
            btn.textContent = 'Saving…';
            try {
                const res = await fetch('/api/v1/drops/current', {
                    method: 'PUT',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({id}),
                });
                if (res.ok) {
                    location.reload();
                } else {
                    const err = await res.json();
                    console.error('Set current drop failed:', err.error ?? 'Unknown error');
                    btn.disabled = false;
                    btn.textContent = original;
                }
            } catch (err) {
                console.error('Set current drop request failed:', err);
                btn.disabled = false;
                btn.textContent = original;
            }
        });
    });

    // ── Unset current drop ─────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.admin-btn-unset-current').forEach(btn => {
        btn.addEventListener('click', async () => {
            btn.disabled = true;
            const original = btn.textContent;
            btn.textContent = 'Saving…';
            try {
                const res = await fetch('/api/v1/drops/current', {
                    method: 'PUT',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({id: null}),
                });
                if (res.ok) {
                    location.reload();
                } else {
                    const err = await res.json();
                    console.error('Unset current drop failed:', err.error ?? 'Unknown error');
                    btn.disabled = false;
                    btn.textContent = original;
                }
            } catch (err) {
                console.error('Unset current drop request failed:', err);
                btn.disabled = false;
                btn.textContent = original;
            }
        });
    });

</script>

