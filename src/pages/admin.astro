    document.querySelectorAll<HTMLButtonElement>('.admin-btn-ni-edit').forEach(btn => {
        btn.addEventListener('click', () => {
            (document.getElementById('ni-edit-id') as HTMLInputElement).value = btn.dataset.id ?? '';
            (document.getElementById('ni-edit-tag') as HTMLInputElement).value = btn.dataset.tag ?? '';
