        e.preventDefault();
        clearError('add-form-error');
        const form = e.target as HTMLFormElement;
        const data = Object.fromEntries(new FormData(form));
        const submitBtn = document.getElementById('add-submit-btn') as HTMLButtonElement;
        const spinner = document.getElementById('add-spinner') as HTMLElement;
        submitBtn.disabled = true;
        spinner.hidden = false;

        // Upload image first to get the UUID that will also be the DB row id
        const imageFile = (document.getElementById('add-image') as HTMLInputElement).files?.[0];
        if (!imageFile) {
            showError('add-form-error', 'An image is required.');
            submitBtn.disabled = false;
            spinner.hidden = true;
            return;
        }
        const uploadForm = new FormData();
        uploadForm.append('file', imageFile);
        const uploadRes = await fetch('/api/v1/upload', {method: 'POST', body: uploadForm});
        if (!uploadRes.ok) {
            const err = await uploadRes.json();
            showError('add-form-error', err.error ?? 'Image upload failed.');
            submitBtn.disabled = false;
            spinner.hidden = true;
            return;
        }
        const {uuid} = await uploadRes.json();

        const payload = {
            id: uuid,
            name: data.name,
            description: data.description,
            mystery: 'mystery' in data && data.mystery === 'on',
        };

        const res = await fetch('/api/v1/menu', {
            method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload),
        });

        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json();
            showError('add-form-error', err.error ?? 'Something went wrong.');
            submitBtn.disabled = false;
            spinner.hidden = true;
        }
    });

    // ── Edit modal ─────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.admin-btn-edit').forEach(btn => {
        btn.addEventListener('click', () => {
            const {id, name, description, image, mystery} = btn.dataset;
            (document.getElementById('edit-id') as HTMLInputElement).value = id ?? '';
            (document.getElementById('edit-name') as HTMLInputElement).value = name ?? '';
            (document.getElementById('edit-description') as HTMLTextAreaElement).value = description ?? '';

            // Always show the current image (url = storageUrl + id)
            const currentImg = document.getElementById('edit-current-image-img') as HTMLImageElement;
            if (currentImg) currentImg.src = image ?? '';

            // Reset the file upload field
            resetUploadField('edit-image', 'edit-image-label-text', 'edit-image-preview', 'edit-image-preview-img');

            (document.getElementById('edit-mystery') as HTMLInputElement).checked = mystery === 'true';
            applyMysteryState('edit', mystery === 'true');
