---
import '../../styles/global.css';
import { listCoupons } from '../../lib/db';
import type { Coupon } from '../../types/db-types.ts';

const user = (Astro.locals as { user?: { email?: string } }).user;

let coupons: Coupon[] = [];
let loadError = false;
try {
    coupons = await listCoupons();
} catch {
    loadError = true;
}

function formatValue(c: Coupon): string {
    if (c.type === 'percent') return `${c.value}% off`;
    return `$${(c.value / 100).toFixed(2)} off`;
}

function formatDate(iso: string | null): string {
    if (!iso) return '—';
    return new Date(iso).toLocaleString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric',
        hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles',
    });
}

function usageLabel(c: Coupon): string {
    if (c.maxRedemptions == null) return `${c.redemptionCount} used`;
    return `${c.redemptionCount} / ${c.maxRedemptions}`;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>Coupons — Katered Kneads</title>
</head>
<body class="admin-body">

<aside class="admin-sidebar">
    <div class="admin-sidebar-top">
        <a href="/" class="admin-logo">Katered Kneads</a>
        <span class="admin-badge">Admin</span>
    </div>

    <nav class="admin-nav">
        <a href="/admin" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
            </svg>
            Dashboard
        </a>
        <a href="/admin/stock" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            Stock
        </a>
        <a href="/admin/pos" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="2" y1="9" x2="22" y2="9"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            Point of Sale
        </a>
        <a href="/admin/orders" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 2h6a1 1 0 0 1 1 1v1h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1z"/>
                <line x1="9" y1="12" x2="15" y2="12"/>
                <line x1="9" y1="16" x2="15" y2="16"/>
            </svg>
            Orders
        </a>
        <a href="/admin/coupons" class="admin-nav-link admin-nav-active">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
            Coupons
        </a>
        <a href="/admin/sms" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            SMS
        </a>
        <a href="/menu" target="_blank" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
            </svg>
            View Menu ↗
        </a>
    </nav>

    <div class="admin-sidebar-footer">
        <p class="admin-user-email">{user?.email ?? 'Admin'}</p>
        <form method="POST" action="/api/v1/auth/logout">
            <button type="submit" class="admin-logout-btn">Sign Out</button>
        </form>
    </div>
</aside>

<main class="admin-main">
    <div class="admin-topbar">
        <div>
            <h1 class="admin-page-title">Coupons</h1>
            <p class="admin-page-sub">Promo codes for online checkout and POS</p>
        </div>
    </div>

    <div class="sms-add-card">
        <div class="sms-add-head">
            <h2 class="sms-add-title">Create a promo code</h2>
            <p class="sms-add-sub">Percent or fixed-dollar off the post-sale subtotal. Codes are case-insensitive.</p>
        </div>
        <form class="coupon-add-form" id="coupon-add-form" novalidate>
            <div class="coupon-add-grid">
                <div class="form-field">
                    <label for="coupon-code">Code *</label>
                    <input id="coupon-code" name="code" type="text" required placeholder="e.g. BERKELEY10" autocomplete="off" spellcheck="false" />
                </div>
                <div class="form-field">
                    <label for="coupon-type">Type *</label>
                    <select id="coupon-type" name="type" required>
                        <option value="percent">Percent off</option>
                        <option value="fixed">Fixed $ off</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="coupon-value" id="coupon-value-label">Percent (1–100) *</label>
                    <input id="coupon-value" name="value" type="number" min="1" step="1" required placeholder="10" />
                </div>
                <div class="form-field">
                    <label for="coupon-max">Max uses</label>
                    <input id="coupon-max" name="maxRedemptions" type="number" min="1" step="1" placeholder="Unlimited" />
                </div>
                <div class="form-field">
                    <label for="coupon-min">Min subtotal ($)</label>
                    <input id="coupon-min" name="minSubtotal" type="number" min="0" step="0.01" placeholder="None" />
                </div>
                <div class="form-field">
                    <label for="coupon-expires">Expires</label>
                    <input id="coupon-expires" name="expiresAt" type="datetime-local" />
                </div>
            </div>
            <button type="submit" class="btn-primary sms-add-btn">Create code</button>
        </form>
    </div>

    <div class="admin-table-wrap">
        {loadError ? (
            <div class="admin-empty">Couldn’t load coupons. Refresh to try again.</div>
        ) : coupons.length === 0 ? (
            <div class="admin-empty" id="coupons-empty">No promo codes yet. Create one above.</div>
        ) : (
            <table class="admin-table" id="coupons-table">
                <thead>
                <tr>
                    <th>Code</th>
                    <th>Discount</th>
                    <th>Usage</th>
                    <th>Min</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody id="coupons-tbody">
                {coupons.map(c => (
                    <tr data-coupon-row data-id={c.id}>
                        <td class="admin-td-name">{c.code}</td>
                        <td>{formatValue(c)}</td>
                        <td>{usageLabel(c)}</td>
                        <td>{c.minSubtotalCents != null ? `$${(c.minSubtotalCents / 100).toFixed(2)}` : '—'}</td>
                        <td class="admin-td-desc">{formatDate(c.expiresAt)}</td>
                        <td>
                            {c.active ? (
                                <span class="admin-stock-pill admin-stock-pill-ok">Active</span>
                            ) : (
                                <span class="admin-stock-pill admin-stock-pill-soldout">Inactive</span>
                            )}
                        </td>
                        <td class="admin-td-actions">
                            <div class="admin-td-actions-inner">
                                <button type="button" class="admin-btn-edit" data-toggle-active data-active={c.active ? '1' : '0'}>
                                    {c.active ? 'Deactivate' : 'Activate'}
                                </button>
                                <button type="button" class="admin-btn-delete" data-delete>Delete</button>
                            </div>
                        </td>
                    </tr>
                ))}
                </tbody>
            </table>
        )}
    </div>
</main>

<script>
    import { showToast, confirmDialog } from '../../lib/toast';

    const typeEl = document.getElementById('coupon-type') as HTMLSelectElement;
    const valueLabel = document.getElementById('coupon-value-label') as HTMLLabelElement;
    const valueEl = document.getElementById('coupon-value') as HTMLInputElement;

    function syncValueField() {
        if (typeEl.value === 'fixed') {
            valueLabel.textContent = 'Amount ($) *';
            valueEl.step = '0.01';
            valueEl.min = '0.01';
            valueEl.placeholder = '5.00';
        } else {
            valueLabel.textContent = 'Percent (1–100) *';
            valueEl.step = '1';
            valueEl.min = '1';
            valueEl.placeholder = '10';
        }
    }
    typeEl.addEventListener('change', syncValueField);
    syncValueField();

    const addForm = document.getElementById('coupon-add-form') as HTMLFormElement;
    addForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(addForm);
        const code = String(fd.get('code') ?? '').trim();
        const type = String(fd.get('type') ?? 'percent');
        const value = Number(fd.get('value'));
        const maxRaw = String(fd.get('maxRedemptions') ?? '').trim();
        const minRaw = String(fd.get('minSubtotal') ?? '').trim();
        const expiresRaw = String(fd.get('expiresAt') ?? '').trim();

        const payload: Record<string, unknown> = { code, type, value };
        if (maxRaw) payload.maxRedemptions = Number(maxRaw);
        if (minRaw) payload.minSubtotalCents = Math.round(Number(minRaw) * 100);
        if (expiresRaw) payload.expiresAt = new Date(expiresRaw).toISOString();

        const btn = addForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        const original = btn.textContent ?? 'Create code';
        btn.disabled = true;
        btn.textContent = 'Creating…';
        try {
            const res = await fetch('/api/v1/coupons', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error ?? 'Could not create coupon.');
            location.reload();
        } catch (err) {
            showToast(err instanceof Error ? err.message : 'Could not create coupon.', 'error');
            btn.disabled = false;
            btn.textContent = original;
        }
    });

    document.getElementById('coupons-tbody')?.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        const row = target.closest('[data-coupon-row]') as HTMLElement | null;
        if (!row) return;
        const id = row.dataset.id;
        if (!id) return;

        if (target.closest('[data-toggle-active]')) {
            const btn = target.closest('[data-toggle-active]') as HTMLButtonElement;
            const currentlyActive = btn.dataset.active === '1';
            btn.disabled = true;
            try {
                const res = await fetch(`/api/v1/coupons/${id}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ active: !currentlyActive }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error ?? 'Update failed');
                location.reload();
            } catch (err) {
                showToast(err instanceof Error ? err.message : 'Update failed.', 'error');
                btn.disabled = false;
            }
            return;
        }

        if (target.closest('[data-delete]')) {
            const ok = await confirmDialog(
                'This permanently removes the code. Past orders keep their discount snapshot.',
                { title: 'Delete promo code?', confirmLabel: 'Delete', danger: true },
            );
            if (!ok) return;
            try {
                const res = await fetch(`/api/v1/coupons/${id}`, { method: 'DELETE' });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error ?? 'Delete failed');
                row.remove();
                showToast('Promo code deleted.', 'success');
                if (!document.querySelector('[data-coupon-row]')) location.reload();
            } catch (err) {
                showToast(err instanceof Error ? err.message : 'Delete failed.', 'error');
            }
        }
    });
</script>

<style>
    /* ── Admin layout (mirrors other admin pages) ─────────────── */
    .admin-body {
        min-height: 100vh;
        background: #F3EDE5;
        display: flex;
    }
    .admin-sidebar {
        width: 220px;
        flex-shrink: 0;
        background: var(--bg);
        border-right: 1px solid var(--accent);
        display: flex;
        flex-direction: column;
        padding: 2rem 1.5rem;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        overflow-y: auto;
    }
    .admin-sidebar-top { margin-bottom: 2.5rem; }
    .admin-logo {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-primary);
        text-decoration: none;
        display: block;
    }
    .admin-badge {
        display: inline-block;
        margin-top: 0.35rem;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        background: var(--text-primary);
        color: var(--bg);
        padding: 0.18rem 0.55rem;
    }
    .admin-nav { display: flex; flex-direction: column; gap: 0.25rem; flex: 1; }
    .admin-nav-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.6rem 0.75rem;
        border-radius: 2px;
        transition: background 0.15s, color 0.15s;
    }
    .admin-nav-link:hover,
    .admin-nav-active {
        background: #EDE8E1;
        color: var(--text-primary);
    }
    .admin-sidebar-footer {
        border-top: 1px solid var(--accent);
        padding-top: 1.25rem;
        margin-top: auto;
    }
    .admin-user-email {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
        word-break: break-all;
    }
    .admin-logout-btn {
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-muted);
        cursor: pointer;
        background: none;
        border: 1px solid var(--accent);
        padding: 0.45rem 0.9rem;
        transition: border-color 0.15s, color 0.15s;
        width: 100%;
    }
    .admin-logout-btn:hover { border-color: var(--text-primary); color: var(--text-primary); }

    .admin-main {
        margin-left: 220px;
        flex: 1;
        padding: 2.5rem 2rem;
        min-width: 0;
    }
    .admin-topbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .admin-page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
    }
    .admin-page-sub {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin: 0.25rem 0 0;
    }

    /* ── Create form card ──────────────────────────────────────── */
    .sms-add-card {
        background: var(--bg);
        border: 1px solid var(--accent);
        border-left: 4px solid #4A6FA5;
        border-radius: 12px;
        padding: 1.25rem 1.5rem 1.5rem;
        margin-bottom: 1.5rem;
    }
    .sms-add-head { margin-bottom: 1rem; }
    .sms-add-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.3rem;
        font-weight: 600;
        margin: 0;
    }
    .sms-add-sub {
        font-size: 0.78rem;
        color: var(--text-muted);
        margin: 0.2rem 0 0;
    }
    .sms-add-btn {
        white-space: nowrap;
        flex-shrink: 0;
        align-self: flex-start;
        cursor: pointer;
    }
    .coupon-add-form { display: flex; flex-direction: column; gap: 1rem; }
    .coupon-add-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 0.85rem 1rem;
    }
    .form-field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .form-field label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
    }
    .form-field input,
    .form-field select {
        width: 100%;
        box-sizing: border-box;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--accent);
        border-radius: 8px;
        background: #fff;
        font: inherit;
        color: var(--text-primary);
    }
    .form-field input:focus,
    .form-field select:focus {
        outline: none;
        border-color: var(--text-primary);
    }

    /* ── Table ─────────────────────────────────────────────────── */
    .admin-table-wrap {
        background: var(--bg);
        border: 1px solid var(--accent);
        overflow-x: auto;
    }
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    .admin-table thead { border-bottom: 1px solid var(--accent); }
    .admin-table th {
        text-align: left;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 0.9rem 1.25rem;
        white-space: nowrap;
    }
    .admin-table td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--accent);
        color: var(--text-primary);
    }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-table tr:hover td { background: #FAF7F2; }
    .admin-td-name { font-weight: 500; white-space: nowrap; }
    .admin-td-desc { color: var(--text-muted); font-size: 0.85rem; }
    .admin-td-actions { white-space: nowrap; }
    .admin-td-actions-inner {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .admin-empty {
        padding: 3rem;
        text-align: center;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .admin-stock-pill {
        display: inline-block;
        font-size: 0.63rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--accent);
        white-space: nowrap;
    }
    .admin-stock-pill-ok { background: #EEF6EE; border-color: #9CC79C; color: #2F6A2F; }
    .admin-stock-pill-soldout { background: #FDF0EE; border-color: #D9836A; color: #9A3A1A; }

    .admin-btn-edit,
    .admin-btn-delete {
        cursor: pointer;
        border: 1px solid var(--accent);
        background: #fff;
        border-radius: 8px;
        padding: 0.4rem 0.85rem;
        font-size: 0.78rem;
        font-weight: 600;
        transition: background 0.15s ease, border-color 0.15s ease;
    }
    .admin-btn-edit {
        color: var(--text-primary);
    }
    .admin-btn-edit:hover:not(:disabled) { background: #EDE8E1; }
    .admin-btn-delete {
        color: #9A3A1A;
    }
    .admin-btn-delete:hover:not(:disabled) { background: #FDF0EE; border-color: #D9836A; }
    .admin-btn-edit:disabled,
    .admin-btn-delete:disabled { opacity: 0.5; cursor: default; }

    /* ── Responsive ────────────────────────────────────────────── */
    @media (max-width: 768px) {
        .admin-body { flex-direction: column; }
        .admin-sidebar {
            position: static;
            width: 100%;
            height: auto;
            flex-flow: row wrap;
            align-items: center;
            gap: 0.5rem 1rem;
            padding: 0.85rem 1rem;
            border-right: none;
            border-bottom: 1px solid var(--accent);
        }
        .admin-sidebar-top {
            margin-bottom: 0;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .admin-badge { margin-top: 0; }
        .admin-nav {
            order: 2;
            flex-basis: 100%;
            flex-direction: row;
            gap: 0.25rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .admin-nav-link { white-space: nowrap; padding: 0.5rem 0.7rem; }
        .admin-sidebar-footer {
            margin: 0 0 0 auto;
            padding-top: 0;
            border-top: none;
        }
        .admin-user-email { display: none; }
        .admin-logout-btn { width: auto; white-space: nowrap; }

        .admin-main { margin-left: 0; padding: 1.5rem 1rem; }
        .sms-add-btn { width: 100%; text-align: center; }
    }
</style>

</body>
</html>
