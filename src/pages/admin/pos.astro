        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }
    .pos-cart-head .pos-panel-title { margin: 0; }
    .pos-cart-clear {
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
    }
    .pos-cart-clear:hover { color: var(--text-primary); }
    .pos-cart-empty {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-align: center;
        padding: 1.5rem 0;
    }
    .pos-cart-lines { list-style: none; padding: 0; margin: 0; }
    .pos-cart-lines :global(.pos-cart-line) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0;
        border-top: 1px solid #efe9e0;
    }
    .pos-cart-lines :global(.pos-cart-line:first-child) { border-top: none; }
    .pos-cart-lines :global(.pos-cart-line-info) { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .pos-cart-lines :global(.pos-cart-line-name) { font-weight: 600; font-size: 0.9rem; overflow-wrap: anywhere; }
    .pos-cart-lines :global(.pos-cart-line-price) { font-size: 0.72rem; color: var(--text-muted); }
    .pos-cart-lines :global(.pos-cart-line-total) {
        flex-shrink: 0;
        min-width: 4ch;
        text-align: right;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .pos-cart-foot {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--accent);
    }
    .pos-cart-total-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 0.9rem;
    }
    .pos-cart-total-row span:last-child { font-size: 1.5rem; font-variant-numeric: tabular-nums; }
    .pos-charge-btn {
        width: 100%;
        background: var(--text-primary);
        color: var(--bg);
        border: none;
        border-radius: 10px;
        padding: 1rem;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
    }
    .pos-charge-btn:disabled { opacity: 0.4; cursor: default; }

    /* Charge / QR modal */
    .pos-charge-modal { max-width: 420px; text-align: center; }
    .pos-charge-modal .pos-panel-title { margin: 0 1.5rem 0.25rem 0; }
    .pos-charge-amount { font-size: 1.6rem; font-weight: 700; margin: 0 0 1rem; font-variant-numeric: tabular-nums; }
    .pos-qr-wrap {
        display: flex;
        justify-content: center;
        background: #fff;
        border: 1px solid var(--accent);
        border-radius: 14px;
        padding: 1rem;
        margin: 0 auto 1rem;
        width: fit-content;
    }
    .pos-qr { display: block; width: 280px; height: 280px; max-width: 100%; }
    .pos-charge-hint { font-size: 0.82rem; color: var(--text-muted); margin: 0 0 1rem; }
    .pos-charge-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.85rem;
    }
    .pos-charge-spinner {
        width: 1.05rem;
        height: 1.05rem;
        border: 2px solid var(--accent);
        border-top-color: var(--text-primary);
        border-radius: 50%;
        animation: pos-spin 0.8s linear infinite;
    }
    @keyframes pos-spin { to { transform: rotate(360deg); } }
    .pos-charge-link { font-size: 0.8rem; color: var(--text-muted); }
    .pos-charge-error-msg { color: #9A3A1A; font-size: 0.9rem; margin: 0 0 1.25rem; }
    .pos-charge-retry { background: var(--text-primary); }
    .pos-mark {
        width: 64px;
        height: 64px;
        line-height: 64px;
        border-radius: 50%;
        background: #3F6B33;
        color: #fff;
        font-size: 2rem;
        margin: 0.5rem auto 1rem;
    }
    .pos-mark-error { background: #b00020; }

    .pos-stepper { display: flex; align-items: center; gap: 0.5rem; }
    .pos-step {
        width: 2.6rem;
        height: 2.6rem;
        border: 1px solid var(--accent);
        background: #fff;
        border-radius: 10px;
        font-size: 1.4rem;
        line-height: 1;
        cursor: pointer;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pos-step:active { background: #f0ebe3; }
    .pos-step:disabled { opacity: 0.5; cursor: default; }
    .pos-step-val {
        min-width: 2ch;
        text-align: center;
        font-size: 1.2rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    /* ── Remaining orders list ─────────────────────────────────── */
    .pos-remaining-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
    }
    .pos-remaining-badge {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        white-space: nowrap;
    }
    .pos-remaining-list { list-style: none; padding: 0; margin: 0; }
    /* Rows are injected via innerHTML, so they don't get Astro's scoped
       attribute — these rules must be :global to apply. */
    .pos-remaining-list :global(.pos-remaining-item) {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.7rem 0;
        border-top: 1px solid #efe9e0;
    }
    .pos-remaining-list :global(.pos-remaining-item:first-child) { border-top: none; }
    .pos-remaining-list :global(.pos-remaining-info) {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }
    .pos-remaining-list :global(.pos-remaining-name) {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .pos-remaining-list :global(.pos-remaining-summary) {
        font-size: 0.75rem;
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .pos-remaining-list :global(.pos-remaining-total) {
        flex-shrink: 0;
        font-size: 0.9rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }
    .pos-remaining-list :global(.pos-remaining-expand) {
        flex-shrink: 0;
        width: 2.1rem;
        height: 2.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid var(--accent);
        border-radius: 8px;
        color: var(--text-muted);
        font-size: 1rem;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
    }
    .pos-remaining-list :global(.pos-remaining-expand:hover) {
        border-color: var(--text-primary);
        color: var(--text-primary);
    }

    /* ── Order details modal ───────────────────────────────────── */
    .pos-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(26, 26, 26, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        z-index: 100;
    }
    .pos-modal-overlay[hidden] { display: none; }
    .pos-modal {
        position: relative;
        background: var(--bg);
        border: 1px solid var(--accent);
        border-radius: 14px;
        padding: 1.75rem;
        width: 100%;
        max-width: 480px;
        max-height: calc(100vh - 2.5rem);
        overflow-y: auto;
    }
    .pos-modal-close {
        position: absolute;
        top: 0.85rem;
        right: 0.85rem;
        width: 2rem;
        height: 2rem;
        border: none;
        background: none;
        font-size: 1.1rem;
        color: var(--text-muted);
        cursor: pointer;
        border-radius: 8px;
    }
    .pos-modal-close:hover { color: var(--text-primary); background: #EDE8E1; }
    .pos-modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        margin: 0 2rem 1rem 0;
    }

    /* ── Responsive ────────────────────────────────────────────── */
    @media (max-width: 768px) {
        .admin-body { flex-direction: column; }

        /* Sidebar collapses into a horizontal top bar instead of vanishing,
           so admins keep navigation on mobile. */
        .admin-sidebar {
            position: static;
            width: 100%;
            height: auto;
            flex-flow: row wrap;
            align-items: center;
            gap: 0.5rem 1rem;
            padding: 0.85rem 1rem;
            border-right: none;
            border-bottom: 1px solid var(--accent);
        }
        .admin-sidebar-top {
            margin-bottom: 0;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .admin-badge { margin-top: 0; }
        .admin-nav {
            order: 2;
            flex-basis: 100%;
            flex-direction: row;
            gap: 0.25rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .admin-nav-link { white-space: nowrap; padding: 0.5rem 0.7rem; }
        .admin-sidebar-footer {
            margin: 0 0 0 auto;
            padding-top: 0;
            border-top: none;
        }
        .admin-user-email { display: none; }
        .admin-logout-btn { width: auto; white-space: nowrap; }

        .admin-main { margin-left: 0; padding: 1.5rem 1rem; }

        .admin-tabs { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .admin-tab { white-space: nowrap; flex-shrink: 0; }
    }
</style>
