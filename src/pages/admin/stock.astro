---
import '../../styles/global.css';
import { getActiveDrop, getDropItems } from '../../lib/db';
import type { Drop, DropItemWithMenu } from '../../types/db-types.ts';

// Route is protected by middleware (src/middleware.ts).
const user = (Astro.locals as { user?: { email?: string } }).user;

let activeDrop: Drop | null = null;
try {
    activeDrop = await getActiveDrop();
} catch (e) {
    // non-fatal
}

let activeDropItems: DropItemWithMenu[] = [];
if (activeDrop) {
    try {
        activeDropItems = await getDropItems(activeDrop.id);
    } catch (e) {
        // non-fatal
    }
}

const now = Date.now();
type DropStatus = 'draft' | 'upcoming' | 'live' | 'closed';
function dropStatus(drop: Drop): DropStatus {
    if (!drop.announcedAt) return 'draft';
    const open = new Date(drop.openTime).getTime();
    const close = new Date(drop.closeTime).getTime();
    if (now < open) return 'upcoming';
    if (now < close) return 'live';
    return 'closed';
}
const STATUS_LABEL: Record<DropStatus, string> = {
    draft: 'Draft', upcoming: 'Announced', live: 'Live', closed: 'Closed',
};
const activeStatus: DropStatus | null = activeDrop ? dropStatus(activeDrop) : null;

// Mirror the drop's customer-facing threshold for the admin "low" pills. When
// the admin has it set to 0 (counts hidden from customers) fall back to 5 so
// this internal dashboard still flags items that are running down.
const LOW_STOCK_THRESHOLD = activeDrop?.lowStockThreshold || 5;
const stockItems = activeDropItems.map(item => {
    const remaining = item.initialStock - item.consumedStock;
    const soldPct = item.initialStock > 0 ? Math.round((item.consumedStock / item.initialStock) * 100) : 0;
    const status: 'soldout' | 'low' | 'ok' =
        remaining <= 0 ? 'soldout' : remaining <= LOW_STOCK_THRESHOLD ? 'low' : 'ok';
    const inPersonRemaining = item.inPersonStock - item.inPersonConsumed;
    const inPersonSoldPct = item.inPersonStock > 0 ? Math.round((item.inPersonConsumed / item.inPersonStock) * 100) : 0;
    const inPersonStatus: 'soldout' | 'low' | 'ok' =
        inPersonRemaining <= 0 ? 'soldout' : inPersonRemaining <= LOW_STOCK_THRESHOLD ? 'low' : 'ok';
    return {
        menuItemId: item.menuItem.id,
        name: item.menuItem.name,
        initial: item.initialStock,
        sold: item.consumedStock,
        remaining,
        soldPct,
        status,
        inPersonStock: item.inPersonStock,
        inPersonSold: item.inPersonConsumed,
        inPersonRemaining,
        inPersonSoldPct,
        inPersonStatus,
    };
});
const inPersonItems = stockItems.filter(r => r.inPersonStock > 0);
const stockTotals = {
    initial: stockItems.reduce((s, r) => s + r.initial, 0),
    sold: stockItems.reduce((s, r) => s + r.sold, 0),
    remaining: stockItems.reduce((s, r) => s + r.remaining, 0),
    inPersonStock: stockItems.reduce((s, r) => s + r.inPersonStock, 0),
    inPersonSold: stockItems.reduce((s, r) => s + r.inPersonSold, 0),
    inPersonRemaining: stockItems.reduce((s, r) => s + r.inPersonRemaining, 0),
};

// ── At-a-glance summary (split by channel) ────────────────────
const onlineSoldPct = stockTotals.initial > 0 ? Math.round((stockTotals.sold / stockTotals.initial) * 100) : 0;
const onlineSoldOut = stockItems.filter(r => r.status === 'soldout').length;
const onlineLow = stockItems.filter(r => r.status === 'low').length;

const inPersonSoldPctTotal = stockTotals.inPersonStock > 0 ? Math.round((stockTotals.inPersonSold / stockTotals.inPersonStock) * 100) : 0;
const inPersonSoldOut = inPersonItems.filter(r => r.inPersonStatus === 'soldout').length;
const inPersonLow = inPersonItems.filter(r => r.inPersonStatus === 'low').length;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>Stock — Katered Kneads</title>
</head>
<body class="admin-body">

<!-- Sidebar -->
<aside class="admin-sidebar">
    <div class="admin-sidebar-top">
        <a href="/" class="admin-logo">Katered Kneads</a>
        <span class="admin-badge">Admin</span>
    </div>

    <nav class="admin-nav">
        <a href="/admin" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
            </svg>
            Dashboard
        </a>
        <a href="/admin/stock" class="admin-nav-link admin-nav-active">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            Stock
        </a>
        <a href="/admin/pos" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="2" y1="9" x2="22" y2="9"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            Point of Sale
        </a>
        <a href="/menu" target="_blank" class="admin-nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
            </svg>
            View Menu ↗
        </a>
    </nav>

    <div class="admin-sidebar-footer">
        <p class="admin-user-email">{user?.email ?? 'Admin'}</p>
        <form method="POST" action="/api/v1/auth/logout">
            <button type="submit" class="admin-logout-btn">Sign Out</button>
        </form>
    </div>
</aside>

<!-- Main content -->
<main class="admin-main">
    <div class="admin-topbar">
        <div>
            <h1 class="admin-page-title">Stock</h1>
            <p class="admin-page-sub">Inventory for the active drop</p>
        </div>
    </div>

    <div class="admin-tab-panel">
        {!activeDrop ? (
                <div class="admin-empty">No active drop. Create and announce a drop to track its stock here.</div>
        ) : (
                <>
                    <div class="admin-stock-head">
                        <div>
                            <span class="admin-stock-drop-name">{activeDrop.name}</span>
                            <span class="admin-stock-drop-sub">{activeStatus && STATUS_LABEL[activeStatus]} · active drop</span>
                        </div>
                    </div>

                    <!-- ── At a glance (split by channel) ───────────── -->
                    <div class="stock-glance-row">
                        <div class="stock-glance stock-glance-online">
                            <div class="stock-glance-summary">
                                <div class="stock-progress-ring" style={`--pct:${onlineSoldPct};--ring:#4A6FA5`}>
                                    <span class="stock-progress-num">{onlineSoldPct}%</span>
                                    <span class="stock-progress-label">sold</span>
                                </div>
                                <div class="stock-glance-body">
                                    <span class="stock-glance-tag stock-glance-tag-online">Online</span>
                                    <div class="stock-glance-figures">
                                        <div class="stock-figure">
                                            <span class="stock-figure-num">{stockTotals.remaining}</span>
                                            <span class="stock-figure-label">left</span>
                                        </div>
                                        <div class="stock-figure">
                                            <span class="stock-figure-num">{stockTotals.sold}</span>
                                            <span class="stock-figure-label">sold</span>
                                        </div>
                                        <div class="stock-figure">
                                            <span class="stock-figure-num">{stockTotals.initial}</span>
                                            <span class="stock-figure-label">stock</span>
                                        </div>
                                    </div>
                                    <div class="stock-flags">
                                        {onlineSoldOut > 0 && (
                                            <span class="stock-flag stock-flag-soldout">{onlineSoldOut} sold out</span>
                                        )}
                                        {onlineLow > 0 && (
                                            <span class="stock-flag stock-flag-low">{onlineLow} low</span>
                                        )}
                                        {onlineSoldOut === 0 && onlineLow === 0 && stockItems.length > 0 && (
                                            <span class="stock-flag stock-flag-ok">All healthy</span>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="stock-glance stock-glance-inperson">
                            <div class="stock-glance-summary">
                                <div class="stock-progress-ring" style={`--pct:${inPersonSoldPctTotal};--ring:#C6A15B`}>
                                    <span class="stock-progress-num">{inPersonSoldPctTotal}%</span>
                                    <span class="stock-progress-label">sold</span>
                                </div>
                                <div class="stock-glance-body">
                                    <span class="stock-glance-tag stock-glance-tag-inperson">In-person</span>
                                    {stockTotals.inPersonStock === 0 ? (
                                        <p class="stock-glance-none">No in-person stock set aside.</p>
                                    ) : (
                                        <>
                                            <div class="stock-glance-figures">
                                                <div class="stock-figure">
                                                    <span class="stock-figure-num">{stockTotals.inPersonRemaining}</span>
                                                    <span class="stock-figure-label">left</span>
                                                </div>
                                                <div class="stock-figure">
                                                    <span class="stock-figure-num">{stockTotals.inPersonSold}</span>
                                                    <span class="stock-figure-label">sold</span>
                                                </div>
                                                <div class="stock-figure">
                                                    <span class="stock-figure-num">{stockTotals.inPersonStock}</span>
                                                    <span class="stock-figure-label">stock</span>
                                                </div>
                                            </div>
                                            <div class="stock-flags">
                                                {inPersonSoldOut > 0 && (
                                                    <span class="stock-flag stock-flag-soldout">{inPersonSoldOut} sold out</span>
                                                )}
                                                {inPersonLow > 0 && (
                                                    <span class="stock-flag stock-flag-low">{inPersonLow} low</span>
                                                )}
                                                {inPersonSoldOut === 0 && inPersonLow === 0 && (
                                                    <span class="stock-flag stock-flag-ok">All healthy</span>
                                                )}
                                            </div>
                                        </>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Online ───────────────────────────────────── -->
                    <section class="stock-section stock-section-online">
                        <div class="stock-section-head">
                            <span class="stock-section-tag">Online</span>
                            <div>
                                <h3 class="stock-section-title">Online sales</h3>
                                <span class="stock-section-sub">Sold on the website</span>
                            </div>
                            <div class="stock-section-mini">
                                <span><strong>{stockTotals.remaining}</strong> left</span>
                                <span><strong>{stockTotals.sold}</strong> sold</span>
                                <span><strong>{stockTotals.initial}</strong> stock</span>
                            </div>
                        </div>

                        {stockItems.length === 0 ? (
                            <div class="admin-table-wrap"><div class="admin-empty">This drop has no items yet. Add items to the drop to track stock.</div></div>
                        ) : (
                            <>
                                <div class="stock-cards">
                                    {stockItems.map(row => (
                                        <div class={`stock-card stock-card-${row.status}`}>
                                            <div class="stock-card-top">
                                                <span class="stock-card-name">{row.name}</span>
                                                <span class={`admin-stock-pill admin-stock-pill-${row.status}`}>
                                                    {row.status === 'soldout' ? 'Sold out' : row.status === 'low' ? 'Low' : 'In stock'}
                                                </span>
                                            </div>
                                            <div class="stock-card-figure">
                                                <span class="stock-card-remaining">{row.remaining}</span>
                                                <span class="stock-card-remaining-label">of {row.initial} left</span>
                                            </div>
                                            <div class="admin-stock-bar">
                                                <div class={`admin-stock-bar-fill admin-stock-fill-${row.status}`} style={`width:${row.soldPct}%`}></div>
                                            </div>
                                        </div>
                                    ))}
                                </div>

                                <div class="admin-table-wrap">
                                    <table class="admin-table">
                                        <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th>Stock</th>
                                            <th>Sold</th>
                                            <th>Remaining</th>
                                            <th class="admin-stock-progress-col">Sold-through</th>
                                            <th>Status</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {stockItems.map(row => (
                                                <tr>
                                                    <td class="admin-td-name">{row.name}</td>
                                                    <td>{row.initial}</td>
                                                    <td>{row.sold}</td>
                                                    <td>{row.remaining}</td>
                                                    <td class="admin-stock-progress-col">
                                                        <div class="admin-stock-bar">
                                                            <div class={`admin-stock-bar-fill admin-stock-fill-${row.status}`} style={`width:${row.soldPct}%`}></div>
                                                        </div>
                                                        <span class="admin-stock-pct">{row.soldPct}%</span>
                                                    </td>
                                                    <td>
                                                        <span class={`admin-stock-pill admin-stock-pill-${row.status}`}>
                                                            {row.status === 'soldout' ? 'Sold out' : row.status === 'low' ? 'Low' : 'In stock'}
                                                        </span>
                                                    </td>
                                                </tr>))}
                                        </tbody>
                                    </table>
                                </div>
                            </>
                        )}
                    </section>

                    <!-- ── In-person ────────────────────────────────── -->
                    <section class="stock-section stock-section-inperson">
                        <div class="stock-section-head">
                            <span class="stock-section-tag">In-person</span>
                            <div>
                                <h3 class="stock-section-title">In-person sales</h3>
                                <span class="stock-section-sub">Sold by hand at the table</span>
                            </div>
                            <div class="stock-section-mini">
                                <span><strong id="ip-total-remaining">{stockTotals.inPersonRemaining}</strong> left</span>
                                <span><strong id="ip-total-sold">{stockTotals.inPersonSold}</strong> sold</span>
                                <span><strong>{stockTotals.inPersonStock}</strong> stock</span>
                            </div>
                        </div>

                        {stockTotals.inPersonStock === 0 ? (
                            <div class="admin-table-wrap"><div class="admin-empty">No in-person stock set aside for this drop. Add some via “Edit items” on the Drops tab.</div></div>
                        ) : (
                            <>
                                <div class="stock-cards">
                                    {inPersonItems.map(row => (
                                        <div class={`stock-card stock-card-${row.inPersonStatus}`}>
                                            <div class="stock-card-top">
                                                <span class="stock-card-name">{row.name}</span>
                                                <span class={`admin-stock-pill admin-stock-pill-${row.inPersonStatus}`}>
                                                    {row.inPersonStatus === 'soldout' ? 'Sold out' : row.inPersonStatus === 'low' ? 'Low' : 'In stock'}
                                                </span>
                                            </div>
                                            <div class="stock-card-figure">
                                                <span class="stock-card-remaining">{row.inPersonRemaining}</span>
                                                <span class="stock-card-remaining-label">of {row.inPersonStock} left</span>
                                            </div>
                                            <div class="admin-stock-bar">
                                                <div class={`admin-stock-bar-fill admin-stock-fill-${row.inPersonStatus}`} style={`width:${row.inPersonSoldPct}%`}></div>
                                            </div>
                                        </div>
                                    ))}
                                </div>

                                <div class="admin-table-wrap">
                                    <table class="admin-table" id="ip-stock-table" data-drop-id={activeDrop.id}>
                                        <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th>Stock</th>
                                            <th>Sold</th>
                                            <th>Remaining</th>
                                            <th>Record a sale</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {stockItems.map(row => (
                                                <tr class="ip-row" data-menu-item-id={row.menuItemId} data-stock={row.inPersonStock} data-sold={row.inPersonSold}>
                                                    <td class="admin-td-name">{row.name}</td>
                                                    <td>{row.inPersonStock > 0 ? row.inPersonStock : <span class="admin-no-image">—</span>}</td>
                                                    <td><span class="ip-sold-val">{row.inPersonSold}</span></td>
                                                    <td><span class="ip-remaining-val">{row.inPersonRemaining}</span></td>
                                                    <td>
                                                        {row.inPersonStock > 0 ? (
                                                                <div class="ip-stepper">
                                                                    <button type="button" class="ip-step-btn ip-step-dec" aria-label="Undo a sale">−</button>
                                                                    <button type="button" class="ip-step-btn ip-step-inc" aria-label="Record a sale">+ Sold</button>
                                                                </div>
                                                        ) : (<span class="admin-no-image">—</span>)}
                                                    </td>
                                                </tr>))}
                                        </tbody>
                                    </table>
                                </div>
                                <p class="admin-field-hint admin-stock-foot">Stock levels and previews are edited from the Drops tab via “Edit items”. Use the in-person steppers to log sales you make by hand.</p>
                            </>
                        )}
                    </section>
                </>
        )}
    </div>
</main>

<script>
    import { showToast } from '../../lib/toast';

    // ── In-person sales steppers ───────────────────────────────
    const ipTable = document.getElementById('ip-stock-table') as HTMLTableElement | null;
    if (ipTable) {
        const dropId = ipTable.dataset.dropId ?? '';
        const ipTotalSold = document.getElementById('ip-total-sold');
        const ipTotalRemaining = document.getElementById('ip-total-remaining');

        const recomputeTotals = () => {
            let sold = 0;
            let remaining = 0;
            ipTable.querySelectorAll<HTMLElement>('.ip-row').forEach(r => {
                const s = Number(r.dataset.sold ?? '0');
                const stock = Number(r.dataset.stock ?? '0');
                sold += s;
                remaining += Math.max(0, stock - s);
            });
            if (ipTotalSold) ipTotalSold.textContent = String(sold);
            if (ipTotalRemaining) ipTotalRemaining.textContent = String(remaining);
        };

        const adjust = async (row: HTMLElement, delta: number) => {
            const stock = Number(row.dataset.stock ?? '0');
            const current = Number(row.dataset.sold ?? '0');
            const next = Math.max(0, Math.min(current + delta, stock));
            if (next === current) return;

            const buttons = row.querySelectorAll<HTMLButtonElement>('.ip-step-btn');
            buttons.forEach(b => { b.disabled = true; });
            try {
                const res = await fetch(`/api/v1/drops/${dropId}/in-person`, {
                    method: 'PATCH',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({menuItemId: row.dataset.menuItemId, inPersonConsumed: next}),
                });
                if (!res.ok) throw new Error('request failed');
                const data = await res.json();
                const sold = Number(data.inPersonConsumed ?? next);
                row.dataset.sold = String(sold);
                const soldEl = row.querySelector('.ip-sold-val');
                const remEl = row.querySelector('.ip-remaining-val');
                if (soldEl) soldEl.textContent = String(sold);
                if (remEl) remEl.textContent = String(Math.max(0, stock - sold));
                recomputeTotals();
            } catch {
                showToast('Could not update in-person sales. Please try again.', 'error');
            } finally {
                buttons.forEach(b => { b.disabled = false; });
            }
        };

        ipTable.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const row = target.closest<HTMLElement>('.ip-row');
            if (!row) return;
            if (target.closest('.ip-step-inc')) adjust(row, 1);
            else if (target.closest('.ip-step-dec')) adjust(row, -1);
        });
    }
</script>

<style>
    /* ── Admin layout (mirrors admin.astro) ───────────────────── */
    .admin-body {
        min-height: 100vh;
        background: #F3EDE5;
        display: flex;
    }
    .admin-sidebar {
        width: 220px;
        flex-shrink: 0;
        background: var(--bg);
        border-right: 1px solid var(--accent);
        display: flex;
        flex-direction: column;
        padding: 2rem 1.5rem;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        overflow-y: auto;
    }
    .admin-sidebar-top { margin-bottom: 2.5rem; }
    .admin-logo {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-primary);
        text-decoration: none;
        display: block;
    }
    .admin-badge {
        display: inline-block;
        margin-top: 0.35rem;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        background: var(--text-primary);
        color: var(--bg);
        padding: 0.18rem 0.55rem;
    }
    .admin-nav { display: flex; flex-direction: column; gap: 0.25rem; flex: 1; }
    .admin-nav-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.6rem 0.75rem;
        border-radius: 2px;
        transition: background 0.15s, color 0.15s;
    }
    .admin-nav-link:hover,
    .admin-nav-active {
        background: #EDE8E1;
        color: var(--text-primary);
    }
    .admin-sidebar-footer {
        border-top: 1px solid var(--accent);
        padding-top: 1.25rem;
        margin-top: auto;
    }
    .admin-user-email {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
        word-break: break-all;
    }
    .admin-logout-btn {
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-muted);
        cursor: pointer;
        background: none;
        border: 1px solid var(--accent);
        padding: 0.45rem 0.9rem;
        transition: border-color 0.15s, color 0.15s;
        width: 100%;
    }
    .admin-logout-btn:hover { border-color: var(--text-primary); color: var(--text-primary); }

    .admin-main {
        margin-left: 220px;
        flex: 1;
        padding: 2.5rem 2rem;
        min-width: 0;
    }
    .admin-topbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .admin-page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
    }
    .admin-page-sub {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin: 0.25rem 0 0;
    }

    /* ── Stats ─────────────────────────────────────────────────── */
    .admin-stats {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }
    .admin-stat-card {
        background: var(--bg);
        border: 1px solid var(--accent);
        padding: 1.25rem 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 120px;
    }
    .admin-stat-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-muted);
    }
    .admin-stat-value {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 500;
        color: var(--text-primary);
        line-height: 1;
    }

    /* ── Table ─────────────────────────────────────────────────── */
    .admin-table-wrap {
        background: var(--bg);
        border: 1px solid var(--accent);
        overflow-x: auto;
    }
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    .admin-table thead { border-bottom: 1px solid var(--accent); }
    .admin-table th {
        text-align: left;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 0.9rem 1.25rem;
        white-space: nowrap;
    }
    .admin-table td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--accent);
        color: var(--text-primary);
    }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-table tr:hover td { background: #FAF7F2; }
    .admin-td-name { font-weight: 500; white-space: nowrap; }
    .admin-no-image { color: var(--text-muted); }

    .admin-empty {
        padding: 3rem;
        text-align: center;
        font-size: 0.9rem;
        color: var(--text-muted);
    }
    .admin-field-hint {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    /* ── Stock dashboard ───────────────────────────────────────── */
    .admin-stock-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }
    .admin-stock-drop-name {
        display: block;
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .admin-stock-drop-sub {
        display: block;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
    }
    .admin-stock-progress-col {
        width: 30%;
        min-width: 160px;
    }
    .admin-stock-bar {
        display: inline-block;
        width: calc(100% - 3rem);
        height: 0.55rem;
        background: var(--accent);
        border-radius: 999px;
        overflow: hidden;
        vertical-align: middle;
    }
    .admin-stock-bar-fill {
        height: 100%;
        border-radius: 999px;
        transition: width 0.2s ease;
    }
    .admin-stock-fill-ok { background: #2F6A2F; }
    .admin-stock-fill-low { background: #C0792B; }
    .admin-stock-fill-soldout { background: #9A3A1A; }
    .admin-stock-pct {
        display: inline-block;
        width: 2.5rem;
        text-align: right;
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
        color: var(--text-muted);
        vertical-align: middle;
    }
    .admin-stock-pill {
        display: inline-block;
        font-size: 0.63rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--accent);
        white-space: nowrap;
    }
    .admin-stock-pill-ok { background: #EEF6EE; border-color: #9CC79C; color: #2F6A2F; }
    .admin-stock-pill-low { background: #FFF8F0; border-color: #E8C49A; color: #7A4A1A; }
    .admin-stock-pill-soldout { background: #FDF0EE; border-color: #D9836A; color: #9A3A1A; }
    .admin-stock-foot { margin-top: 1rem; }
    .admin-stock-section-title {
        margin: 1.75rem 0 0.85rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-strong, #2b2b2b);
    }
    .admin-stock-section-title:first-of-type { margin-top: 0.5rem; }

    .ip-stepper { display: inline-flex; align-items: center; gap: 0.4rem; }
    .ip-step-btn {
        cursor: pointer;
        border: 1px solid var(--border, #e2ddd4);
        background: #fff;
        color: var(--text-strong, #2b2b2b);
        border-radius: 8px;
        padding: 0.3rem 0.6rem;
        font-size: 0.82rem;
        font-weight: 600;
        line-height: 1;
        transition: background 0.15s ease, border-color 0.15s ease;
    }
    .ip-step-btn:hover:not(:disabled) { background: #F6F2EA; }
    .ip-step-inc { border-color: #C6A15B; color: #6B4E18; }
    .ip-step-btn:disabled { opacity: 0.5; cursor: default; }

    /* ── At a glance (split by channel) ────────────────────────── */
    .stock-glance-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    @media (max-width: 720px) {
        .stock-glance-row { grid-template-columns: 1fr; }
    }
    .stock-glance {
        background: var(--bg);
        border: 1px solid var(--accent);
        border-left: 4px solid var(--accent);
        border-radius: 12px;
        padding: 1.5rem 1.75rem;
    }
    .stock-glance-online { border-left-color: #4A6FA5; }
    .stock-glance-inperson { border-left-color: #C6A15B; }
    .stock-glance-summary {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }
    .stock-glance-body {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        min-width: 0;
    }
    .stock-glance-tag {
        align-self: flex-start;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 0.22rem 0.55rem;
        border-radius: 999px;
        color: #fff;
    }
    .stock-glance-tag-online { background: #4A6FA5; }
    .stock-glance-tag-inperson { background: #C6A15B; }
    .stock-glance-none {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin: 0.25rem 0 0;
    }
    .stock-progress-ring {
        --pct: 0;
        --ring: #2F6A2F;
        position: relative;
        width: 92px;
        height: 92px;
        border-radius: 50%;
        flex-shrink: 0;
        background: conic-gradient(var(--ring) calc(var(--pct) * 1%), var(--accent) 0);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .stock-progress-ring::after {
        content: '';
        position: absolute;
        inset: 10px;
        background: var(--bg);
        border-radius: 50%;
    }
    .stock-progress-num {
        position: relative;
        z-index: 1;
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1;
        color: var(--text-primary);
    }
    .stock-progress-label {
        position: relative;
        z-index: 1;
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
    }
    .stock-glance-figures { display: flex; gap: 1.75rem; flex-wrap: wrap; }
    .stock-figure { display: flex; flex-direction: column; gap: 0.15rem; }
    .stock-figure-num {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.85rem;
        font-weight: 600;
        line-height: 1;
        color: var(--text-primary);
    }
    .stock-figure-label {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
    }
    .stock-flags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
    }
    .stock-flag {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        border: 1px solid var(--accent);
        white-space: nowrap;
    }
    .stock-flag-soldout { background: #FDF0EE; border-color: #D9836A; color: #9A3A1A; }
    .stock-flag-low { background: #FFF8F0; border-color: #E8C49A; color: #7A4A1A; }
    .stock-flag-ok { background: #EEF6EE; border-color: #9CC79C; color: #2F6A2F; }
    .stock-flag-names {
        flex-basis: 100%;
        text-align: right;
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    /* ── Glance cards ──────────────────────────────────────────── */
    .stock-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 0.85rem;
        margin-bottom: 0.5rem;
    }
    .stock-card {
        background: var(--bg);
        border: 1px solid var(--accent);
        border-left: 3px solid var(--accent);
        border-radius: 10px;
        padding: 0.9rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .stock-card-ok { border-left-color: #2F6A2F; }
    .stock-card-low { border-left-color: #C0792B; }
    .stock-card-soldout { border-left-color: #9A3A1A; }
    .stock-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .stock-card-name { font-weight: 600; font-size: 0.92rem; line-height: 1.2; }
    .stock-card-figure { display: flex; align-items: baseline; gap: 0.4rem; }
    .stock-card-remaining {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 600;
        line-height: 1;
        color: var(--text-primary);
    }
    .stock-card-remaining-label { font-size: 0.75rem; color: var(--text-muted); }
    .stock-card .admin-stock-bar { width: 100%; }
    .stock-card-ip {
        font-size: 0.72rem;
        color: var(--text-muted);
        padding-top: 0.1rem;
        border-top: 1px solid #efe9e0;
    }
    /* ── Channel sections (online / in-person) ─────────────────── */
    .stock-section {
        border: 1px solid var(--accent);
        border-radius: 12px;
        padding: 1.25rem 1.5rem 1.5rem;
        margin-bottom: 1.5rem;
        border-left: 4px solid var(--accent);
    }
    .stock-section-online { border-left-color: #4A6FA5; }
    .stock-section-inperson { border-left-color: #C6A15B; }
    .stock-section-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }
    .stock-section-tag {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 0.28rem 0.6rem;
        border-radius: 999px;
        color: #fff;
    }
    .stock-section-online .stock-section-tag { background: #4A6FA5; }
    .stock-section-inperson .stock-section-tag { background: #C6A15B; }
    .stock-section-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.3rem;
        font-weight: 600;
        margin: 0;
        line-height: 1.1;
    }
    .stock-section-sub {
        font-size: 0.72rem;
        color: var(--text-muted);
    }
    .stock-section-mini {
        margin-left: auto;
        display: flex;
        gap: 1.25rem;
        font-size: 0.8rem;
        color: var(--text-muted);
    }
    .stock-section-mini strong {
        font-size: 1.05rem;
        color: var(--text-primary);
        font-variant-numeric: tabular-nums;
    }
    .stock-cards { margin-bottom: 1rem; }

    /* ── Responsive ────────────────────────────────────────────── */
    @media (max-width: 768px) {
        .admin-body { flex-direction: column; }

        /* Sidebar collapses into a horizontal top bar instead of vanishing,
           so admins keep navigation on mobile. */
        .admin-sidebar {
            position: static;
            width: 100%;
            height: auto;
            flex-flow: row wrap;
            align-items: center;
            gap: 0.5rem 1rem;
            padding: 0.85rem 1rem;
            border-right: none;
            border-bottom: 1px solid var(--accent);
        }
        .admin-sidebar-top {
            margin-bottom: 0;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .admin-badge { margin-top: 0; }
        .admin-nav {
            order: 2;
            flex-basis: 100%;
            flex-direction: row;
            gap: 0.25rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .admin-nav-link { white-space: nowrap; padding: 0.5rem 0.7rem; }
        .admin-sidebar-footer {
            margin: 0 0 0 auto;
            padding-top: 0;
            border-top: none;
        }
        .admin-user-email { display: none; }
        .admin-logout-btn { width: auto; white-space: nowrap; }

        .admin-main { margin-left: 0; padding: 1.5rem 1rem; }
        .stock-flags { margin-left: 0; }
    }
</style>
</body>
</html>
